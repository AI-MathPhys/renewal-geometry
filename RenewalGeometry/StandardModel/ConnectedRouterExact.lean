import Mathlib
import RenewalGeometry.StandardModel.WeakResetGenerationExact

/-!
# The connected-router full-matrix theorem

`thm:connected-router` of the spacetime–gauge duality paper.  Let
`𝒟_n = span{p_1, …, p_n}` be the diagonal algebra of the rank-one projections
`p_i = E_ii` on `ℂⁿ` and let `u` be a matrix.  The **support graph** of `u` has an
edge `i — j` whenever `p_i u p_j ≠ 0` or `p_j u p_i ≠ 0`, i.e. `u i j ≠ 0 ∨ u j i ≠ 0`.
Then the `*`-algebra generated by `𝒟_n` and `u` (encoded as the unital subalgebra
generated by the `p_i`, `u` and `uᴴ`) is all of `M_n(ℂ)` **iff** the support graph
is connected (`adjoin_eq_top_iff_connected`).  When the graph is disconnected every
connected component gives a reducing block projection commuting with the generated
algebra (`blockProj_commute_of_mem_adjoin`), and the generated algebra sits inside a
proper block-diagonal subalgebra (`adjoin_le_blockAlgebra`, `blockAlgebra_ne_top`).

* `single_mem_of_reachable`: products of (rescaled) corner units along a graph walk
  give every matrix unit between vertices of one component;
* `adjoin_eq_top_of_connected` / `connected_of_adjoin_eq_top`: the two directions;
* `adjoin_eq_top_iff_connected`: the boxed equivalence `eq:router-full-matrix`.

The index type `n` is an arbitrary finite type with decidable equality; the
`⇐`-direction requires `n` nonempty because Mathlib's `SimpleGraph.Connected`
includes nonemptiness of the vertex set.
-/

open Finset Matrix

namespace RenewalGeometry
namespace ConnectedRouter

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The diagonal rank-one projection `p_i = E_ii`. -/
def diagProj (i : n) : Matrix n n ℂ := Matrix.single i i 1

/-- The generating set `𝒟_n ∪ {u, u*}` of `C*(𝒟_n, u)`. -/
def routerGens (u : Matrix n n ℂ) : Set (Matrix n n ℂ) :=
  Set.range diagProj ∪ {u, uᴴ}

/-- The undirected support graph of `u`: an edge `i — j` (for `i ≠ j`) whenever
`u i j ≠ 0` or `u j i ≠ 0`. -/
def supportGraph (u : Matrix n n ℂ) : SimpleGraph n :=
  SimpleGraph.fromRel fun i j => u i j ≠ 0

theorem supportGraph_adj (u : Matrix n n ℂ) (i j : n) :
    (supportGraph u).Adj i j ↔ i ≠ j ∧ (u i j ≠ 0 ∨ u j i ≠ 0) :=
  SimpleGraph.fromRel_adj _ i j

/-- The corner compression `p_i u p_j = u_{ij} E_{ij}`. -/
theorem diagProj_mul_mul_diagProj (u : Matrix n n ℂ) (i j : n) :
    diagProj i * u * diagProj j = u i j • Matrix.single i j 1 := by
  rw [diagProj, diagProj, Matrix.single_mul_mul_single, Matrix.smul_single, smul_eq_mul,
    one_mul, mul_one]

/-- The paper's edge condition `p_i u p_j ≠ 0` is exactly `u i j ≠ 0`. -/
theorem diagProj_mul_mul_diagProj_ne_zero_iff (u : Matrix n n ℂ) (i j : n) :
    diagProj i * u * diagProj j ≠ 0 ↔ u i j ≠ 0 := by
  rw [diagProj_mul_mul_diagProj]
  constructor
  · intro h hz
    apply h
    rw [hz, zero_smul]
  · intro h hz
    apply h
    have := congrFun (congrFun hz i) j
    rw [Matrix.smul_apply, Matrix.single_apply_same, smul_eq_mul, mul_one,
      Matrix.zero_apply] at this
    exact this

theorem diagProj_mem {u : Matrix n n ℂ} {A : Subalgebra ℂ (Matrix n n ℂ)}
    (hA : routerGens u ⊆ A) (i : n) : diagProj i ∈ A :=
  hA (Set.mem_union_left _ ⟨i, rfl⟩)

theorem router_mem {u : Matrix n n ℂ} {A : Subalgebra ℂ (Matrix n n ℂ)}
    (hA : routerGens u ⊆ A) : u ∈ A :=
  hA (Set.mem_union_right _ (Set.mem_insert _ _))

theorem router_star_mem {u : Matrix n n ℂ} {A : Subalgebra ℂ (Matrix n n ℂ)}
    (hA : routerGens u ⊆ A) : uᴴ ∈ A :=
  hA (Set.mem_union_right _ (Set.mem_insert_of_mem _ rfl))

/-- A support edge produces the matrix unit `E_{ij}` in any subalgebra containing
the generators (rescaling `p_i u p_j`, or the adjoint `p_i u* p_j`). -/
theorem single_mem_of_adj {u : Matrix n n ℂ} {A : Subalgebra ℂ (Matrix n n ℂ)}
    (hA : routerGens u ⊆ A) {i j : n} (h : (supportGraph u).Adj i j) :
    Matrix.single i j (1 : ℂ) ∈ A := by
  rcases (supportGraph_adj u i j).mp h with ⟨_, hij | hji⟩
  · have h1 : diagProj i * u * diagProj j ∈ A :=
      mul_mem (mul_mem (diagProj_mem hA i) (router_mem hA)) (diagProj_mem hA j)
    rw [diagProj_mul_mul_diagProj] at h1
    have h2 := A.smul_mem h1 (u i j)⁻¹
    rwa [smul_smul, inv_mul_cancel₀ hij, one_smul] at h2
  · have h1 : diagProj i * uᴴ * diagProj j ∈ A :=
      mul_mem (mul_mem (diagProj_mem hA i) (router_star_mem hA)) (diagProj_mem hA j)
    rw [diagProj_mul_mul_diagProj, Matrix.conjTranspose_apply] at h1
    have hs : star (u j i) ≠ 0 := star_ne_zero.mpr hji
    have h2 := A.smul_mem h1 (star (u j i))⁻¹
    rwa [smul_smul, inv_mul_cancel₀ hs, one_smul] at h2

/-- Products along a walk of the support graph generate the matrix unit between
its endpoints. -/
theorem single_mem_of_reachable {u : Matrix n n ℂ} {A : Subalgebra ℂ (Matrix n n ℂ)}
    (hA : routerGens u ⊆ A) {i j : n} (h : (supportGraph u).Reachable i j) :
    Matrix.single i j (1 : ℂ) ∈ A := by
  rw [SimpleGraph.reachable_iff_reflTransGen] at h
  induction h with
  | refl => exact diagProj_mem hA i
  | tail _ hadj ih =>
    rename_i b c
    have h1 := mul_mem ih (single_mem_of_adj hA hadj)
    rwa [Matrix.single_mul_single_same, one_mul] at h1

/-- **Connected ⇒ full matrix algebra**: if the support graph of `u` is connected
(indeed, preconnected suffices), `C*(𝒟_n, u) = M_n(ℂ)`. -/
theorem adjoin_eq_top_of_preconnected (u : Matrix n n ℂ)
    (h : (supportGraph u).Preconnected) :
    Algebra.adjoin ℂ (routerGens u) = ⊤ :=
  WeakReset.top_of_units fun i j =>
    single_mem_of_reachable (Algebra.subset_adjoin) (h i j)

theorem adjoin_eq_top_of_connected (u : Matrix n n ℂ)
    (h : (supportGraph u).Connected) :
    Algebra.adjoin ℂ (routerGens u) = ⊤ :=
  adjoin_eq_top_of_preconnected u h.preconnected

/-! ### Block-diagonal subalgebras and reducing projections -/

/-- The block-diagonal subalgebra cut out by a vertex set `S`: matrices with no
entry between `S` and its complement. -/
def blockAlgebra (S : Set n) : Subalgebra ℂ (Matrix n n ℂ) where
  carrier := {X | ∀ a b : n, ¬ (a ∈ S ↔ b ∈ S) → X a b = 0}
  zero_mem' := fun _ _ _ => rfl
  one_mem' := fun a b hab => by
    rw [Matrix.one_apply_ne]
    rintro rfl
    exact hab Iff.rfl
  add_mem' := fun {X Y} hX hY a b hab => by
    rw [Matrix.add_apply, hX a b hab, hY a b hab, add_zero]
  mul_mem' := fun {X Y} hX hY a b hab => by
    rw [Matrix.mul_apply]
    refine Finset.sum_eq_zero fun m _ => ?_
    by_cases ham : a ∈ S ↔ m ∈ S
    · have hmb : ¬ (m ∈ S ↔ b ∈ S) := fun hmb => hab (ham.trans hmb)
      rw [hY m b hmb, mul_zero]
    · rw [hX a m ham, zero_mul]
  algebraMap_mem' := fun c a b hab => by
    rw [Matrix.algebraMap_matrix_apply, if_neg]
    rintro rfl
    exact hab Iff.rfl

theorem mem_blockAlgebra {S : Set n} {X : Matrix n n ℂ} :
    X ∈ blockAlgebra S ↔ ∀ a b : n, ¬ (a ∈ S ↔ b ∈ S) → X a b = 0 :=
  Iff.rfl

/-- The block projection `P_S = ∑_{k ∈ S} p_k`. -/
noncomputable def blockProj (S : Set n) : Matrix n n ℂ :=
  Matrix.diagonal fun k => by classical exact if k ∈ S then 1 else 0

/-- Every element of the block algebra commutes with the block projection: `S` is a
reducing subspace. -/
theorem blockProj_commute {S : Set n} {X : Matrix n n ℂ} (hX : X ∈ blockAlgebra S) :
    blockProj S * X = X * blockProj S := by
  classical
  ext a b
  rw [blockProj, Matrix.diagonal_mul, Matrix.mul_diagonal]
  by_cases hab : a ∈ S ↔ b ∈ S
  · by_cases ha : a ∈ S
    · rw [if_pos ha, if_pos (hab.mp ha), one_mul, mul_one]
    · rw [if_neg ha, if_neg (fun hb => ha (hab.mpr hb)), zero_mul, mul_zero]
  · rw [hX a b hab, mul_zero, zero_mul]

/-- A vertex set closed under adjacency of the support graph. -/
def AdjClosed (u : Matrix n n ℂ) (S : Set n) : Prop :=
  ∀ a b : n, (supportGraph u).Adj a b → (a ∈ S ↔ b ∈ S)

/-- The generators lie in the block algebra of any adjacency-closed vertex set. -/
theorem routerGens_subset_blockAlgebra {u : Matrix n n ℂ} {S : Set n}
    (hS : AdjClosed u S) : routerGens u ⊆ blockAlgebra S := by
  intro X hX
  rcases hX with ⟨i, rfl⟩ | hX
  · intro a b hab
    rw [diagProj, Matrix.single_apply_of_ne]
    rintro ⟨rfl, rfl⟩
    exact hab Iff.rfl
  · have key : ∀ a b : n, ¬ (a ∈ S ↔ b ∈ S) → u a b = 0 ∧ u b a = 0 := by
      intro a b hab
      have hne : a ≠ b := by
        rintro rfl
        exact hab Iff.rfl
      by_contra hc
      apply hab
      apply hS a b
      rw [supportGraph_adj]
      refine ⟨hne, ?_⟩
      by_contra hd
      exact hc ⟨by_contra fun h1 => hd (Or.inl h1), by_contra fun h2 => hd (Or.inr h2)⟩
    rcases hX with rfl | rfl
    · exact fun a b hab => (key a b hab).1
    · intro a b hab
      rw [Matrix.conjTranspose_apply, (key a b hab).2, star_zero]

/-- The generated algebra sits inside the block algebra of every adjacency-closed
vertex set. -/
theorem adjoin_le_blockAlgebra {u : Matrix n n ℂ} {S : Set n} (hS : AdjClosed u S) :
    Algebra.adjoin ℂ (routerGens u) ≤ blockAlgebra S :=
  Algebra.adjoin_le (routerGens_subset_blockAlgebra hS)

/-- The block projection of an adjacency-closed set commutes with the whole
generated algebra (reducing subspace). -/
theorem blockProj_commute_of_mem_adjoin {u : Matrix n n ℂ} {S : Set n}
    (hS : AdjClosed u S) {X : Matrix n n ℂ} (hX : X ∈ Algebra.adjoin ℂ (routerGens u)) :
    blockProj S * X = X * blockProj S :=
  blockProj_commute (adjoin_le_blockAlgebra hS hX)

/-- The support of every connected component of the support graph is
adjacency-closed. -/
theorem adjClosed_component (u : Matrix n n ℂ) (C : (supportGraph u).ConnectedComponent) :
    AdjClosed u C.supp :=
  fun _ _ hadj => SimpleGraph.ConnectedComponent.mem_supp_congr_adj C hadj

/-- The block algebra of a nonempty proper vertex set is a proper subalgebra: the
matrix unit `E_{ij}` with `i ∈ S`, `j ∉ S` is missing. -/
theorem blockAlgebra_ne_top {S : Set n} {i j : n} (hi : i ∈ S) (hj : j ∉ S) :
    blockAlgebra S ≠ ⊤ := by
  intro htop
  have hmem : Matrix.single i j (1 : ℂ) ∈ blockAlgebra S := by
    rw [htop]
    exact Algebra.mem_top
  have h := hmem i j (fun h => hj (h.mp hi))
  rw [Matrix.single_apply_same] at h
  exact one_ne_zero h

/-- **Full matrix algebra ⇒ connected**: if `C*(𝒟_n, u) = M_n(ℂ)` then the support
graph is connected (the vertex set is assumed nonempty, as `Connected` requires). -/
theorem connected_of_adjoin_eq_top [Nonempty n] (u : Matrix n n ℂ)
    (h : Algebra.adjoin ℂ (routerGens u) = ⊤) :
    (supportGraph u).Connected := by
  refine ⟨fun i j => ?_⟩
  by_contra hij
  -- the component of `i` is a nonempty proper adjacency-closed set
  set C := (supportGraph u).connectedComponentMk i with hC
  have hi : i ∈ C.supp := SimpleGraph.ConnectedComponent.connectedComponentMk_mem
  have hj : j ∉ C.supp := by
    intro hj
    rw [SimpleGraph.ConnectedComponent.mem_supp_iff, hC,
      SimpleGraph.ConnectedComponent.eq] at hj
    exact hij hj.symm
  have hle := adjoin_le_blockAlgebra (adjClosed_component u C)
  rw [h, top_le_iff] at hle
  exact blockAlgebra_ne_top hi hj hle

/-- **The connected-router full-matrix theorem** (`thm:connected-router`,
`eq:router-full-matrix`): `C*(𝒟_n, u) = M_n(ℂ)` iff the support graph of `u` is
connected. -/
theorem adjoin_eq_top_iff_connected [Nonempty n] (u : Matrix n n ℂ) :
    Algebra.adjoin ℂ (routerGens u) = ⊤ ↔ (supportGraph u).Connected :=
  ⟨connected_of_adjoin_eq_top u, adjoin_eq_top_of_connected u⟩

/-- **Disconnected ⇒ proper block-diagonal subalgebra**: when the support graph is
disconnected, the component of any vertex `i` gives a nonempty, proper,
adjacency-closed block whose projection reduces the generated algebra, and the
generated algebra is contained in the proper block algebra. -/
theorem disconnected_block_reduction [Nonempty n] (u : Matrix n n ℂ)
    (h : ¬ (supportGraph u).Connected) :
    ∃ S : Set n, S.Nonempty ∧ S ≠ Set.univ ∧ AdjClosed u S ∧
      Algebra.adjoin ℂ (routerGens u) ≤ blockAlgebra S ∧ blockAlgebra S ≠ ⊤ ∧
      ∀ X ∈ Algebra.adjoin ℂ (routerGens u), blockProj S * X = X * blockProj S := by
  have hpre : ¬ (supportGraph u).Preconnected := fun hp => h ⟨hp⟩
  simp only [SimpleGraph.Preconnected, not_forall] at hpre
  obtain ⟨i, j, hij⟩ := hpre
  set C := (supportGraph u).connectedComponentMk i with hC
  have hi : i ∈ C.supp := SimpleGraph.ConnectedComponent.connectedComponentMk_mem
  have hj : j ∉ C.supp := by
    intro hj
    rw [SimpleGraph.ConnectedComponent.mem_supp_iff, hC,
      SimpleGraph.ConnectedComponent.eq] at hj
    exact hij hj.symm
  have hclosed := adjClosed_component u C
  refine ⟨C.supp, ⟨i, hi⟩, ?_, hclosed, adjoin_le_blockAlgebra hclosed,
    blockAlgebra_ne_top hi hj, fun X hX => blockProj_commute_of_mem_adjoin hclosed hX⟩
  intro huniv
  exact hj (huniv ▸ Set.mem_univ j)

end ConnectedRouter
end RenewalGeometry
