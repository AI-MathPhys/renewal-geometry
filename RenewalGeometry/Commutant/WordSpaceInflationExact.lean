import RenewalGeometry.StandardModel.ActiveResidualCensusExact
import RenewalGeometry.Commutant.DegreeOneCommutantWedderburnExact
import RenewalGeometry.Commutant.WordSpaceMultiplicityFirewall

/-!
# Invariant word-space inflation without an internal `M₃`

`prop:word-space-inflation` of the spacetime–gauge duality paper, on the benchmark
`Ω = {(i,j) : i ≠ j} ⊆ {1,…,4}²`, `ℋ = ℂ^Ω` (the ordered-root carrier `E` of
`ActiveResidualAlgebra`) with the simultaneous relabeling action `u_g|i,j⟩ = |g i, g j⟩`
of `S₄` (`Pm σ`), the diagonal point projections `p_e = E_ee` (`ConnectedRouter.diagProj`)
and the two fibre averages `(Tf)(i,j) = ⅓ ∑_{k≠i} f(i,k)` (`Tm`) and
`(Hf)(i,j) = ⅓ ∑_{k≠j} f(k,j)` (`Hm`).

* `router_preconnected`, `adjoin_gens_eq_top`: the support graph of the router `T + H` is
  connected (two vertices sharing a tail or a head are adjacent), so by
  `thm:connected-router` the system algebra generated by the point projections and
  `T, H` is **`𝒜 = M₁₂(ℂ)`**;
* `invariant_algebra_eq`, `DegreeOneWedderburn.degreeOneCommutantEquiv`: the invariant
  algebra `𝒜^{S₄}` is the commutant of the relabeling matrices, isomorphic to
  **`ℂ ⊕ M₂(ℂ) ⊕ ℂ ⊕ ℂ`** (`eq:degree-one-commutant`);
* `permChar`, `trace_Pm_eq_permChar`, `physical_multiplicities`: the permutation character
  `χ_ℋ(σ) = Tr P_σ` and its inner products with the five irreducible characters of `S₄`
  (`1, sgn, W, W ⊗ sgn, V₂`, the standard formulas `χ_W = fix − 1`,
  `χ_{V₂} = fixMatch − 1`, `χ_{W⊗sgn} = sgn · (fix − 1)` of `ActiveResidualCensus`):
  `(1/24) ∑_σ χ_λ(σ) χ_ℋ(σ) = (1, 0, 2, 1, 1)`;
* `trace_conjRep`, `conjugation_multiplicities`: the conjugation representation
  `X ↦ P_σ X P_σ⁻¹` on `L²(M₁₂) = M_E(ℂ)` has character `|χ_ℋ|²`
  (`Tr(X ↦ A X B) = Tr A · Tr B`, `trace_mulLeft_comp_mulRight`), whose inner products are
  `(7, 5, 19, 17, 12)`;
* `word_space_inflation`: **the proposition**, bundling the above with the `M₇(ℂ)` block
  of the conjugation commutant (`WordSpaceFirewall.m7Block`) and the absence of an
  `M₃(ℂ)` corner in `𝒜^{S₄}` (`EdgeCommutant.no_M3_embedding`).

All character sums are kernel-checked by `decide` over `ℤ`.
-/

open Matrix RenewalGeometry.ActiveResidual RenewalGeometry.ActiveResidualCensus
  RenewalGeometry.EdgeCommutant RenewalGeometry.DegreeOneColourNoGo
  RenewalGeometry.WordSpaceFirewall

namespace RenewalGeometry
namespace WordSpaceInflation

/-! ### The trace of a two-sided multiplication -/

theorem stdBasis_repr_apply {n : Type*} [Fintype n] (M : Matrix n n ℂ) (p : n × n) :
    (Matrix.stdBasis ℂ n n).repr M p = M p.1 p.2 := by
  simp [Matrix.stdBasis, Pi.basis_repr]

theorem mul_single_mul_apply_same {n : Type*} [Fintype n] [DecidableEq n] (A B : Matrix n n ℂ)
    (i j : n) : (A * Matrix.single i j (1 : ℂ) * B) i j = A i i * B j j := by
  simp [Matrix.mul_apply, Matrix.single_apply, ite_and]

/-- `Tr(X ↦ A X B) = Tr A · Tr B` on `M_n(ℂ)`. -/
theorem trace_mulLeft_comp_mulRight {n : Type*} [Fintype n] [DecidableEq n]
    (A B : Matrix n n ℂ) :
    LinearMap.trace ℂ (Matrix n n ℂ) (LinearMap.mulLeft ℂ A ∘ₗ LinearMap.mulRight ℂ B) =
      A.trace * B.trace := by
  rw [LinearMap.trace_eq_matrix_trace ℂ (Matrix.stdBasis ℂ n n)]
  simp only [Matrix.trace, Matrix.diag, LinearMap.toMatrix_apply, LinearMap.comp_apply,
    LinearMap.mulLeft_apply, LinearMap.mulRight_apply, stdBasis_repr_apply]
  rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  have h := Matrix.stdBasis_eq_single (R := ℂ) (m := n) (n := n) i j
  rw [h, ← Matrix.mul_assoc]
  exact mul_single_mul_apply_same A B i j

/-! ### The fibre averages and the router -/

/-- The tail fibre average `(Tf)(i,j) = ⅓ ∑_{k ≠ i} f(i,k)`. -/
noncomputable def Tm : Matrix E E ℂ := fun e f => if e.1.1 = f.1.1 then (3 : ℂ)⁻¹ else 0

/-- The head fibre average `(Hf)(i,j) = ⅓ ∑_{k ≠ j} f(k,j)`. -/
noncomputable def Hm : Matrix E E ℂ := fun e f => if e.1.2 = f.1.2 then (3 : ℂ)⁻¹ else 0

theorem Tm_mulVec (f : E → ℂ) (e : E) :
    (Tm *ᵥ f) e = (3 : ℂ)⁻¹ * ∑ f' : E with e.1.1 = f'.1.1, f f' := by
  simp [Tm, Matrix.mulVec, dotProduct, Finset.mul_sum, Finset.sum_filter]

theorem Hm_mulVec (f : E → ℂ) (e : E) :
    (Hm *ᵥ f) e = (3 : ℂ)⁻¹ * ∑ f' : E with e.1.2 = f'.1.2, f f' := by
  simp [Hm, Matrix.mulVec, dotProduct, Finset.mul_sum, Finset.sum_filter]

theorem Tm_conjTranspose : Tmᴴ = Tm := by
  ext e f
  simp only [Matrix.conjTranspose_apply, Tm]
  by_cases h : e.1.1 = f.1.1
  · rw [if_pos h.symm, if_pos h]; simp
  · rw [if_neg (Ne.symm h), if_neg h]; simp

theorem Hm_conjTranspose : Hmᴴ = Hm := by
  ext e f
  simp only [Matrix.conjTranspose_apply, Hm]
  by_cases h : e.1.2 = f.1.2
  · rw [if_pos h.symm, if_pos h]; simp
  · rw [if_neg (Ne.symm h), if_neg h]; simp

/-- The single router `u = T + H` of `thm:connected-router`. -/
noncomputable def router : Matrix E E ℂ := Tm + Hm

theorem router_conjTranspose : routerᴴ = router := by
  rw [router, Matrix.conjTranspose_add, Tm_conjTranspose, Hm_conjTranspose]

theorem router_ne_zero_iff (e f : E) :
    router e f ≠ 0 ↔ e.1.1 = f.1.1 ∨ e.1.2 = f.1.2 := by
  simp only [router, Matrix.add_apply, Tm, Hm]
  split_ifs with h1 h2 h2 <;> simp [h1, h2]

/-- The support graph of the router: `e ~ f` iff `e ≠ f` and they share a tail or a head. -/
theorem supportGraph_router_adj (e f : E) :
    (ConnectedRouter.supportGraph router).Adj e f ↔
      e ≠ f ∧ (e.1.1 = f.1.1 ∨ e.1.2 = f.1.2) := by
  rw [ConnectedRouter.supportGraph_adj, router_ne_zero_iff, router_ne_zero_iff]
  constructor
  · rintro ⟨hne, h | h⟩
    · exact ⟨hne, h⟩
    · exact ⟨hne, h.imp Eq.symm Eq.symm⟩
  · rintro ⟨hne, h⟩
    exact ⟨hne, Or.inl h⟩

theorem reachable_of_tail {e f : E} (h : e.1.1 = f.1.1) :
    (ConnectedRouter.supportGraph router).Reachable e f := by
  by_cases hef : e = f
  · subst hef; rfl
  · exact SimpleGraph.Adj.reachable ((supportGraph_router_adj e f).mpr ⟨hef, Or.inl h⟩)

theorem reachable_of_head {e f : E} (h : e.1.2 = f.1.2) :
    (ConnectedRouter.supportGraph router).Reachable e f := by
  by_cases hef : e = f
  · subst hef; rfl
  · exact SimpleGraph.Adj.reachable ((supportGraph_router_adj e f).mpr ⟨hef, Or.inr h⟩)

theorem exists_third : ∀ a b : Fin 4, ∃ k : Fin 4, k ≠ a ∧ k ≠ b := by decide

/-- **The support graph of `T + H` is connected**: any two ordered pairs are joined by a
walk of length at most three changing one coordinate at a time. -/
theorem router_preconnected : (ConnectedRouter.supportGraph router).Preconnected := by
  rintro ⟨⟨a, b⟩, hab⟩ ⟨⟨c, d⟩, hcd⟩
  simp only [ne_eq] at hab hcd
  by_cases had : a = d
  · subst had
    by_cases hcb : c = b
    · subst hcb
      obtain ⟨k, hka, hkc⟩ := exists_third a c
      -- `(a,c) → (a,k) → (c,k) → (c,a)`
      exact (reachable_of_tail (e := ⟨(a, c), hab⟩) (f := ⟨(a, k), Ne.symm hka⟩) rfl).trans
        ((reachable_of_head (e := ⟨(a, k), Ne.symm hka⟩) (f := ⟨(c, k), Ne.symm hkc⟩) rfl).trans
          (reachable_of_tail (e := ⟨(c, k), Ne.symm hkc⟩) (f := ⟨(c, a), hcd⟩) rfl))
    · -- `(a,b) → (c,b) → (c,a)`
      exact (reachable_of_head (e := ⟨(a, b), hab⟩) (f := ⟨(c, b), hcb⟩) rfl).trans
        (reachable_of_tail (e := ⟨(c, b), hcb⟩) (f := ⟨(c, a), hcd⟩) rfl)
  · -- `(a,b) → (a,d) → (c,d)`
    exact (reachable_of_tail (e := ⟨(a, b), hab⟩) (f := ⟨(a, d), had⟩) rfl).trans
      (reachable_of_head (e := ⟨(a, d), had⟩) (f := ⟨(c, d), hcd⟩) rfl)

/-- The declared generators: the point projections and the two fibre averages. -/
noncomputable def gens : Set (Matrix E E ℂ) :=
  Set.range ConnectedRouter.diagProj ∪ {Tm, Hm}

/-- **`𝒜 = M₁₂(ℂ)`**: the algebra generated by the point projections and `T, H`. -/
theorem adjoin_gens_eq_top : Algebra.adjoin ℂ gens = ⊤ := by
  refine top_le_iff.mp ?_
  rw [← ConnectedRouter.adjoin_eq_top_of_preconnected router router_preconnected]
  refine Algebra.adjoin_le ?_
  have hT : Tm ∈ Algebra.adjoin ℂ gens :=
    Algebra.subset_adjoin (Or.inr (Set.mem_insert _ _))
  have hH : Hm ∈ Algebra.adjoin ℂ gens :=
    Algebra.subset_adjoin (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  rintro x (⟨i, rfl⟩ | (rfl | rfl))
  · exact Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)
  · exact add_mem hT hH
  · rw [router_conjTranspose]; exact add_mem hT hH

/-! ### The invariant algebra -/

/-- `𝒜^{S₄}` is the commutant of the relabeling matrices inside `𝒜 = M₁₂(ℂ)`. -/
theorem invariant_algebra_eq (X : Matrix E E ℂ) :
    X ∈ degreeOneCommutant ↔
      X ∈ Algebra.adjoin ℂ gens ∧ ∀ σ : Equiv.Perm V, X * Pm σ = Pm σ * X := by
  rw [adjoin_gens_eq_top, mem_degreeOneCommutant]
  exact ⟨fun h => ⟨Algebra.mem_top, h⟩, fun h => h.2⟩

theorem mem_degreeOneCommutant_iff_mem_commutantSubmodule (X : Matrix E E ℂ) :
    X ∈ degreeOneCommutant ↔ X ∈ commutantSubmodule :=
  mem_degreeOneCommutant

/-! ### Characters -/

/-- The permutation character `χ_ℋ(σ) = Tr P_σ` in its class-function form
`1 + 2 χ_W + χ_{V₂} + χ_{W⊗sgn}` (`tracePZ`). -/
def permChar (σ : Equiv.Perm V) : ℤ := 1 + 2 * chiW σ + chiV2 σ + chiWsgn σ

theorem trace_PZ_eq_permChar (σ : Equiv.Perm V) : (PZ σ).trace = permChar σ := tracePZ σ

theorem trace_Pm_eq_permChar (σ : Equiv.Perm V) : (Pm σ).trace = (permChar σ : ℂ) := by
  rw [Pm_eq_cz, cz_trace, trace_PZ_eq_permChar]

theorem permChar_inv : ∀ σ : Equiv.Perm V, permChar σ⁻¹ = permChar σ := by decide

/-- The class values `(12, 2, 0, 0, 0)` of the permutation character on
`1, (12), (12)(34), (123), (1234)`. -/
theorem permChar_classes :
    permChar 1 = 12 ∧ permChar (Equiv.swap 0 1) = 2 ∧
      permChar (Equiv.swap 0 1 * Equiv.swap 2 3) = 0 ∧
      permChar (Equiv.swap 0 1 * Equiv.swap 1 2) = 0 ∧ permChar (finRotate 4) = 0 := by
  decide

set_option maxHeartbeats 4000000 in
/-- **Physical multiplicities `(1, 0, 2, 1, 1)`**: the character inner products
`(1/24) ∑_σ χ_λ(σ) χ_ℋ(σ)` with `λ = 1, sgn, W, W ⊗ sgn, V₂`. -/
theorem physical_multiplicities :
    (∑ σ : Equiv.Perm V, permChar σ = 24 * 1) ∧
    (∑ σ : Equiv.Perm V, (Equiv.Perm.sign σ : ℤ) * permChar σ = 24 * 0) ∧
    (∑ σ : Equiv.Perm V, chiW σ * permChar σ = 24 * 2) ∧
    (∑ σ : Equiv.Perm V, chiWsgn σ * permChar σ = 24 * 1) ∧
    (∑ σ : Equiv.Perm V, chiV2 σ * permChar σ = 24 * 1) := by decide

set_option maxHeartbeats 4000000 in
/-- **Conjugation multiplicities `(7, 5, 19, 17, 12)`**: the character inner products
`(1/24) ∑_σ χ_λ(σ) |χ_ℋ(σ)|²`. -/
theorem conjugation_multiplicities :
    (∑ σ : Equiv.Perm V, permChar σ ^ 2 = 24 * 7) ∧
    (∑ σ : Equiv.Perm V, (Equiv.Perm.sign σ : ℤ) * permChar σ ^ 2 = 24 * 5) ∧
    (∑ σ : Equiv.Perm V, chiW σ * permChar σ ^ 2 = 24 * 19) ∧
    (∑ σ : Equiv.Perm V, chiWsgn σ * permChar σ ^ 2 = 24 * 17) ∧
    (∑ σ : Equiv.Perm V, chiV2 σ * permChar σ ^ 2 = 24 * 12) := by decide

theorem conjRep_eq (σ : Equiv.Perm V) :
    conjRep σ = LinearMap.mulLeft ℂ (Pm σ) ∘ₗ LinearMap.mulRight ℂ (Pm σ⁻¹) := by
  refine LinearMap.ext fun X => ?_
  simp only [conjRep_apply, LinearMap.comp_apply, LinearMap.mulLeft_apply,
    LinearMap.mulRight_apply, Matrix.mul_assoc]

/-- **The conjugation character is `|χ_ℋ|²`**: `Tr(X ↦ P_σ X P_σ⁻¹) = (Tr P_σ)²`. -/
theorem trace_conjRep (σ : Equiv.Perm V) :
    LinearMap.trace ℂ (Matrix E E ℂ) (conjRep σ) = ((permChar σ ^ 2 : ℤ) : ℂ) := by
  rw [conjRep_eq, trace_mulLeft_comp_mulRight, trace_Pm_eq_permChar, trace_Pm_eq_permChar,
    permChar_inv]
  push_cast
  ring

/-! ### The proposition -/

/-- **`prop:word-space-inflation`.**  On the twelve-root benchmark: the algebra generated
by the point projections and the fibre averages `T, H` is `M₁₂(ℂ)`; its `S₄`-invariant
part is the commutant of the relabeling matrices, isomorphic to `ℂ ⊕ M₂(ℂ) ⊕ ℂ ⊕ ℂ`;
the physical character `Tr P_σ = χ_ℋ(σ)` has multiplicities `(1, 0, 2, 1, 1)` in the
order `(1, sgn, W, W ⊗ sgn, V₂)`; the conjugation representation on `L²(M₁₂)` has
character `|χ_ℋ|²` with multiplicities `(7, 5, 19, 17, 12)`; its commutant contains an
injective multiplicative `M₇(ℂ)` block; and `𝒜^{S₄}` admits no injective linear image of
`M₃(ℂ)`. -/
theorem word_space_inflation :
    Algebra.adjoin ℂ gens = ⊤ ∧
    (∀ X : Matrix E E ℂ, X ∈ degreeOneCommutant ↔
      X ∈ Algebra.adjoin ℂ gens ∧ ∀ σ : Equiv.Perm V, X * Pm σ = Pm σ * X) ∧
    Nonempty (DegreeOneWedderburn.Coord ≃ₐ[ℂ] degreeOneCommutant) ∧
    (∀ σ : Equiv.Perm V, (Pm σ).trace = (permChar σ : ℂ)) ∧
    ((∑ σ : Equiv.Perm V, permChar σ = 24 * 1) ∧
      (∑ σ : Equiv.Perm V, (Equiv.Perm.sign σ : ℤ) * permChar σ = 24 * 0) ∧
      (∑ σ : Equiv.Perm V, chiW σ * permChar σ = 24 * 2) ∧
      (∑ σ : Equiv.Perm V, chiWsgn σ * permChar σ = 24 * 1) ∧
      (∑ σ : Equiv.Perm V, chiV2 σ * permChar σ = 24 * 1)) ∧
    (∀ σ : Equiv.Perm V,
      LinearMap.trace ℂ (Matrix E E ℂ) (conjRep σ) = ((permChar σ ^ 2 : ℤ) : ℂ)) ∧
    ((∑ σ : Equiv.Perm V, permChar σ ^ 2 = 24 * 7) ∧
      (∑ σ : Equiv.Perm V, (Equiv.Perm.sign σ : ℤ) * permChar σ ^ 2 = 24 * 5) ∧
      (∑ σ : Equiv.Perm V, chiW σ * permChar σ ^ 2 = 24 * 19) ∧
      (∑ σ : Equiv.Perm V, chiWsgn σ * permChar σ ^ 2 = 24 * 17) ∧
      (∑ σ : Equiv.Perm V, chiV2 σ * permChar σ ^ 2 = 24 * 12)) ∧
    (∃ Φ : Matrix (Fin 7) (Fin 7) ℂ →ₗ[ℂ] Module.End ℂ (Matrix E E ℂ),
      Function.Injective Φ ∧ (∀ A B, Φ (A * B) = Φ A * Φ B) ∧
        ∀ A σ, Φ A * conjRep σ = conjRep σ * Φ A) ∧
    (∀ f : Matrix (Fin 3) (Fin 3) ℂ →ₗ[ℂ] degreeOneCommutant, ¬ Function.Injective f) :=
  ⟨adjoin_gens_eq_top, invariant_algebra_eq, ⟨DegreeOneWedderburn.degreeOneCommutantEquiv⟩,
    trace_Pm_eq_permChar, physical_multiplicities, trace_conjRep, conjugation_multiplicities,
    ⟨m7Block, m7Block_injective, m7Block_mul, m7Block_commute_conjRep⟩,
    fun f hf => no_M3_embedding (toCommutantSubmodule ∘ₗ f)
      (toCommutantSubmodule_injective.comp hf)⟩

end WordSpaceInflation
end RenewalGeometry
