import Mathlib
import MathPhys.NCG.OperatorAlgebras.Bicommutant
import MathPhys.NCG.OperatorAlgebras.MatrixStarAdjoin
open MathPhys

/-!
# Joint typed action algebra and identity-pivot reconstruction

Covers `def:action-algebra` and `thm:pullback-reconstruction` of the
spacetime–gauge duality paper.

* (in `MatrixStarAdjoin`) `starAdjoin`: the unital `*`-subalgebra of `Matrix n n ℂ` generated by a set,
  i.e. the finite-dimensional `C^*(S)`, together with its universal property.
* (in `MatrixStarAdjoin`) `jointActionAlgebra`: `C^*(A_ext, A_int, Y_e, Y_e^* : e ∈ E)` on a common finite
  carrier (`def:action-algebra`), star-closed and minimal.
* `coeffField`, `pullbackSet`, `pullbackImage`, `pullbackAlgebra`: the coefficient
  field `C(z) = ∑_ν conj(z_ν) C_ν`, the Heisenberg pullbacks `C(z)^* C(w)` of
  `|z⟩⟨w|`, their span `𝒫^*(𝓑(ℰ))`, and the `C^*`-algebra they generate.
* `pullback_reconstruction`: with an identity pivot `C(z₀) = α I`, `C(z_j) = β_j A_j`
  (`α β_j ≠ 0`), `C^*(𝒫^*(𝓑(ℰ))) = 𝒜_sys` and the commutants agree
  (`thm:pullback-reconstruction`).
-/

open Matrix

namespace RenewalGeometry

variable {n : Type*} [Fintype n] [DecidableEq n]

/-! ### `thm:pullback-reconstruction` -/

variable {ν : Type*} [Fintype ν]

/-- The coefficient field `C(z) = (I ⊗ ⟨z|) V = ∑_ν conj(z_ν) C_ν` of the isometry
`V = ∑_ν C_ν ⊗ |ν⟩` in the orthonormal environment basis `(|ν⟩)`. -/
def coeffField (C : ν → Matrix n n ℂ) (z : ν → ℂ) : Matrix n n ℂ :=
  ∑ i, star (z i) • C i

/-- The Heisenberg pullbacks `𝒫^*(|z⟩⟨w|) = C(z)^* C(w)` of the rank-one environment
operators (`eq:complementary-pullback`). -/
def pullbackSet (C : ν → Matrix n n ℂ) : Set (Matrix n n ℂ) :=
  Set.range fun p : (ν → ℂ) × (ν → ℂ) => (coeffField C p.1)ᴴ * coeffField C p.2

/-- The operator-valued pullback `𝒫^*(𝓑(ℰ))`: since `𝓑(ℰ)` is spanned by the rank-one
operators `|z⟩⟨w|` and `𝒫^*` is linear, it is the span of the pullbacks. -/
def pullbackImage (C : ν → Matrix n n ℂ) : Submodule ℂ (Matrix n n ℂ) :=
  Submodule.span ℂ (pullbackSet C)

/-- The `C^*`-algebra `C^*(𝒫^*(𝓑(ℰ)))` generated by the complementary pullback. -/
def pullbackAlgebra (C : ν → Matrix n n ℂ) : Subalgebra ℂ (Matrix n n ℂ) :=
  starAdjoin (pullbackImage C : Set (Matrix n n ℂ))

theorem pullbackAlgebra_eq_starAdjoin_pullbackSet (C : ν → Matrix n n ℂ) :
    pullbackAlgebra C = starAdjoin (pullbackSet C) := by
  apply le_antisymm
  · refine starAdjoin_le (starAdjoin_starClosed _) ?_
    intro a ha
    have hsub : pullbackSet C ⊆ (starAdjoin (pullbackSet C) : Set (Matrix n n ℂ)) :=
      subset_starAdjoin _
    have : pullbackImage C ≤ Subalgebra.toSubmodule (starAdjoin (pullbackSet C)) :=
      Submodule.span_le.mpr hsub
    exact this ha
  · exact starAdjoin_mono (Submodule.subset_span)

theorem pullbackSet_mem_pullbackAlgebra (C : ν → Matrix n n ℂ) (z w : ν → ℂ) :
    (coeffField C z)ᴴ * coeffField C w ∈ pullbackAlgebra C :=
  mem_starAdjoin_of_mem (Submodule.subset_span ⟨(z, w), rfl⟩)

theorem pullbackAlgebra_starClosed (C : ν → Matrix n n ℂ) :
    ∀ a ∈ pullbackAlgebra C, aᴴ ∈ pullbackAlgebra C :=
  starAdjoin_starClosed _

/-- The coefficient field lies in every subalgebra containing the coefficients. -/
theorem coeffField_mem {C : ν → Matrix n n ℂ} {B : Subalgebra ℂ (Matrix n n ℂ)}
    (hC : ∀ i, C i ∈ B) (z : ν → ℂ) : coeffField C z ∈ B :=
  Subalgebra.sum_mem B fun i _ => B.smul_mem (hC i) _

/-- Every pullback `C(z)^* C(w)` lies in every star-closed subalgebra containing the
coefficients `C_ν`; hence `C^*(𝒫^*(𝓑(ℰ))) ⊆ C^*(C_ν)`. -/
theorem pullbackAlgebra_le {C : ν → Matrix n n ℂ} {B : Subalgebra ℂ (Matrix n n ℂ)}
    (hB : ∀ a ∈ B, aᴴ ∈ B) (hC : ∀ i, C i ∈ B) : pullbackAlgebra C ≤ B := by
  rw [pullbackAlgebra_eq_starAdjoin_pullbackSet]
  refine starAdjoin_le hB ?_
  rintro a ⟨⟨z, w⟩, rfl⟩
  exact B.mul_mem (hB _ (coeffField_mem hC z)) (coeffField_mem hC w)

/-- The identity-pivot computation `𝒫^*(|z₀⟩⟨z_j|) = conj(α) β_j A_j`. -/
theorem pivot_pullback_eq {C : ν → Matrix n n ℂ} {z₀ zj : ν → ℂ} {α β : ℂ}
    {A : Matrix n n ℂ} (h₀ : coeffField C z₀ = α • (1 : Matrix n n ℂ))
    (hj : coeffField C zj = β • A) :
    (coeffField C z₀)ᴴ * coeffField C zj = (star α * β) • A := by
  rw [h₀, hj, Matrix.conjTranspose_smul, Matrix.conjTranspose_one, Matrix.smul_mul,
    Matrix.one_mul, smul_smul]

/-- A pivoted generator lies in the pullback algebra. -/
theorem generator_mem_pullbackAlgebra {C : ν → Matrix n n ℂ} {z₀ zj : ν → ℂ} {α β : ℂ}
    {A : Matrix n n ℂ} (h₀ : coeffField C z₀ = α • (1 : Matrix n n ℂ))
    (hj : coeffField C zj = β • A) (hα : α ≠ 0) (hβ : β ≠ 0) :
    A ∈ pullbackAlgebra C := by
  have hne : star α * β ≠ 0 := mul_ne_zero (star_ne_zero.mpr hα) hβ
  have hA : A = (star α * β)⁻¹ • ((coeffField C z₀)ᴴ * coeffField C zj) := by
    rw [pivot_pullback_eq h₀ hj, smul_smul, inv_mul_cancel₀ hne, one_smul]
  rw [hA]
  exact (pullbackAlgebra C).smul_mem (pullbackSet_mem_pullbackAlgebra C z₀ zj) _

/-- **Identity-pivot reconstruction of the system action (`thm:pullback-reconstruction`).**
Let `𝒜_sys = C^*(C_ν : ν) = C^*(A_1, …, A_s)` and suppose environment vectors
`z₀, z_1, …, z_s` satisfy `C(z₀) = α I` and `C(z_j) = β_j A_j` with `α β_j ≠ 0`.  Then
`C^*(𝒫^*(𝓑(ℰ))) = 𝒜_sys` and `[𝒫^*(𝓑(ℰ))]' = 𝒜_sys'`. -/
theorem pullback_reconstruction {s : ℕ} (C : ν → Matrix n n ℂ)
    (Asys : Subalgebra ℂ (Matrix n n ℂ)) (A : Fin s → Matrix n n ℂ)
    (hsysC : Asys = starAdjoin (Set.range C))
    (hsysA : Asys = starAdjoin (Set.range A))
    (z₀ : ν → ℂ) (z : Fin s → ν → ℂ) (α : ℂ) (β : Fin s → ℂ)
    (h₀ : coeffField C z₀ = α • (1 : Matrix n n ℂ))
    (hj : ∀ j, coeffField C (z j) = β j • A j)
    (hα : α ≠ 0) (hβ : ∀ j, β j ≠ 0) :
    pullbackAlgebra C = Asys ∧
      matCommutant (pullbackAlgebra C : Set (Matrix n n ℂ)) =
        matCommutant (Asys : Set (Matrix n n ℂ)) := by
  have heq : pullbackAlgebra C = Asys := by
    apply le_antisymm
    · -- every pullback `C(z)^* C(w)` lies in `C^*(C_ν) = 𝒜_sys`
      rw [hsysC]
      exact pullbackAlgebra_le (starAdjoin_starClosed _)
        fun i => mem_starAdjoin_of_mem ⟨i, rfl⟩
    · -- every generator `A_j` lies in the pullback algebra, hence so does `C^*(A_j) = 𝒜_sys`
      rw [hsysA]
      refine starAdjoin_le (pullbackAlgebra_starClosed C) ?_
      rintro a ⟨j, rfl⟩
      exact generator_mem_pullbackAlgebra h₀ (hj j) hα (hβ j)
  exact ⟨heq, by rw [heq]⟩

/-- The commutant clause of `thm:pullback-reconstruction` on its own: the complementary
pullback has the same commutant as the represented system algebra. -/
theorem pullback_commutant_eq {s : ℕ} (C : ν → Matrix n n ℂ)
    (Asys : Subalgebra ℂ (Matrix n n ℂ)) (A : Fin s → Matrix n n ℂ)
    (hsysC : Asys = starAdjoin (Set.range C))
    (hsysA : Asys = starAdjoin (Set.range A))
    (z₀ : ν → ℂ) (z : Fin s → ν → ℂ) (α : ℂ) (β : Fin s → ℂ)
    (h₀ : coeffField C z₀ = α • (1 : Matrix n n ℂ))
    (hj : ∀ j, coeffField C (z j) = β j • A j)
    (hα : α ≠ 0) (hβ : ∀ j, β j ≠ 0) :
    matCommutant (pullbackAlgebra C : Set (Matrix n n ℂ)) =
      matCommutant (Asys : Set (Matrix n n ℂ)) :=
  (pullback_reconstruction C Asys A hsysC hsysA z₀ z α β h₀ hj hα hβ).2

end RenewalGeometry
