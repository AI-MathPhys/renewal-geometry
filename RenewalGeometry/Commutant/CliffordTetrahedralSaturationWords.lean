import Mathlib
import RenewalGeometry.Commutant.CliffordTetrahedralCompatibilityExact
import RenewalGeometry.StandardModel.InternalSeedSaturationWords

/-!
# The saturation clause of `thm:clifford-tetrahedral-compatibility` for the actual bank

`CliffordTetrahedralCompatibilityExact.lean` reduces a Clifford-compatible historical bank
`(b_k)` on `P_r ℋ` to the reduced bank `b̃_k = E^* b_k E` on `𝒱_r = e₀₀ P_r ℋ`, with the reduced
representation `ρ_r = reducedRep` and the lift `x̃ ↦ 𝒰_r (I₄ ⊗ x̃) 𝒰_r^*` (`liftHom`).

Here the saturation clause is proved **for the actual bank**: if the reduced bank satisfies
the hypotheses of `thm:internal-seed-saturation` (in the form of
`InternalSeedWords.internal_seed_saturation_words`: census `(3, 2, 1, 1)`, (I1)–(I4) in the
coordinates of the fixed `Φ₀ = censusCommutantEquiv`), then

* `C^*(b̃_k) = 𝒜_tet,r'` and `C^*(b̃_k) ≅ M₃ ⊕ M₂ ⊕ ℂ ⊕ ℂ` (dimension `15`);
* the lift of `C^*(b̃_k)` is `C^*(b_k)` (`map_liftHom_starAdjoin`: the lift is a
  `*`-homomorphism, `liftHom_conjTranspose`), and it equals `𝒜_Cl' ∩ v_r(G)'`;
* the lift is injective, so `C^*(b_k)` is a represented copy of `M₃ ⊕ M₂ ⊕ ℂ ⊕ ℂ` inside
  `𝒜_Cl' ∩ v_r(G)'` (`clifford_tetrahedral_saturation_words`).
-/

open Matrix Module
open scoped Kronecker

namespace RenewalGeometry
namespace CliffordTetrahedral

set_option linter.unusedSectionVars false

/-- The image of a `C^*`-algebra under a `*`-preserving algebra map is the `C^*`-algebra
generated by the image. -/
theorem map_starAdjoin_of_conjTranspose {m p : Type*} [Fintype m] [DecidableEq m] [Fintype p]
    [DecidableEq p] (f : Matrix m m ℂ →ₐ[ℂ] Matrix p p ℂ) (hf : ∀ x, f xᴴ = (f x)ᴴ)
    (S : Set (Matrix m m ℂ)) : (starAdjoin S).map f = starAdjoin (f '' S) := by
  rw [starAdjoin_eq_adjoin, starAdjoin_eq_adjoin, AlgHom.map_adjoin, Set.image_union]
  congr 2
  ext y
  simp only [Set.mem_image, Set.mem_star]
  constructor
  · rintro ⟨x, hx, rfl⟩
    refine ⟨star x, hx, ?_⟩
    rw [star_eq_conjTranspose, star_eq_conjTranspose, hf]
  · rintro ⟨x, hx, hxy⟩
    refine ⟨star x, by rwa [star_star], ?_⟩
    rw [star_eq_conjTranspose, hf, ← star_eq_conjTranspose, hxy, star_star]

section Saturation

variable {n : Type} [Fintype n] [DecidableEq n] {J : Type} [Fintype J] [DecidableEq J]
variable {e : Fin 4 → Fin 4 → Matrix n n ℂ} {E : Matrix n J ℂ}
variable (he : IsMatrixUnits e) (hE1 : Eᴴ * E = 1) (hE2 : E * Eᴴ = e 0 0)
variable {G : Type} [Group G]

/-- The lift `x̃ ↦ 𝒰_r (I₄ ⊗ x̃) 𝒰_r^*` is a `*`-homomorphism. -/
theorem liftHom_conjTranspose (x : Matrix J J ℂ) :
    liftHom he hE1 hE2 xᴴ = (liftHom he hE1 hE2 x)ᴴ := by
  rw [liftHom_apply, liftHom_apply, conjTranspose_mul, conjTranspose_mul,
    conjTranspose_conjTranspose, conjTranspose_kronecker, conjTranspose_one, Matrix.mul_assoc]

/-- The reduced bank lies in the relative commutant `𝒜_tet,r' = C^*(ρ_r(G))'`. -/
theorem reducedBank_mem_extCommutant {β : Type*} (v : G →* Matrix n n ℂ)
    (hvu : ∀ g, (v g)ᴴ = v g⁻¹) (hv : ∀ g i j, v g * e i j = e i j * v g)
    (b : β → Matrix n n ℂ) (hbe : ∀ k i j, b k * e i j = e i j * b k)
    (hbv : ∀ k g, b k * v g = v g * b k) (k : β) :
    Eᴴ * b k * E ∈ InternalSeedSaturation.extCommutant (reducedRep he hE1 hE2 v hv) :=
  (clifford_tetrahedral_reduction he hE1 hE2 v hvu hv b hbe hbv).2.2.2.2
    (subset_starAdjoin _ ⟨k, rfl⟩)

open InternalSeedWords InternalSeedSaturation in
/-- **Saturation clause of `thm:clifford-tetrahedral-compatibility` for the actual bank.**
Under `eq:clifford-tetrahedral-compatibility`, let `ρ_r` be the reduced representation, with
isotypic data `(ι, I, K, W)` (`thm:active-isotypic`; `ExternalIsotypic.external_isotypic`
produces them for the unitary `ρ_r`) and census `(3, 2, 1, 1)`, and suppose the reduced bank
`b̃_k = E^* b_k E` satisfies the hypotheses (I1)–(I4) of `thm:internal-seed-saturation` in the
coordinates of the fixed `Φ₀ = censusCommutantEquiv`.  Then `C^*(b̃_k) = 𝒜_tet,r'`, it is
isomorphic to `M₃ ⊕ M₂ ⊕ ℂ ⊕ ℂ`, its lift is `C^*(b_k)`, the lift is injective, and
`C^*(b_k) = 𝒜_Cl' ∩ v_r(G)'` (a represented copy of `M₃ ⊕ M₂ ⊕ ℂ ⊕ ℂ`, dimension `15`). -/
theorem clifford_tetrahedral_saturation_words (v : G →* Matrix n n ℂ)
    (hvu : ∀ g, (v g)ᴴ = v g⁻¹) (hv : ∀ g i j, v g * e i j = e i j * v g)
    {β : Type} [Fintype β] (b : β → Matrix n n ℂ) (hbe : ∀ k i j, b k * e i j = e i j * b k)
    (hbv : ∀ k g, b k * v g = v g * b k)
    {ι : Type} [Fintype ι] [DecidableEq ι] {I K : ι → Type}
    [∀ c, Fintype (I c)] [∀ c, DecidableEq (I c)] [∀ c, Fintype (K c)] [∀ c, DecidableEq (K c)]
    (W : Matrix J (Σ c, I c × K c) ℂ) (hW1 : Wᴴ * W = 1) (hW2 : W * Wᴴ = 1)
    (hNI : ∀ c, Nonempty (I c))
    (hM : (fun x => Wᴴ * x * W) '' matCommutant (Algebra.adjoin ℂ
      (Set.range (reducedRep he hE1 hE2 v hv)) : Set (Matrix J J ℂ)) = multBlockSet I K)
    (κ : ι ≃ Fin 4) (hcard : ∀ k, Fintype.card (K (κ.symm k)) = ![3, 2, 1, 1] k)
    {τ : Fin 7 → ℂ} (hτ : BlockSupported 0 τ) (hτu : IsUnitVec τ)
    (hI1 : ∀ X : Matrix (Fin 7) (Fin 7) ℂ, pHpriv τ * X * pHpriv τ ∈
      coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ hcard
        (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv))
    (hI1' : (∃ j, 0 < omegaCol τ (wordCoords (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ
        hcard (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv)
        j)) ∨
      ReciprocalWordBridge (coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ hcard
        (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv)) τ)
    {t h : Fin 7 → ℂ} (ht : BlockSupported 1 t) (hh : BlockSupported 1 h)
    (htu : IsUnitVec t) (hhu : IsUnitVec h)
    (hI2t : rk1 t ∈ coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ hcard
        (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv))
    (hI2h : rk1 h ∈ coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ hcard
        (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv))
    (hne : rk1 t ≠ rk1 h) (hov : star t ⬝ᵥ h ≠ 0)
    (hI4 : (Matrix.single 5 5 1 ∈ coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ
          hcard (fun k => Eᴴ * b k * E)
          (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv) ∧
        Matrix.single 6 6 1 ∈ coordAlgebra (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ
          hcard (fun k => Eᴴ * b k * E)
          (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv)) ∨
      0 < CentralSeparation.etaCen (wordCoords (reducedRep he hE1 hE2 v hv) W hW1 hW2 hNI hM κ
        hcard (fun k => Eᴴ * b k * E)
        (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv))) :
    starAdjoin (Set.range fun k => Eᴴ * b k * E) = extCommutant (reducedRep he hE1 hE2 v hv) ∧
      Nonempty (InternalAssembly.blockAlgebra ≃ₐ[ℂ]
        starAdjoin (Set.range fun k => Eᴴ * b k * E)) ∧
      (starAdjoin (Set.range fun k => Eᴴ * b k * E)).map (liftHom he hE1 hE2) =
        starAdjoin (Set.range b) ∧
      Function.Injective (liftHom he hE1 hE2) ∧
      (starAdjoin (Set.range b) : Set (Matrix n n ℂ)) =
        {X | (∀ i j, X * e i j = e i j * X) ∧ ∀ g, X * v g = v g * X} ∧
      finrank ℂ (starAdjoin (Set.range b)) = 15 := by
  set ρ := reducedRep he hE1 hE2 v hv
  obtain ⟨hsat, -, h15, -⟩ := internal_seed_saturation_words ρ W hW1 hW2 hNI hM κ hcard
    (fun k => Eᴴ * b k * E) (reducedBank_mem_extCommutant he hE1 hE2 v hvu hv b hbe hbv)
    hτ hτu hI1 hI1' ht hh htu hhu hI2t hI2h hne hov hI4
  have hmap : (starAdjoin (Set.range fun k => Eᴴ * b k * E)).map (liftHom he hE1 hE2) =
      starAdjoin (Set.range b) := by
    rw [map_starAdjoin_of_conjTranspose _ (liftHom_conjTranspose he hE1 hE2), ← Set.range_comp]
    congr 2
    funext k
    exact ((clifford_tetrahedral_reduction he hE1 hE2 v hvu hv b hbe hbv).2.2.1 k).symm
  have hinj := liftHom_injective he hE1 hE2
  refine ⟨hsat, ⟨(censusCommutantEquiv ρ W hW1 hW2 hNI hM κ hcard).trans
    (Subalgebra.equivOfEq _ _ hsat.symm)⟩, hmap, hinj, ?_, ?_⟩
  · rw [← hmap, Subalgebra.coe_map, hsat]
    exact liftHom_image_extCommutant he hE1 hE2 v hv
  · rw [← hmap]
    rw [← (Subalgebra.equivMapOfInjective _ _ hinj).toLinearEquiv.finrank_eq, hsat, h15]

end Saturation

end CliffordTetrahedral
end RenewalGeometry
