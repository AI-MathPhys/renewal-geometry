import Mathlib
import RenewalGeometry.Commutant.RepresentedJointPacket
import RenewalGeometry.Commutant.MultiplicityQuiverArrows
import RenewalGeometry.Commutant.GraphSupportPolarDuality

/-!
# Intrinsic coefficient spaces, the typed multiplicity algebra and the coefficient action
  algebra (`def:incidence-coefficients`, `def:typed-multiplicity`)

`def:incidence-coefficients` and `def:typed-multiplicity` of the spacetime–gauge duality
manuscript, for a represented joint packet `P` (`def:joint-packet`, `RepresentedJointPacket`)
with incidences `Y_e : K_{s(e)} ⊗ M_{s(e)} → K_{t(e)} ⊗ M_{t(e)}`, `K_λ = ℂ⁴ ⊗ V_λ`.

* `sliceLinearMap`: the slice map `φ ↦ (φ ⊗ id)(Y_e)`, linear in the functional
  `φ ∈ B(K_λ, K_μ)^*`;
* `RepresentedJointPacket.coefficientSpace` = `𝔅_e = {(φ ⊗ id)(Y_e) : φ}`
  (`eq:intrinsic-incidence-coefficients`), a linear operator space (the range of the slice
  map); `coefficientSpace_eq_span_blockSlice` is `eq:general-incidence-expansion`: `𝔅_e` is
  the span of the Hilbert–Schmidt-basis coefficient blocks `F_{e,a}` of `Y_e = ∑_a D_{e,a} ⊗
  F_{e,a}`;
* `RepresentedJointPacket.IsTypedMultiplicity`, `RepresentedJointPacket.typedMultiplicityAlgebra`
  = `𝓜_type` (`eq:typed-multiplicity`): the star subalgebra of block families `(R_λ)` with
  `R_μ B = B R_λ` and `R_λ B^* = B^* R_μ` for **every** `B ∈ 𝔅_e`, `e : λ → μ`
  (`isTypedMultiplicity_iff_blockSlice` reduces this to the finitely many coefficient-block
  equations); as a unital star-closed subalgebra of a finite-dimensional matrix algebra it is
  a unital C*-algebra on `𝓜 = ⊕_λ M_λ`;
* `RepresentedJointPacket.multiplicityAction` = `ι((R_λ)) = ⊕_λ I_{K_λ} ⊗ R_λ`, the
  representation on the full carrier (multiplicative, unital, star-preserving, faithful when
  the internal carriers are nonempty);
* `RepresentedJointPacket.coefficientActionAlgebra` = `𝒪_Y = C*(Z_λ, B, B^* : B ∈ 𝔅_e, e ∈ E)`
  on the total multiplicity carrier (`eq:coefficient-action-algebra`), the star subalgebra
  generated by the vertex projections and the embedded slices; it contains the generators and
  their adjoints and is the least star-closed unital subalgebra doing so
  (`coefficientActionAlgebra_le_iff`); in finite dimension the algebraic star hull is the
  C*-hull.
-/

open Matrix
open scoped Kronecker

namespace RenewalGeometry

section SliceLinear

open SMSTQuiverCommutantAssembly

variable {Va Vb Na Nb : Type*} [Fintype Va] [Fintype Vb] [DecidableEq Va] [DecidableEq Vb]

/-- The slice map `φ ↦ (φ ⊗ id)(T)`, linear in the functional `φ ∈ B(V_a, V_b)^*`. -/
def sliceLinearMap (T : Matrix (Vb × Nb) (Va × Na) ℂ) :
    (Matrix Vb Va ℂ →ₗ[ℂ] ℂ) →ₗ[ℂ] Matrix Nb Na ℂ where
  toFun φ := functionalSlice φ T
  map_add' φ ψ := by
    funext n m
    rfl
  map_smul' a φ := by
    funext n m
    rfl

omit [Fintype Va] [Fintype Vb] [DecidableEq Va] [DecidableEq Vb] in
theorem sliceLinearMap_apply (T : Matrix (Vb × Nb) (Va × Na) ℂ) (φ : Matrix Vb Va ℂ →ₗ[ℂ] ℂ) :
    sliceLinearMap T φ = functionalSlice φ T :=
  rfl

end SliceLinear

namespace RepresentedJointPacket

open SMSTQuiverCommutantAssembly GraphLoadedEdgeCommutant

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]
variable (P : RepresentedJointPacket Λ V M E)

/-! ### Intrinsic incidence coefficient spaces (`def:incidence-coefficients`) -/

/-- **`eq:intrinsic-incidence-coefficients`**: the intrinsic coefficient space
`𝔅_e = {(φ ⊗ id)(Y_e) : φ ∈ B(K_{s(e)}, K_{t(e)})^*} ⊆ B(M_{s(e)}, M_{t(e)})`, a linear
operator space (the range of the slice map), not a choice of a single residue. -/
def coefficientSpace (e : E) : Submodule ℂ (Matrix (M (P.tgt e)) (M (P.src e)) ℂ) :=
  LinearMap.range (sliceLinearMap (P.Y e))

theorem mem_coefficientSpace_iff (e : E) (B : Matrix (M (P.tgt e)) (M (P.src e)) ℂ) :
    B ∈ P.coefficientSpace e ↔
      ∃ φ : Matrix (Fin 4 × V (P.tgt e)) (Fin 4 × V (P.src e)) ℂ →ₗ[ℂ] ℂ,
        functionalSlice φ (P.Y e) = B :=
  LinearMap.mem_range

/-- Every functional slice of `Y_e` lies in `𝔅_e`. -/
theorem functionalSlice_mem_coefficientSpace (e : E)
    (φ : Matrix (Fin 4 × V (P.tgt e)) (Fin 4 × V (P.src e)) ℂ →ₗ[ℂ] ℂ) :
    functionalSlice φ (P.Y e) ∈ P.coefficientSpace e :=
  ⟨φ, rfl⟩

/-- **`eq:general-incidence-expansion`**: `𝔅_e` is the span of the Hilbert–Schmidt-basis
coefficient blocks `F_{e,a}` (`a = (k', k)` an entry of `B(K_{s(e)}, K_{t(e)})`) of
`Y_e = ∑_a D_{e,a} ⊗ F_{e,a}`. -/
theorem coefficientSpace_eq_span_blockSlice (e : E) :
    P.coefficientSpace e =
      Submodule.span ℂ (Set.range
        fun a : (Fin 4 × V (P.tgt e)) × (Fin 4 × V (P.src e)) =>
          blockSlice (P.Y e) a.1 a.2) := by
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    rw [sliceLinearMap_apply, functionalSlice_eq_sum]
    refine Submodule.sum_mem _ fun vb _ => Submodule.sum_mem _ fun va _ => ?_
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(vb, va), rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨⟨vb, va⟩, rfl⟩
    exact ⟨Matrix.entryLinearMap ℂ ℂ vb va, (blockSlice_eq_functionalSlice (P.Y e) vb va).symm⟩

/-! ### The typed multiplicity algebra (`eq:typed-multiplicity`) -/

/-- The two intertwining equations `R_μ B = B R_λ` and `R_λ B^* = B^* R_μ` for every slice
`B ∈ 𝔅_e` of every edge `e : λ → μ` (`eq:typed-multiplicity`). -/
def IsTypedMultiplicity (R : ∀ l, Matrix (M l) (M l) ℂ) : Prop :=
  ∀ e, ∀ B ∈ P.coefficientSpace e,
    R (P.tgt e) * B = B * R (P.src e) ∧ R (P.src e) * Bᴴ = Bᴴ * R (P.tgt e)

/-- Intertwining every slice of `𝔅_e` is equivalent to the finitely many coefficient-block
equations on the Hilbert–Schmidt-basis coefficients `F_{e,a}`. -/
theorem isTypedMultiplicity_iff_blockSlice (R : ∀ l, Matrix (M l) (M l) ℂ) :
    P.IsTypedMultiplicity R ↔
      ∀ e (vb : Fin 4 × V (P.tgt e)) (va : Fin 4 × V (P.src e)),
        R (P.tgt e) * blockSlice (P.Y e) vb va = blockSlice (P.Y e) vb va * R (P.src e) ∧
        R (P.src e) * (blockSlice (P.Y e) vb va)ᴴ =
          (blockSlice (P.Y e) vb va)ᴴ * R (P.tgt e) := by
  constructor
  · intro hR e vb va
    apply hR e
    rw [coefficientSpace_eq_span_blockSlice]
    exact Submodule.subset_span ⟨(vb, va), rfl⟩
  · intro hR e B hB
    rw [coefficientSpace_eq_span_blockSlice] at hB
    induction hB using Submodule.span_induction with
    | mem B hB =>
        obtain ⟨⟨vb, va⟩, rfl⟩ := hB
        exact hR e vb va
    | zero => simp
    | add B C _ _ hB hC =>
        rw [Matrix.mul_add, Matrix.add_mul, hB.1, hC.1, Matrix.conjTranspose_add,
          Matrix.mul_add, Matrix.add_mul, hB.2, hC.2]
        exact ⟨rfl, rfl⟩
    | smul c B _ hB =>
        rw [Matrix.mul_smul, Matrix.smul_mul, hB.1, Matrix.conjTranspose_smul, Matrix.mul_smul,
          Matrix.smul_mul, hB.2]
        exact ⟨rfl, rfl⟩

/-- **`eq:typed-multiplicity`**: the typed multiplicity algebra `𝓜_type`, the star subalgebra
of block families `(R_λ)_λ` on `𝓜 = ⊕_λ M_λ` intertwining every slice `B ∈ 𝔅_e` and its
adjoint on every edge `e : λ → μ`.  It is the endomorphism algebra of the adjoint-closed
coefficient-space quiver. -/
def typedMultiplicityAlgebra : StarSubalgebra ℂ (∀ l, Matrix (M l) (M l) ℂ) where
  carrier := {R | P.IsTypedMultiplicity R}
  mul_mem' := by
    intro R S hR hS
    have hR' : P.IsTypedMultiplicity R := hR
    have hS' : P.IsTypedMultiplicity S := hS
    intro e B hB
    obtain ⟨hR1, hR2⟩ := hR' e B hB
    obtain ⟨hS1, hS2⟩ := hS' e B hB
    simp only [Pi.mul_apply]
    constructor
    · calc R (P.tgt e) * S (P.tgt e) * B = R (P.tgt e) * (B * S (P.src e)) := by
            rw [Matrix.mul_assoc, hS1]
        _ = B * R (P.src e) * S (P.src e) := by rw [← Matrix.mul_assoc, hR1]
        _ = B * (R (P.src e) * S (P.src e)) := by rw [Matrix.mul_assoc]
    · calc R (P.src e) * S (P.src e) * Bᴴ = R (P.src e) * (Bᴴ * S (P.tgt e)) := by
            rw [Matrix.mul_assoc, hS2]
        _ = Bᴴ * R (P.tgt e) * S (P.tgt e) := by rw [← Matrix.mul_assoc, hR2]
        _ = Bᴴ * (R (P.tgt e) * S (P.tgt e)) := by rw [Matrix.mul_assoc]
  one_mem' := by
    intro e B hB
    simp
  add_mem' := by
    intro R S hR hS
    have hR' : P.IsTypedMultiplicity R := hR
    have hS' : P.IsTypedMultiplicity S := hS
    intro e B hB
    obtain ⟨hR1, hR2⟩ := hR' e B hB
    obtain ⟨hS1, hS2⟩ := hS' e B hB
    simp only [Pi.add_apply]
    rw [Matrix.add_mul, Matrix.mul_add, Matrix.add_mul, Matrix.mul_add, hR1, hS1, hR2, hS2]
    exact ⟨rfl, rfl⟩
  zero_mem' := by
    intro e B hB
    simp
  algebraMap_mem' := by
    intro c e B hB
    simp only [Pi.algebraMap_apply, Algebra.algebraMap_eq_smul_one]
    rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_smul,
      Matrix.one_mul, Matrix.mul_one, Matrix.one_mul, Matrix.mul_one]
    exact ⟨rfl, rfl⟩
  star_mem' := by
    intro R hR
    have hR' : P.IsTypedMultiplicity R := hR
    intro e B hB
    obtain ⟨h1, h2⟩ := hR' e B hB
    simp only [Pi.star_apply, Matrix.star_eq_conjTranspose]
    constructor
    · have h2' := congrArg conjTranspose h2
      simp only [conjTranspose_mul, conjTranspose_conjTranspose] at h2'
      exact h2'.symm
    · have h1' := congrArg conjTranspose h1
      simp only [conjTranspose_mul] at h1'
      exact h1'.symm

/-- Membership in `𝓜_type` is exactly the pair of intertwining equations for every slice
of every coefficient space. -/
theorem mem_typedMultiplicityAlgebra (R : ∀ l, Matrix (M l) (M l) ℂ) :
    R ∈ P.typedMultiplicityAlgebra ↔ P.IsTypedMultiplicity R :=
  Iff.rfl

/-! ### The representation `ι` on the full carrier -/

variable (V M) in
/-- `ι((R_λ)_λ) = ⊕_λ I_{K_λ} ⊗ R_λ`, `K_λ = ℂ⁴ ⊗ V_λ`: the faithful representation of the
block-diagonal multiplicity operators on the full carrier `ℋ = ⊕_λ K_λ ⊗ M_λ`. -/
def multiplicityAction (R : ∀ l, Matrix (M l) (M l) ℂ) :
    Matrix (Carrier V M) (Carrier V M) ℂ :=
  blockDiagonal' fun l => (1 : Matrix (Fin 4 × V l) (Fin 4 × V l) ℂ) ⊗ₖ R l

omit [∀ l, DecidableEq (M l)] in
/-- `ι` is multiplicative. -/
theorem multiplicityAction_mul (R S : ∀ l, Matrix (M l) (M l) ℂ) :
    multiplicityAction V M (R * S) = multiplicityAction V M R * multiplicityAction V M S := by
  unfold multiplicityAction
  rw [← blockDiagonal'_mul]
  congr 1
  funext l
  rw [← Matrix.mul_kronecker_mul, Matrix.one_mul]
  rfl

omit [Fintype Λ] [∀ l, Fintype (V l)] [∀ l, Fintype (M l)] in
/-- `ι` is unital. -/
theorem multiplicityAction_one : multiplicityAction V M 1 = 1 := by
  unfold multiplicityAction
  rw [← blockDiagonal'_one]
  congr 1
  funext l
  simp only [Pi.one_apply, Matrix.one_kronecker_one]

omit [Fintype Λ] [∀ l, Fintype (V l)] [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] in
/-- `ι` is star-preserving. -/
theorem multiplicityAction_conjTranspose (R : ∀ l, Matrix (M l) (M l) ℂ) :
    (multiplicityAction V M R)ᴴ = multiplicityAction V M (star R) := by
  unfold multiplicityAction
  rw [blockDiagonal'_conjTranspose]
  congr 1
  funext l
  rw [Matrix.conjTranspose_kronecker, Matrix.conjTranspose_one]
  rfl

omit [Fintype Λ] [∀ l, Fintype (V l)] [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] in
/-- `ι` is additive. -/
theorem multiplicityAction_add (R S : ∀ l, Matrix (M l) (M l) ℂ) :
    multiplicityAction V M (R + S) = multiplicityAction V M R + multiplicityAction V M S := by
  unfold multiplicityAction
  rw [← blockDiagonal'_add]
  congr 1
  funext l
  simp only [Pi.add_apply, Matrix.kronecker_add]

omit [Fintype Λ] [∀ l, Fintype (V l)] [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] in
/-- `ι` is faithful when every internal carrier `V_λ` is nonempty. -/
theorem multiplicityAction_injective (h : ∀ l, Nonempty (V l)) :
    Function.Injective (multiplicityAction V M) := by
  intro R S hRS
  have h1 := blockDiagonal'_injective hRS
  funext l
  ext i j
  obtain ⟨v⟩ := h l
  have h2 := congrFun (congrFun (congrFun h1 l) (((0 : Fin 4), v), i)) (((0 : Fin 4), v), j)
  simpa [Matrix.kroneckerMap_apply] using h2

/-! ### The multiplicity coefficient action algebra (`eq:coefficient-action-algebra`) -/

/-- The generating set `{Z_λ} ∪ {B : B ∈ 𝔅_e, e ∈ E}` of `𝒪_Y` on the total multiplicity
carrier `𝓜 = ⊕_λ M_λ`, each slice placed on its `(t(e), s(e))` corner. -/
def coefficientGenerators : Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ) :=
  Set.range (vertexProjection M) ∪
    ⋃ e, blockEmbed M '' (P.coefficientSpace e : Set (Matrix (M (P.tgt e)) (M (P.src e)) ℂ))

/-- **`eq:coefficient-action-algebra`**: the multiplicity coefficient action algebra
`𝒪_Y = C*(Z_λ, B, B^* : B ∈ 𝔅_e, e ∈ E) ⊆ B(𝓜)`, the star subalgebra generated by the vertex
projections and the intrinsic coefficient slices (in finite dimension the algebraic star hull
is the C*-hull). -/
def coefficientActionAlgebra : StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ) :=
  StarAlgebra.adjoin ℂ P.coefficientGenerators

/-- The vertex projections `Z_λ` lie in `𝒪_Y`. -/
theorem vertexProjection_mem_coefficientActionAlgebra (l : Λ) :
    vertexProjection M l ∈ P.coefficientActionAlgebra :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨l, rfl⟩)

/-- Every slice `B ∈ 𝔅_e` lies in `𝒪_Y`. -/
theorem blockEmbed_mem_coefficientActionAlgebra (e : E)
    {B : Matrix (M (P.tgt e)) (M (P.src e)) ℂ} (hB : B ∈ P.coefficientSpace e) :
    blockEmbed M B ∈ P.coefficientActionAlgebra :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inr (Set.mem_iUnion.mpr ⟨e, ⟨B, hB, rfl⟩⟩))

/-- Every adjoint slice `B^*`, `B ∈ 𝔅_e`, lies in `𝒪_Y`. -/
theorem blockEmbed_conjTranspose_mem_coefficientActionAlgebra (e : E)
    {B : Matrix (M (P.tgt e)) (M (P.src e)) ℂ} (hB : B ∈ P.coefficientSpace e) :
    blockEmbed M Bᴴ ∈ P.coefficientActionAlgebra := by
  rw [← blockEmbed_conjTranspose, ← Matrix.star_eq_conjTranspose]
  exact star_mem (P.blockEmbed_mem_coefficientActionAlgebra e hB)

/-- `𝒪_Y` is the least star-closed unital subalgebra of `B(𝓜)` containing the vertex
projections and all the coefficient slices. -/
theorem coefficientActionAlgebra_le_iff
    (S : StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) :
    P.coefficientActionAlgebra ≤ S ↔
      (∀ l, vertexProjection M l ∈ S) ∧
        ∀ e, ∀ B ∈ P.coefficientSpace e, blockEmbed M B ∈ S := by
  rw [coefficientActionAlgebra, StarAlgebra.adjoin_le_iff, coefficientGenerators,
    Set.union_subset_iff, Set.range_subset_iff, Set.iUnion_subset_iff]
  simp only [Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- The minimality clause: any star-closed unital subalgebra containing the generators
contains `𝒪_Y`. -/
theorem coefficientActionAlgebra_le
    (S : StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ))
    (hZ : ∀ l, vertexProjection M l ∈ S)
    (hB : ∀ e, ∀ B ∈ P.coefficientSpace e, blockEmbed M B ∈ S) :
    P.coefficientActionAlgebra ≤ S :=
  (P.coefficientActionAlgebra_le_iff S).mpr ⟨hZ, hB⟩

end RepresentedJointPacket

end RenewalGeometry
