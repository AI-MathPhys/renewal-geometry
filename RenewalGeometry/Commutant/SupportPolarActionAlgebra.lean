import RenewalGeometry.Commutant.SingularPolarData
import RenewalGeometry.Commutant.GraphLoadedEdgeCommutantAssembly

/-!
# The support-polar action algebra

`def:support-polar` of the spacetime--gauge duality manuscript: on the total
multiplicity carrier `𝓜 = ⊕_λ M_λ`, with vertex projections `Z_λ` and polar
decompositions `F_e = U_e P_e` of the incidence maps, the support-polar action
algebra is
`O_F^sup = C^*(Z_λ, F_e^* F_e, U_e, U_e^* : λ, e) ⊆ B(𝓜)`.

This file works over the graph-indexed edge data of
`GraphLoadedEdgeCommutantAssembly` (an incidence graph `G` on the vertex type
`V`, multiplicity carriers `M v`, and a rectangular incidence map `F h` on
every oriented edge `h : G.Adj u v`).  The total carrier is the sigma type
`Σ v, M v`; `vertexProjection v` is `Z_v`; `blockEmbed A` places a
rectangular block on the corresponding `(v, u)` corner of `B(𝓜)`.  The polar
partial isometry `U_e` is canonical: `polarIsometry F` is a choice of the
singular polar data of `F` (existence transported from
`exists_singular_polar_data` through `Fintype.equivFin`), so that
`F = U P`, `P ≥ 0`, `P² = FᴴF`, `U UᴴU = U` and `UᴴU` is the support of `P`.
`supportPolarAlgebra` is then the star subalgebra generated by the four
families of generators; in finite dimension the algebraic star hull is the
C*-hull.
-/

open Matrix
open scoped ComplexOrder MatrixOrder

namespace RenewalGeometry

set_option linter.unusedDecidableInType false

section PolarGeneral

/-- Singular polar data for an arbitrary rectangular matrix over an arbitrary
finite column type (transport of `exists_singular_polar_data`). -/
theorem exists_singular_polar_data_general {n H : Type*} [Fintype n] [DecidableEq n]
    [Fintype H] (F : Matrix H n ℂ) :
    ∃ (U : Matrix H n ℂ) (P Pd : Matrix n n ℂ),
      P.PosSemidef ∧ F = U * P ∧ P * P = Fᴴ * F ∧
      U * (Uᴴ * U) = U ∧ P * Pd = Uᴴ * U ∧ Pd * P = Uᴴ * U := by
  classical
  let e := Fintype.equivFin n
  obtain ⟨U', P', Pd', hP, hFUP, hP2, hUp, hPPd, hPdP, -⟩ :=
    exists_singular_polar_data (F.submatrix id e.symm)
  have hF : (F.submatrix id e.symm).submatrix id e = F := by
    ext i j
    simp [Matrix.submatrix_apply]
  refine ⟨U'.submatrix id e, P'.submatrix e e, Pd'.submatrix e e, hP.submatrix e,
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [← Matrix.submatrix_mul _ _ _ e _ e.bijective, ← hFUP, hF]
  · rw [← Matrix.submatrix_mul _ _ _ e _ e.bijective, hP2, Matrix.conjTranspose_submatrix,
      Matrix.submatrix_mul _ _ _ (id : H → H) _ Function.bijective_id]
    simp [Matrix.submatrix_submatrix]
  · rw [Matrix.conjTranspose_submatrix, ← Matrix.submatrix_mul _ _ _ (id : H → H) _
      Function.bijective_id, ← Matrix.submatrix_mul _ _ _ e _ e.bijective, hUp]
  · rw [Matrix.conjTranspose_submatrix, ← Matrix.submatrix_mul _ _ _ (id : H → H) _
      Function.bijective_id, ← Matrix.submatrix_mul _ _ _ e _ e.bijective, hPPd]
  · rw [Matrix.conjTranspose_submatrix, ← Matrix.submatrix_mul _ _ _ (id : H → H) _
      Function.bijective_id, ← Matrix.submatrix_mul _ _ _ e _ e.bijective, hPdP]

/-- The canonical polar partial isometry `U` of a rectangular matrix
`F = U P` (a choice among the singular polar data of `F`). -/
noncomputable def polarIsometry {n H : Type*} [Fintype n] [DecidableEq n] [Fintype H]
    (F : Matrix H n ℂ) : Matrix H n ℂ :=
  Classical.choose (exists_singular_polar_data_general F)

/-- The defining properties of `polarIsometry`: there is a positive `P` with
`F = U P`, `P² = FᴴF`, `U` a partial isometry, and `UᴴU` the support of `P`. -/
theorem polarIsometry_spec {n H : Type*} [Fintype n] [DecidableEq n] [Fintype H]
    (F : Matrix H n ℂ) :
    ∃ P Pd : Matrix n n ℂ,
      P.PosSemidef ∧ F = polarIsometry F * P ∧ P * P = Fᴴ * F ∧
      polarIsometry F * ((polarIsometry F)ᴴ * polarIsometry F) = polarIsometry F ∧
      P * Pd = (polarIsometry F)ᴴ * polarIsometry F ∧
      Pd * P = (polarIsometry F)ᴴ * polarIsometry F :=
  Classical.choose_spec (exists_singular_polar_data_general F)

end PolarGeneral

namespace GraphLoadedEdgeCommutant

variable {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
variable (M : V → Type*) [∀ v, Fintype (M v)] [∀ v, DecidableEq (M v)]
variable (F : ∀ ⦃u v⦄, G.Adj u v → Matrix (M v) (M u) ℂ)

/-- The total multiplicity carrier `𝓜 = ⊕_λ M_λ`. -/
abbrev TotalCarrier := Σ v : V, M v

/-- The vertex projection `Z_v` onto the summand `M_v` of the total carrier. -/
def vertexProjection (v : V) : Matrix (TotalCarrier M) (TotalCarrier M) ℂ :=
  Matrix.diagonal fun p => if p.1 = v then 1 else 0

/-- Place a rectangular block `A : M_u → M_v` on the `(v, u)` corner of the
total carrier. -/
def blockEmbed {u v : V} (A : Matrix (M v) (M u) ℂ) :
    Matrix (TotalCarrier M) (TotalCarrier M) ℂ :=
  Matrix.of fun p q =>
    if hp : p.1 = v then
      if hq : q.1 = u then A (cast (congrArg M hp) p.2) (cast (congrArg M hq) q.2)
      else 0
    else 0

/-- The incidence map `F_e` acting on the total carrier. -/
def incidenceOp {u v : V} (h : G.Adj u v) :
    Matrix (TotalCarrier M) (TotalCarrier M) ℂ :=
  blockEmbed M (F h)

/-- The support metric `F_e^* F_e` on the total carrier. -/
def supportMetric {u v : V} (h : G.Adj u v) :
    Matrix (TotalCarrier M) (TotalCarrier M) ℂ :=
  (incidenceOp G M F h)ᴴ * incidenceOp G M F h

/-- The polar partial isometry `U_e` of the edge `e`, acting on the total
carrier. -/
noncomputable def polarOp {u v : V} (h : G.Adj u v) :
    Matrix (TotalCarrier M) (TotalCarrier M) ℂ :=
  blockEmbed M (polarIsometry (F h))

/-- The generator set `{Z_λ, F_e^* F_e, U_e, U_e^*}` of the support-polar
action algebra. -/
noncomputable def supportPolarGenerators :
    Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ) :=
  Set.range (vertexProjection M) ∪
    {X | ∃ (u v : V) (h : G.Adj u v), X = supportMetric G M F h} ∪
    {X | ∃ (u v : V) (h : G.Adj u v), X = polarOp G M F h} ∪
    {X | ∃ (u v : V) (h : G.Adj u v), X = (polarOp G M F h)ᴴ}

/-- **`def:support-polar`.**  The support-polar action algebra
`O_F^sup = C^*(Z_λ, F_e^* F_e, U_e, U_e^* : λ, e) ⊆ B(𝓜)`, as the star
subalgebra of `B(𝓜)` generated by the vertex projections, the support
metrics and the polar partial isometries (with adjoints) of every edge. -/
noncomputable def supportPolarAlgebra :
    StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ) :=
  StarAlgebra.adjoin ℂ (supportPolarGenerators G M F)

theorem vertexProjection_mem (v : V) :
    vertexProjection M v ∈ supportPolarAlgebra G M F :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inl (Or.inl (Or.inl ⟨v, rfl⟩)))

theorem supportMetric_mem {u v : V} (h : G.Adj u v) :
    supportMetric G M F h ∈ supportPolarAlgebra G M F :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inl (Or.inl (Or.inr ⟨u, v, h, rfl⟩)))

theorem polarOp_mem {u v : V} (h : G.Adj u v) :
    polarOp G M F h ∈ supportPolarAlgebra G M F :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inl (Or.inr ⟨u, v, h, rfl⟩))

theorem polarOp_conjTranspose_mem {u v : V} (h : G.Adj u v) :
    (polarOp G M F h)ᴴ ∈ supportPolarAlgebra G M F :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨u, v, h, rfl⟩)

/-- The vertex projections are orthogonal projections summing to the
identity on the total carrier. -/
theorem vertexProjection_mul_self (v : V) :
    vertexProjection M v * vertexProjection M v = vertexProjection M v := by
  unfold vertexProjection
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  funext p
  by_cases h : p.1 = v <;> simp [h]

omit [Fintype V] [∀ v, Fintype (M v)] in
theorem vertexProjection_conjTranspose (v : V) :
    (vertexProjection M v)ᴴ = vertexProjection M v := by
  unfold vertexProjection
  rw [Matrix.diagonal_conjTranspose]
  congr 1
  funext p
  by_cases h : p.1 = v <;> simp [h]

omit [∀ v, Fintype (M v)] in
theorem sum_vertexProjection :
    ∑ v, vertexProjection M v = 1 := by
  ext p q
  simp only [vertexProjection, Matrix.sum_apply, Matrix.diagonal_apply, Matrix.one_apply]
  by_cases hpq : p = q
  · subst hpq
    simp
  · simp [hpq]

omit [Fintype V] [DecidableEq V] in
/-- The polar partial isometry of every edge synthesizes the incidence map:
`F_e = U_e P_e` block-wise on the carrier. -/
theorem incidenceOp_eq_polar_mul {u v : V} (h : G.Adj u v) :
    ∃ P : Matrix (M u) (M u) ℂ, P.PosSemidef ∧ P * P = (F h)ᴴ * F h ∧
      F h = polarIsometry (F h) * P := by
  obtain ⟨P, -, hP, hFUP, hP2, -, -, -⟩ := polarIsometry_spec (F h)
  exact ⟨P, hP, hP2, hFUP⟩

end GraphLoadedEdgeCommutant
end RenewalGeometry
