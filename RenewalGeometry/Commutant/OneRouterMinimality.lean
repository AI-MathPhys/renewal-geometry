import RenewalGeometry.StandardModel.WeakResetGenerationExact

/-!
# One-router source minimality

`cor:one-router-minimality` of the spacetime--gauge duality manuscript: once
an `n`-dimensional multiplicity carrier with its diagonal minimal
projections `p_1, …, p_n` has occurred, a single cyclic nonnormal router
suffices to generate `M_n(ℂ)`, whereas without any off-diagonal word the
generated algebra stays commutative.

The router used is the nilpotent cyclic shift `N e_{i+1} = e_i`
(`cyclicRouter`), whose support graph is the path `1 - 2 - ⋯ - n`.  Products
`p_i N p_{i+1}` are the matrix units `E_{i,i+1}`, products along the path
give every `E_{ij}` with `i ≤ j`, and adjoints give the rest, so the
star algebra generated by the projections and the router is all of
`M_n(ℂ)` (`cyclicRouter_generates`).  The router is nonnormal as soon as
`n ≥ 2` (`cyclicRouter_not_normal`).  Any star algebra generated by diagonal
matrices is commutative (`diagonal_generated_commutative`).
-/

open Matrix

namespace RenewalGeometry
namespace OneRouter

/-- The diagonal minimal projections `p_i = E_{ii}` of an `n`-dimensional
multiplicity carrier. -/
def diagProj (n : ℕ) (i : Fin n) : Matrix (Fin n) (Fin n) ℂ :=
  Matrix.single i i 1

/-- The cyclic nonnormal router: the nilpotent shift with `N_{i,i+1} = 1`
and all other entries zero. -/
def cyclicRouter (n : ℕ) : Matrix (Fin n) (Fin n) ℂ :=
  Matrix.of fun i j => if (j : ℕ) = (i : ℕ) + 1 then 1 else 0

/-- The star algebra generated by the diagonal projections and one router. -/
noncomputable def routerAlgebra (n : ℕ) :
    StarSubalgebra ℂ (Matrix (Fin n) (Fin n) ℂ) :=
  StarAlgebra.adjoin ℂ (Set.range (diagProj n) ∪ {cyclicRouter n})

theorem diagProj_mem (n : ℕ) (i : Fin n) : diagProj n i ∈ routerAlgebra n :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨i, rfl⟩)

theorem cyclicRouter_mem (n : ℕ) : cyclicRouter n ∈ routerAlgebra n :=
  StarAlgebra.subset_adjoin ℂ _ (Or.inr rfl)

/-- `p_i N p_j` is the matrix unit `E_{ij}` whenever `j = i + 1`. -/
theorem single_succ_mem (n : ℕ) (i j : Fin n) (hij : (j : ℕ) = (i : ℕ) + 1) :
    Matrix.single i j (1 : ℂ) ∈ routerAlgebra n := by
  have hmem : diagProj n i * cyclicRouter n * diagProj n j ∈ routerAlgebra n :=
    mul_mem (mul_mem (diagProj_mem n i) (cyclicRouter_mem n)) (diagProj_mem n j)
  have hval : diagProj n i * cyclicRouter n * diagProj n j =
      Matrix.single i j (1 : ℂ) := by
    simp only [diagProj, Matrix.single_mul_mul_single, cyclicRouter, Matrix.of_apply, hij,
      ite_true, mul_one]
  rw [hval] at hmem
  exact hmem

/-- Forward matrix units along the support path. -/
theorem single_forward_mem (n : ℕ) (k : ℕ) :
    ∀ i j : Fin n, (j : ℕ) = (i : ℕ) + k →
      Matrix.single i j (1 : ℂ) ∈ routerAlgebra n := by
  induction k with
  | zero =>
      intro i j hij
      have : j = i := Fin.ext (by omega)
      subst this
      exact diagProj_mem n j
  | succ k ih =>
      intro i j hij
      have hlt : (i : ℕ) + k < n := by
        have := j.isLt
        omega
      let m : Fin n := ⟨(i : ℕ) + k, hlt⟩
      have h1 : Matrix.single i m (1 : ℂ) ∈ routerAlgebra n := ih i m rfl
      have h2 : Matrix.single m j (1 : ℂ) ∈ routerAlgebra n :=
        single_succ_mem n m j (by simp [m]; omega)
      have hprod : Matrix.single i m (1 : ℂ) * Matrix.single m j (1 : ℂ) =
          Matrix.single i j (1 : ℂ) := by
        rw [Matrix.single_mul_single_same, one_mul]
      rw [← hprod]
      exact mul_mem h1 h2

/-- The conjugate transpose of a matrix unit. -/
theorem single_conjTranspose_one {n : ℕ} (i j : Fin n) :
    (Matrix.single i j (1 : ℂ))ᴴ = Matrix.single j i (1 : ℂ) := by
  ext a b
  simp only [Matrix.conjTranspose_apply, Matrix.single_apply]
  by_cases ha : j = a <;> by_cases hb : i = b <;> simp [ha, hb]

/-- Every matrix unit lies in the router algebra. -/
theorem single_mem (n : ℕ) (i j : Fin n) :
    Matrix.single i j (1 : ℂ) ∈ routerAlgebra n := by
  rcases le_or_gt (i : ℕ) (j : ℕ) with h | h
  · exact single_forward_mem n ((j : ℕ) - (i : ℕ)) i j (by omega)
  · have hji : Matrix.single j i (1 : ℂ) ∈ routerAlgebra n :=
      single_forward_mem n ((i : ℕ) - (j : ℕ)) j i (by omega)
    have := star_mem hji
    rw [Matrix.star_eq_conjTranspose, single_conjTranspose_one] at this
    exact this

/-- **One cyclic router generates the full matrix algebra**
(`cor:one-router-minimality`, first clause): the star algebra generated by the
diagonal minimal projections and the cyclic router is `M_n(ℂ)`. -/
theorem cyclicRouter_generates (n : ℕ) : routerAlgebra n = ⊤ := by
  rw [← StarSubalgebra.toSubalgebra_eq_top]
  apply WeakReset.top_of_units
  intro i j
  exact single_mem n i j

/-- The cyclic router is nonnormal for `n ≥ 2`. -/
theorem cyclicRouter_not_normal (m : ℕ) :
    cyclicRouter (m + 2) * (cyclicRouter (m + 2))ᴴ ≠
      (cyclicRouter (m + 2))ᴴ * cyclicRouter (m + 2) := by
  intro h
  let i0 : Fin (m + 2) := ⟨0, by omega⟩
  let i1 : Fin (m + 2) := ⟨1, by omega⟩
  have h1 : (cyclicRouter (m + 2) * (cyclicRouter (m + 2))ᴴ) i0 i0 = 1 := by
    rw [Matrix.mul_apply, Finset.sum_eq_single i1]
    · simp [cyclicRouter, i0, i1]
    · intro k _ hk
      simp only [cyclicRouter, Matrix.of_apply, Matrix.conjTranspose_apply]
      have : (k : ℕ) ≠ (i0 : ℕ) + 1 := by
        intro hk1
        apply hk
        exact Fin.ext (by simp [i0, i1] at hk1 ⊢; omega)
      simp [this]
    · intro habs
      exact absurd (Finset.mem_univ i1) habs
  have h2 : ((cyclicRouter (m + 2))ᴴ * cyclicRouter (m + 2)) i0 i0 = 0 := by
    rw [Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro k _
    simp [cyclicRouter, i0]
  have := congrFun (congrFun h i0) i0
  rw [h1, h2] at this
  exact one_ne_zero this

/-- Any star algebra generated by diagonal matrices is commutative
(`cor:one-router-minimality`, second clause: without an off-diagonal word the
generated algebra remains commutative). -/
theorem diagonal_generated_commutative {n : Type*} [Fintype n] [DecidableEq n]
    (s : Set (Matrix n n ℂ)) (hs : ∀ X ∈ s, ∃ d : n → ℂ, X = Matrix.diagonal d) :
    ∀ a ∈ StarAlgebra.adjoin ℂ s, ∀ b ∈ StarAlgebra.adjoin ℂ s, a * b = b * a := by
  have hs' : ∀ X ∈ s ∪ star s, ∃ d : n → ℂ, X = Matrix.diagonal d := by
    intro X hX
    rcases hX with hX | hX
    · exact hs X hX
    · obtain ⟨d, hd⟩ := hs (star X) hX
      refine ⟨star d, ?_⟩
      have := congrArg star hd
      rw [star_star, Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose] at this
      exact this
  have hcomm : ∀ X ∈ s ∪ star s, ∀ Y ∈ s ∪ star s, Commute X Y := by
    intro X hX Y hY
    obtain ⟨d, rfl⟩ := hs' X hX
    obtain ⟨e, rfl⟩ := hs' Y hY
    show Matrix.diagonal d * Matrix.diagonal e = Matrix.diagonal e * Matrix.diagonal d
    rw [Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
    congr 1
    funext i
    exact mul_comm _ _
  intro a ha b hb
  rw [← StarSubalgebra.mem_toSubalgebra, StarAlgebra.adjoin_toSubalgebra] at ha hb
  have hab : Commute a b := by
    refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute hb ?_
    intro Y hY
    refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute (a := Y) (b := a) ha ?_ |>.symm
    intro X hX
    exact hcomm Y hY X hX
  exact hab

/-- The diagonal projections are diagonal matrices. -/
theorem diagProj_eq_diagonal (n : ℕ) (i : Fin n) :
    diagProj n i = Matrix.diagonal (Pi.single i (1 : ℂ)) := by
  ext a b
  simp only [diagProj, Matrix.single_apply, Matrix.diagonal_apply, Pi.single_apply]
  by_cases ha : i = a <;> by_cases hb : a = b
  · subst ha; subst hb; simp
  · subst ha; simp [hb]
  · subst hb; simp [Ne.symm ha, ha]
  · simp [ha, hb]

/-- **`cor:one-router-minimality`, complete packet.**  On an `n`-dimensional
multiplicity carrier with its diagonal minimal projections: (i) the star
algebra generated by the projections and the single cyclic router is
`M_n(ℂ)`; (ii) the router is nonnormal (for `n ≥ 2`); (iii) the star algebra
generated by the projections alone (no off-diagonal word) is commutative.
Hence one router is source-minimal at fixed multiplicity carrier. -/
theorem one_router_source_minimality (m : ℕ) :
    routerAlgebra (m + 2) = ⊤ ∧
    cyclicRouter (m + 2) * (cyclicRouter (m + 2))ᴴ ≠
      (cyclicRouter (m + 2))ᴴ * cyclicRouter (m + 2) ∧
    ∀ a ∈ StarAlgebra.adjoin ℂ (Set.range (diagProj (m + 2))),
      ∀ b ∈ StarAlgebra.adjoin ℂ (Set.range (diagProj (m + 2))), a * b = b * a := by
  refine ⟨cyclicRouter_generates (m + 2), cyclicRouter_not_normal m, ?_⟩
  apply diagonal_generated_commutative
  rintro X ⟨i, rfl⟩
  exact ⟨Pi.single i 1, diagProj_eq_diagonal (m + 2) i⟩

end OneRouter
end RenewalGeometry
