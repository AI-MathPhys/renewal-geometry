import Mathlib
import RenewalGeometry.Commutant.IntrinsicCoefficientQuiver
import RenewalGeometry.Commutant.ReciprocalWedderburnKronecker

/-!
# Arbitrary-incidence action–multiplicity reconstruction

Covers `thm:main-duality`, `cor:reciprocal-wedderburn` and
`cor:typing-coordinate-canonicality` of the spacetime–gauge duality paper, on the carrier
`ℋ = ⊕_λ ℂ⁴ ⊗ V_λ ⊗ M_λ` of a represented joint packet (`RepresentedJointPacket`), with
incidences `Y_e` of **arbitrary** operator-Schmidt rank (rectangular, singular,
rank-deficient or zero).

Main results (namespace `RenewalGeometry.ArbitraryIncidenceDuality`):

* `extInt_commutant_eq`: an operator commuting with `𝒜_Cl` and `𝒜_type` is uniquely
  `ι((R_λ)) = ⊕_λ I_{K_λ} ⊗ R_λ` (`thm:trinity`, `eq:trinity-Cprime`, on the packet carrier);
* `multiplicityAction_commute_incidence_iff`: on an edge `e : λ → μ`,
  `[ι(R), Y_e] = 0` iff `R_μ F = F R_λ` for all Hilbert–Schmidt coefficient blocks `F` of
  `Y_e`, and similarly for `Y_e^*` (the proof of `thm:main-duality`);
* `actionAlgebra_commutant` / `typedMultiplicity_commutant`: `𝒜_act' = ι(𝓜_type)` and
  `ι(𝓜_type)' = 𝒜_act` (`eq:main-duality`);
* `coefficientActionAlgebra_commutant` / `coefficientCarrierAlgebra_commutant`:
  `𝒪_Y' = 𝓜_type` and `𝓜_type' = 𝒪_Y` on `𝓜 = ⊕_λ M_λ`
  (`eq:coefficient-quiver-duality`), and `typedMultiplicity_iff_quiverEnd`:
  `𝓜_type = End 𝔔_Y` for the adjoint-closed coefficient quiver;
* `coefficientSpace_eq_span_of_basis`: `𝔅_e` is the span of the coefficients of `Y_e` in
  **any** carrier basis (coefficient-basis independence);
* `multiplicity_unitary_of_same_action`, `coefficientSpace_transport`,
  `typedMultiplicity_transport`, `coefficientActionAlgebra_transport`:
  `cor:typing-coordinate-canonicality`;
* `coefficientAction_universal`, `packet_reciprocal_blocks`: `cor:reciprocal-wedderburn`;
* `arbitrary_incidence_main_duality`: the assembled theorem.
-/

open Matrix
open scoped Kronecker

namespace RenewalGeometry
namespace ArbitraryIncidenceDuality

open SMSTQuiverCommutantAssembly GraphLoadedEdgeCommutant RepresentedJointPacket

set_option linter.unusedSectionVars false

/-! ### Generic lemmas -/

section Generic

/-- The commutant of the star algebra generated by an arbitrary set: commuting with every
generator and every adjoint generator. -/
theorem mem_matCommutant_starAdjoin_iff {n : Type*} [Fintype n] [DecidableEq n]
    (S : Set (Matrix n n ℂ)) (T : Matrix n n ℂ) :
    T ∈ matCommutant ((StarAlgebra.adjoin ℂ S : StarSubalgebra ℂ (Matrix n n ℂ)) :
        Set (Matrix n n ℂ)) ↔
      ∀ a ∈ S, T * a = a * T ∧ T * aᴴ = aᴴ * T := by
  constructor
  · intro hT a ha
    refine ⟨hT a (StarAlgebra.subset_adjoin ℂ S ha), hT _ ?_⟩
    rw [← Matrix.star_eq_conjTranspose]
    exact star_mem (StarAlgebra.subset_adjoin ℂ S ha)
  · intro hT a ha
    suffices h : T * a = a * T ∧ T * aᴴ = aᴴ * T from h.1
    induction ha using StarAlgebra.adjoin_induction with
    | mem x hx => exact hT x hx
    | algebraMap r =>
      refine ⟨(Algebra.commutes r T).symm, ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, conjTranspose_smul, conjTranspose_one, smul_mul_assoc,
        mul_smul_comm, one_mul, mul_one]
    | add x y _ _ hx hy =>
      exact ⟨by rw [mul_add, add_mul, hx.1, hy.1],
        by rw [conjTranspose_add, mul_add, add_mul, hx.2, hy.2]⟩
    | mul x y _ _ hx hy =>
      exact ⟨by rw [← mul_assoc, hx.1, mul_assoc, hy.1, ← mul_assoc],
        by rw [conjTranspose_mul, ← mul_assoc, hy.2, mul_assoc, hx.2, ← mul_assoc]⟩
    | star x _ hx =>
      simp only [Matrix.star_eq_conjTranspose, conjTranspose_conjTranspose]
      exact ⟨hx.2, hx.1⟩

variable {Kb Ka Nb Na : Type*} [Fintype Kb] [Fintype Ka] [Fintype Nb] [Fintype Na]
  [DecidableEq Kb] [DecidableEq Ka]
variable {Nb' Na' : Type*}

/-- Entries of `(I ⊗ R) T` are the entries of `R` times the coefficient blocks of `T`. -/
theorem one_kron_mul_apply (Rb : Matrix Nb' Nb ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (n : Nb') (va : Ka) (m : Na) :
    (((1 : Matrix Kb Kb ℂ) ⊗ₖ Rb) * T) (vb, n) (va, m) = (Rb * blockSlice T vb va) n m := by
  rw [Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type, Finset.sum_eq_single vb]
  · simp only [kroneckerMap_apply, one_apply_eq, one_mul, blockSlice]
  · intro k _ hk
    refine Finset.sum_eq_zero fun n' _ => ?_
    rw [kroneckerMap_apply, one_apply_ne (Ne.symm hk), zero_mul, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- Entries of `T (I ⊗ R)`. -/
theorem mul_one_kron_apply (Ra : Matrix Na Na' ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (n : Nb) (va : Ka) (m : Na') :
    (T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ Ra)) (vb, n) (va, m) = (blockSlice T vb va * Ra) n m := by
  rw [Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type, Finset.sum_eq_single va]
  · simp only [kroneckerMap_apply, one_apply_eq, one_mul, blockSlice]
  · intro k _ hk
    refine Finset.sum_eq_zero fun n' _ => ?_
    rw [kroneckerMap_apply, one_apply_ne hk, zero_mul, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- Coefficient blocks of `(I ⊗ A) T`. -/
theorem blockSlice_one_kron_mul (A : Matrix Nb' Nb ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (va : Ka) :
    blockSlice (((1 : Matrix Kb Kb ℂ) ⊗ₖ A) * T) vb va = A * blockSlice T vb va := by
  ext n m
  exact one_kron_mul_apply A T vb n va m

/-- Coefficient blocks of `T (I ⊗ C)`. -/
theorem blockSlice_mul_one_kron (C : Matrix Na Na' ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (va : Ka) :
    blockSlice (T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ C)) vb va = blockSlice T vb va * C := by
  ext n m
  exact mul_one_kron_apply C T vb n va m

/-- **The coefficient expansion of a commutator.**  `(I ⊗ R_b) T = T (I ⊗ R_a)` iff every
Hilbert–Schmidt coefficient block `F` of `T` satisfies `R_b F = F R_a`.  No rank, support or
invertibility assumption on `T`. -/
theorem one_kron_commute_iff_blockSlice (Rb : Matrix Nb Nb ℂ) (Ra : Matrix Na Na ℂ)
    (T : Matrix (Kb × Nb) (Ka × Na) ℂ) :
    ((1 : Matrix Kb Kb ℂ) ⊗ₖ Rb) * T = T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ Ra) ↔
      ∀ vb va, Rb * blockSlice T vb va = blockSlice T vb va * Ra := by
  constructor
  · intro h vb va
    ext n m
    rw [← one_kron_mul_apply, ← mul_one_kron_apply, h]
  · intro h
    ext ⟨vb, n⟩ ⟨va, m⟩
    rw [one_kron_mul_apply, mul_one_kron_apply, h]

/-- The coefficient blocks of an adjoint are the adjoint coefficient blocks. -/
theorem blockSlice_conjTranspose (T : Matrix (Kb × Nb) (Ka × Na) ℂ) (vb : Kb) (va : Ka) :
    blockSlice Tᴴ va vb = (blockSlice T vb va)ᴴ := by
  ext m n
  rfl

end Generic

/-! ### Factor obstruction inside one sector -/

section SectorFactor

variable {I J N : Type*} [Fintype I] [Fintype J] [Fintype N] [DecidableEq I] [DecidableEq J]
  [DecidableEq N]

/-- Commuting with `(a ⊗ I_J) ⊗ I_N` and `(I_I ⊗ b) ⊗ I_N` for all `a`, `b` is commuting with
`g ⊗ I_N` for every `g ∈ B(ℂ^I ⊗ ℂ^J)`: the two full matrix factors generate
`B(ℂ^I ⊗ ℂ^J)`. -/
theorem commute_kron_one_of_factors (X : Matrix ((I × J) × N) ((I × J) × N) ℂ)
    (ha : ∀ a : Matrix I I ℂ,
      X * ((a ⊗ₖ (1 : Matrix J J ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) =
        ((a ⊗ₖ (1 : Matrix J J ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) * X)
    (hb : ∀ b : Matrix J J ℂ,
      X * (((1 : Matrix I I ℂ) ⊗ₖ b) ⊗ₖ (1 : Matrix N N ℂ)) =
        (((1 : Matrix I I ℂ) ⊗ₖ b) ⊗ₖ (1 : Matrix N N ℂ)) * X)
    (g : Matrix (I × J) (I × J) ℂ) :
    X * (g ⊗ₖ (1 : Matrix N N ℂ)) = (g ⊗ₖ (1 : Matrix N N ℂ)) * X := by
  have hunit : ∀ p q : I × J,
      X * (Matrix.single p q (1 : ℂ) ⊗ₖ (1 : Matrix N N ℂ)) =
        (Matrix.single p q (1 : ℂ) ⊗ₖ (1 : Matrix N N ℂ)) * X := by
    rintro ⟨i, v⟩ ⟨i', v'⟩
    have hsplit : Matrix.single (i, v) (i', v') (1 : ℂ) ⊗ₖ (1 : Matrix N N ℂ) =
        ((Matrix.single i i' (1 : ℂ) ⊗ₖ (1 : Matrix J J ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) *
          (((1 : Matrix I I ℂ) ⊗ₖ Matrix.single v v' (1 : ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) := by
      rw [← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul, Matrix.mul_one,
        Matrix.one_mul, Matrix.mul_one, Matrix.single_kronecker_single, mul_one]
    rw [hsplit, ← Matrix.mul_assoc, ha, Matrix.mul_assoc, hb, Matrix.mul_assoc]
  rw [Matrix.matrix_eq_sum_single g]
  refine Finset.sum_induction _ (fun g => X * (g ⊗ₖ (1 : Matrix N N ℂ)) =
      (g ⊗ₖ (1 : Matrix N N ℂ)) * X) ?_ ?_ ?_
  · intro g h hg hh
    simp only at hg hh ⊢
    rw [Matrix.add_kronecker, Matrix.mul_add, Matrix.add_mul, hg, hh]
  · simp
  · intro p _
    refine Finset.sum_induction _ (fun g => X * (g ⊗ₖ (1 : Matrix N N ℂ)) =
        (g ⊗ₖ (1 : Matrix N N ℂ)) * X) ?_ ?_ ?_
    · intro g h hg hh
      simp only at hg hh ⊢
      rw [Matrix.add_kronecker, Matrix.mul_add, Matrix.add_mul, hg, hh]
    · simp
    · intro q _
      have hs : Matrix.single p q (g p q) = g p q • Matrix.single p q (1 : ℂ) := by
        rw [Matrix.smul_single, smul_eq_mul, mul_one]
      rw [hs, Matrix.smul_kronecker, Matrix.mul_smul, Matrix.smul_mul, hunit]

/-- **Sector factor obstruction.**  An operator on `(ℂ^I ⊗ ℂ^J) ⊗ ℂ^N` commuting with both
full matrix factors `M_I ⊗ I ⊗ I` and `I ⊗ M_J ⊗ I` is `I_{I ⊗ J} ⊗ R`. -/
theorem eq_one_kron_of_factors (X : Matrix ((I × J) × N) ((I × J) × N) ℂ)
    (ha : ∀ a : Matrix I I ℂ,
      X * ((a ⊗ₖ (1 : Matrix J J ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) =
        ((a ⊗ₖ (1 : Matrix J J ℂ)) ⊗ₖ (1 : Matrix N N ℂ)) * X)
    (hb : ∀ b : Matrix J J ℂ,
      X * (((1 : Matrix I I ℂ) ⊗ₖ b) ⊗ₖ (1 : Matrix N N ℂ)) =
        (((1 : Matrix I I ℂ) ⊗ₖ b) ⊗ₖ (1 : Matrix N N ℂ)) * X) :
    ∃ R : Matrix N N ℂ, X = (1 : Matrix (I × J) (I × J) ℂ) ⊗ₖ R := by
  rcases isEmpty_or_nonempty (I × J) with hIJ | hIJ
  · refine ⟨0, ?_⟩
    ext p _
    exact (IsEmpty.false p.1).elim
  · exact NCG.CommonOrigin.left_factor_commutant X
      (fun g => (commute_kron_one_of_factors X ha hb g).symm)

end SectorFactor

/-! ### The packet carrier: `thm:trinity` and the edge calculus -/

section Packet

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]

/-- The type projection `intAction (Pi.single l 1)` is the vertex projection of the
sector `l` on the packet carrier. -/
theorem intAction_single_one_eq_vertexProjection (l : Λ) :
    intAction V M (Pi.single l 1) = vertexProjection (SectorCarrier V M) l := by
  ext ⟨k, i⟩ ⟨k', j⟩
  unfold intAction vertexProjection
  by_cases hk : k = k'
  · subst hk
    rw [blockDiagonal'_apply_eq, Matrix.diagonal_apply]
    by_cases hkl : k = l
    · subst hkl
      simp only [Pi.single_eq_same, Matrix.one_kronecker_one, ite_true]
      rw [Matrix.one_apply]
      by_cases hij : i = j
      · subst hij
        simp
      · rw [_root_.if_neg hij, _root_.if_neg]
        intro h
        exact hij (eq_of_heq (Sigma.mk.inj_iff.mp h).2)
    · rw [Pi.single_eq_of_ne hkl, Matrix.kronecker_zero, Matrix.zero_kronecker]
      simp [hkl]
  · rw [blockDiagonal'_apply_ne _ _ _ hk, Matrix.diagonal_apply_ne]
    intro h
    exact hk (congrArg Sigma.fst h)

/-- `ι` commutes with the external action. -/
theorem multiplicityAction_commute_extAction (R : ∀ l, Matrix (M l) (M l) ℂ)
    (a : Matrix (Fin 4) (Fin 4) ℂ) :
    multiplicityAction V M R * extAction V M a = extAction V M a * multiplicityAction V M R := by
  unfold multiplicityAction extAction
  rw [← blockDiagonal'_mul, ← blockDiagonal'_mul]
  congr 1
  funext l
  rw [← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul, Matrix.one_mul, Matrix.mul_one,
    Matrix.one_mul, Matrix.mul_one]

/-- `ι` commutes with the typing action. -/
theorem multiplicityAction_commute_intAction (R : ∀ l, Matrix (M l) (M l) ℂ)
    (b : ∀ l, Matrix (V l) (V l) ℂ) :
    multiplicityAction V M R * intAction V M b = intAction V M b * multiplicityAction V M R := by
  unfold multiplicityAction intAction
  rw [← blockDiagonal'_mul, ← blockDiagonal'_mul]
  congr 1
  funext l
  rw [← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul, Matrix.one_mul, Matrix.mul_one,
    Matrix.one_mul, Matrix.mul_one]

/-- **`thm:trinity` on the packet carrier (`eq:trinity-Cprime`).**  Every operator commuting
with the external Clifford factor and the typing algebra is `ι((R_λ)) = ⊕_λ I_{K_λ} ⊗ R_λ`. -/
theorem extInt_commutant_eq (X : Matrix (Carrier V M) (Carrier V M) ℂ)
    (hext : ∀ a, X * extAction V M a = extAction V M a * X)
    (hint : ∀ b, X * intAction V M b = intAction V M b * X) :
    ∃ R : ∀ l, Matrix (M l) (M l) ℂ, X = multiplicityAction V M R := by
  have hZ : ∀ l, X * vertexProjection (SectorCarrier V M) l =
      vertexProjection (SectorCarrier V M) l * X := by
    intro l
    rw [← intAction_single_one_eq_vertexProjection]
    exact hint _
  have hXeq : X = blockDiagonal' (diagBlock (SectorCarrier V M) X) :=
    eq_blockDiagonal'_of_commute_vertexProjection (SectorCarrier V M) X hZ
  have hblock : ∀ l, ∃ R : Matrix (M l) (M l) ℂ,
      diagBlock (SectorCarrier V M) X l = (1 : Matrix (Fin 4 × V l) (Fin 4 × V l) ℂ) ⊗ₖ R := by
    intro l
    refine eq_one_kron_of_factors _ (fun a => ?_) (fun b => ?_)
    · have h := hext a
      rw [hXeq] at h
      unfold extAction at h
      rw [← blockDiagonal'_mul, ← blockDiagonal'_mul] at h
      exact congrFun (blockDiagonal'_injective h) l
    · have h := hint (Pi.single l b)
      rw [hXeq] at h
      unfold intAction at h
      rw [← blockDiagonal'_mul, ← blockDiagonal'_mul] at h
      have h' := congrFun (blockDiagonal'_injective h) l
      simp only [Pi.single_eq_same] at h'
      exact h'
  choose R hR using hblock
  refine ⟨R, ?_⟩
  rw [hXeq]
  unfold multiplicityAction
  congr 1
  funext l
  exact hR l

variable (P : RepresentedJointPacket Λ V M E)

/-- **Forward edge equations.**  `ι(R)` commutes with the represented incidence `Y_e` iff
`R_{t(e)} F = F R_{s(e)}` for every Hilbert–Schmidt coefficient block `F` of `Y_e`
(`Y_e = ∑_a D_{e,a} ⊗ F_{e,a}`, `D_{e,a}` the matrix units); arbitrary operator-Schmidt rank. -/
theorem multiplicityAction_commute_incidence_iff (R : ∀ l, Matrix (M l) (M l) ℂ) (e : E) :
    multiplicityAction V M R * P.incidenceOp e = P.incidenceOp e * multiplicityAction V M R ↔
      ∀ vb va, R (P.tgt e) * blockSlice (P.Y e) vb va = blockSlice (P.Y e) vb va * R (P.src e) := by
  unfold multiplicityAction RepresentedJointPacket.incidenceOp
  rw [blockDiagonal'_commute_blockEmbed_iff (SectorCarrier V M)]
  exact one_kron_commute_iff_blockSlice _ _ _

/-- **Adjoint edge equations.**  `ι(R)` commutes with `Y_e^*` iff
`R_{s(e)} F^* = F^* R_{t(e)}` for every coefficient block `F` of `Y_e`. -/
theorem multiplicityAction_commute_incidence_conjTranspose_iff (R : ∀ l, Matrix (M l) (M l) ℂ)
    (e : E) :
    multiplicityAction V M R * (P.incidenceOp e)ᴴ = (P.incidenceOp e)ᴴ * multiplicityAction V M R ↔
      ∀ vb va, R (P.src e) * (blockSlice (P.Y e) vb va)ᴴ =
        (blockSlice (P.Y e) vb va)ᴴ * R (P.tgt e) := by
  unfold multiplicityAction RepresentedJointPacket.incidenceOp
  rw [blockEmbed_conjTranspose, blockDiagonal'_commute_blockEmbed_iff (SectorCarrier V M),
    one_kron_commute_iff_blockSlice]
  constructor
  · intro h vb va
    rw [← blockSlice_conjTranspose]
    exact h va vb
  · intro h va vb
    rw [blockSlice_conjTranspose]
    exact h vb va

/-- `ι(R)` commutes with `Y_e` and `Y_e^*` for all edges iff `R ∈ 𝓜_type`. -/
theorem multiplicityAction_commute_incidences_iff (R : ∀ l, Matrix (M l) (M l) ℂ) :
    (∀ e, multiplicityAction V M R * P.incidenceOp e = P.incidenceOp e * multiplicityAction V M R ∧
      multiplicityAction V M R * (P.incidenceOp e)ᴴ =
        (P.incidenceOp e)ᴴ * multiplicityAction V M R) ↔
      R ∈ P.typedMultiplicityAlgebra := by
  rw [RepresentedJointPacket.mem_typedMultiplicityAlgebra,
    RepresentedJointPacket.isTypedMultiplicity_iff_blockSlice]
  constructor
  · intro h e vb va
    exact ⟨(multiplicityAction_commute_incidence_iff P R e).mp (h e).1 vb va,
      (multiplicityAction_commute_incidence_conjTranspose_iff P R e).mp (h e).2 vb va⟩
  · intro h e
    exact ⟨(multiplicityAction_commute_incidence_iff P R e).mpr fun vb va => (h e vb va).1,
      (multiplicityAction_commute_incidence_conjTranspose_iff P R e).mpr
        fun vb va => (h e vb va).2⟩

end Packet

/-! ### `eq:main-duality` on the full carrier -/

section MainDuality

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]
variable (P : RepresentedJointPacket Λ V M E)

/-- `ι(𝓜_type) = {⊕_λ I_{K_λ} ⊗ R_λ : (R_λ) ∈ 𝓜_type}` on the full carrier `ℋ`. -/
def iotaTypedMultiplicity : Set (Matrix (Carrier V M) (Carrier V M) ℂ) :=
  multiplicityAction V M '' (P.typedMultiplicityAlgebra : Set (∀ l, Matrix (M l) (M l) ℂ))

/-- **First identity of `eq:main-duality`: `𝒜_act'_ℋ = ι(𝓜_type)`**, for every represented
joint packet, with no restriction on the operator-Schmidt rank of its incidences. -/
theorem actionAlgebra_commutant :
    matCommutant (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
      iotaTypedMultiplicity P := by
  have hset : (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
      ((StarAlgebra.adjoin ℂ (extAlgebra V M ∪ intAlgebra V M ∪ Set.range P.incidenceOp) :
        StarSubalgebra ℂ _) : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) := rfl
  ext X
  rw [hset, mem_matCommutant_starAdjoin_iff]
  constructor
  · intro hX
    obtain ⟨R, rfl⟩ := extInt_commutant_eq X
      (fun a => (hX _ (Or.inl (Or.inl ⟨a, rfl⟩))).1)
      (fun b => (hX _ (Or.inl (Or.inr ⟨b, rfl⟩))).1)
    refine ⟨R, ?_, rfl⟩
    rw [SetLike.mem_coe, ← multiplicityAction_commute_incidences_iff P R]
    intro e
    exact hX _ (Or.inr ⟨e, rfl⟩)
  · rintro ⟨R, hR, rfl⟩
    rw [SetLike.mem_coe, ← multiplicityAction_commute_incidences_iff P R] at hR
    rintro a ((⟨a0, rfl⟩ | ⟨b, rfl⟩) | ⟨e, rfl⟩)
    · rw [extAction_conjTranspose]
      exact ⟨multiplicityAction_commute_extAction R a0,
        multiplicityAction_commute_extAction R a0ᴴ⟩
    · rw [intAction_conjTranspose]
      exact ⟨multiplicityAction_commute_intAction R b,
        multiplicityAction_commute_intAction R (star b)⟩
    · exact hR e

/-- **Second identity of `eq:main-duality`: `ι(𝓜_type)'_ℋ = 𝒜_act`**, by finite bicommutant
closure of the star-closed unital algebra `𝒜_act`. -/
theorem typedMultiplicity_commutant :
    matCommutant (iotaTypedMultiplicity P) =
      (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) := by
  rw [← actionAlgebra_commutant P]
  ext T
  constructor
  · intro hT
    exact double_commutant P.actionAlgebra P.actionAlgebra_starClosed T hT
  · intro hT b hb
    exact (hb T hT).symm

/-- `ι(𝓜_type)` is a faithful copy of `𝓜_type` as soon as every internal carrier `V_λ` is
nonempty (`ι` is an injective unital star homomorphism). -/
theorem iotaTypedMultiplicity_faithful (h : ∀ l, Nonempty (V l)) :
    Function.Injective (multiplicityAction V M) :=
  multiplicityAction_injective h

end MainDuality

/-! ### `eq:coefficient-quiver-duality` on the multiplicity carrier -/

section CoefficientQuiver

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]
variable (P : RepresentedJointPacket Λ V M E)

/-- `𝓜_type` represented block-diagonally on the total multiplicity carrier `𝓜 = ⊕_λ M_λ`. -/
def coefficientCarrierAlgebra : Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ) :=
  (Matrix.blockDiagonal' : (∀ l, Matrix (M l) (M l) ℂ) → _) ''
    (P.typedMultiplicityAlgebra : Set (∀ l, Matrix (M l) (M l) ℂ))

/-- **`𝒪_Y'_𝓜 = 𝓜_type`** (first identity of `eq:coefficient-quiver-duality`): commuting with
the vertex projections is block diagonality, and commuting with every coefficient slice and
its adjoint is exactly `eq:typed-multiplicity`. -/
theorem coefficientActionAlgebra_commutant :
    matCommutant ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
        Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) =
      coefficientCarrierAlgebra P := by
  ext X
  rw [RepresentedJointPacket.coefficientActionAlgebra, mem_matCommutant_starAdjoin_iff]
  constructor
  · intro hX
    have hZ : ∀ l, X * vertexProjection M l = vertexProjection M l * X :=
      fun l => (hX _ (Or.inl ⟨l, rfl⟩)).1
    have hXeq := eq_blockDiagonal'_of_commute_vertexProjection M X hZ
    refine ⟨diagBlock M X, ?_, hXeq.symm⟩
    intro e B hB
    have h := hX _ (Or.inr (Set.mem_iUnion.mpr ⟨e, ⟨B, hB, rfl⟩⟩))
    rw [hXeq, blockEmbed_conjTranspose] at h
    exact ⟨(blockDiagonal'_commute_blockEmbed_iff M _ _).mp h.1,
      (blockDiagonal'_commute_blockEmbed_iff M _ _).mp h.2⟩
  · rintro ⟨R, hR, rfl⟩
    rintro a (⟨l, rfl⟩ | ha)
    · rw [vertexProjection_conjTranspose]
      exact ⟨blockDiagonal'_commute_vertexProjection M R l,
        blockDiagonal'_commute_vertexProjection M R l⟩
    · obtain ⟨e, B, hB, rfl⟩ := Set.mem_iUnion.mp ha
      obtain ⟨h1, h2⟩ := hR e B hB
      rw [blockEmbed_conjTranspose]
      exact ⟨(blockDiagonal'_commute_blockEmbed_iff M _ _).mpr h1,
        (blockDiagonal'_commute_blockEmbed_iff M _ _).mpr h2⟩

/-- **`𝓜_type'_𝓜 = 𝒪_Y`** (second identity of `eq:coefficient-quiver-duality`), by finite
bicommutant closure. -/
theorem coefficientCarrierAlgebra_commutant :
    matCommutant (coefficientCarrierAlgebra P) =
      ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
        Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) := by
  rw [← coefficientActionAlgebra_commutant P, matCommutant_matCommutant_starSubalgebra]

end CoefficientQuiver

/-! ### `𝓜_type = End 𝔔_Y` for the adjoint-closed coefficient-space quiver -/

section AdjointClosedQuiver

variable {Λ : Type} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type} [Fintype E]
variable (P : RepresentedJointPacket Λ V M E)

/-- Source map of the adjoint-closed coefficient quiver `𝔔_Y`: forward arrows `e : s(e) → t(e)`
and adjoint arrows `e^* : t(e) → s(e)`. -/
def quiverSrc : E ⊕ E → Λ := Sum.elim P.src P.tgt

/-- Target map of the adjoint-closed coefficient quiver. -/
def quiverDst : E ⊕ E → Λ := Sum.elim P.tgt P.src

/-- The represented arrow of `𝔔_Y`: `Y_e` on a forward arrow and `Y_e^*` on an adjoint arrow;
its slice space is `𝔅_e`, resp. `𝔅_e^*`. -/
def quiverArrow : ∀ j : E ⊕ E,
    Matrix ((Fin 4 × V (quiverDst P j)) × M (quiverDst P j))
      ((Fin 4 × V (quiverSrc P j)) × M (quiverSrc P j)) ℂ
  | Sum.inl e => P.Y e
  | Sum.inr e => (P.Y e)ᴴ

/-- **`𝓜_type = End 𝔔_Y`** (`eq:coefficient-quiver-duality`): a block family lies in `𝓜_type`
iff it intertwines every arrow space (`arrowSpace`, the span of all functional slices) of the
adjoint-closed coefficient quiver. -/
theorem typedMultiplicity_iff_quiverEnd (R : ∀ l, Matrix (M l) (M l) ℂ) :
    R ∈ P.typedMultiplicityAlgebra ↔
      ∀ j, ∀ B ∈ arrowSpace (fun l => Fin 4 × V l) M (quiverSrc P) (quiverDst P)
        (quiverArrow P) j, R (quiverDst P j) * B = B * R (quiverSrc P j) := by
  rw [mem_quiverEnd_iff, RepresentedJointPacket.mem_typedMultiplicityAlgebra,
    RepresentedJointPacket.isTypedMultiplicity_iff_blockSlice]
  constructor
  · rintro h (e | e) vb va
    · exact (h e vb va).1
    · have h2 := (h e va vb).2
      have h3 := blockSlice_conjTranspose (P.Y e) va vb
      rw [← h3] at h2
      exact h2
  · intro h e vb va
    refine ⟨h (Sum.inl e) vb va, ?_⟩
    have h2 : R (P.src e) * blockSlice (P.Y e)ᴴ va vb = blockSlice (P.Y e)ᴴ va vb * R (P.tgt e) :=
      h (Sum.inr e) va vb
    rwa [blockSlice_conjTranspose] at h2

end AdjointClosedQuiver

/-! ### Independence of the coefficient basis -/

section BasisIndependence

variable {Kb Ka Nb Na : Type*} [Fintype Kb] [Fintype Ka] [DecidableEq Kb] [DecidableEq Ka]

/-- The functional slice of a finite tensor expansion `∑_a D_a ⊗ F_a`. -/
theorem functionalSlice_sum_kronecker {ι : Type*} [Fintype ι] (φ : Matrix Kb Ka ℂ →ₗ[ℂ] ℂ)
    (D : ι → Matrix Kb Ka ℂ) (F : ι → Matrix Nb Na ℂ) :
    functionalSlice φ (∑ a, D a ⊗ₖ F a) = ∑ a, φ (D a) • F a := by
  funext n m
  have h : (fun vb va => (∑ a, D a ⊗ₖ F a) (vb, n) (va, m)) = ∑ a, F a n m • D a := by
    funext vb va
    simp [Matrix.sum_apply, kroneckerMap_apply, mul_comm]
  simp only [functionalSlice]
  rw [h, map_sum]
  simp [Matrix.sum_apply, mul_comm]

/-- **Coefficient-basis independence.**  For an expansion `T = ∑_a D_a ⊗ F_a` in an
arbitrary basis `(D_a)` of `B(K_a, K_b)` (Hilbert–Schmidt orthonormal or not), the span of the
coefficients `F_a` is the intrinsic slice space `{(φ ⊗ id)(T) : φ}`. -/
theorem range_sliceLinearMap_eq_span_of_basis {ι : Type*} [Fintype ι]
    (D : Module.Basis ι ℂ (Matrix Kb Ka ℂ)) (F : ι → Matrix Nb Na ℂ)
    (T : Matrix (Kb × Nb) (Ka × Na) ℂ) (hT : T = ∑ a, D a ⊗ₖ F a) :
    LinearMap.range (sliceLinearMap T) = Submodule.span ℂ (Set.range F) := by
  subst hT
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    rw [sliceLinearMap_apply, functionalSlice_sum_kronecker]
    exact Submodule.sum_mem _ fun a _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    refine ⟨D.coord a, ?_⟩
    rw [sliceLinearMap_apply, functionalSlice_sum_kronecker]
    simp [Module.Basis.coord_apply]

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]

/-- `eq:general-incidence-expansion` in an arbitrary coefficient basis: `𝔅_e = Span{F_{e,a}}`
for `Y_e = ∑_a D_{e,a} ⊗ F_{e,a}` with `(D_{e,a})` any basis of `B(K_{s(e)}, K_{t(e)})`. -/
theorem coefficientSpace_eq_span_of_basis (P : RepresentedJointPacket Λ V M E) (e : E)
    {ι : Type*} [Fintype ι]
    (D : Module.Basis ι ℂ (Matrix (Fin 4 × V (P.tgt e)) (Fin 4 × V (P.src e)) ℂ))
    (F : ι → Matrix (M (P.tgt e)) (M (P.src e)) ℂ) (hY : P.Y e = ∑ a, D a ⊗ₖ F a) :
    P.coefficientSpace e = Submodule.span ℂ (Set.range F) :=
  range_sliceLinearMap_eq_span_of_basis D F (P.Y e) hY

end BasisIndependence

/-! ### `cor:typing-coordinate-canonicality` -/

section MultiplicityUnitary

variable {K N N' : Type*} [Fintype K] [DecidableEq K] [Fintype N] [Fintype N'] [DecidableEq N]
  [DecidableEq N']

omit [Fintype N] [DecidableEq N] in
theorem single_kron_one_mul_apply (T : Matrix (K × N') (K × N) ℂ) (a b i j : K) (n' : N')
    (n : N) :
    ((Matrix.single a b (1 : ℂ) ⊗ₖ (1 : Matrix N' N' ℂ)) * T) (i, n') (j, n) =
      if i = a then T (b, n') (j, n) else 0 := by
  rw [Matrix.mul_apply, Fintype.sum_prod_type]
  simp only [kroneckerMap_apply, Matrix.single_apply, Matrix.one_apply]
  by_cases hi : i = a
  · subst hi
    simp [Finset.sum_ite_eq]
  · simp [hi, Ne.symm hi]

omit [Fintype N'] [DecidableEq N'] in
theorem mul_single_kron_one_apply (T : Matrix (K × N') (K × N) ℂ) (a b i j : K) (n' : N')
    (n : N) :
    (T * (Matrix.single a b (1 : ℂ) ⊗ₖ (1 : Matrix N N ℂ))) (i, n') (j, n) =
      if j = b then T (i, n') (a, n) else 0 := by
  rw [Matrix.mul_apply, Fintype.sum_prod_type]
  simp only [kroneckerMap_apply, Matrix.single_apply, Matrix.one_apply]
  by_cases hj : j = b
  · subst hj
    simp [Finset.sum_ite_eq]
  · simp [hj, Ne.symm hj]

/-- **Rectangular factor obstruction.**  An operator `T : ℂ^K ⊗ ℂ^N → ℂ^K ⊗ ℂ^{N'}`
intertwining the two copies `g ⊗ I` of the full factor `M_K(ℂ)` is `I_K ⊗ W`. -/
theorem rect_left_factor_commutant [Nonempty K] (T : Matrix (K × N') (K × N) ℂ)
    (hT : ∀ g : Matrix K K ℂ,
      (g ⊗ₖ (1 : Matrix N' N' ℂ)) * T = T * (g ⊗ₖ (1 : Matrix N N ℂ))) :
    ∃ W : Matrix N' N ℂ, T = (1 : Matrix K K ℂ) ⊗ₖ W := by
  obtain ⟨k0⟩ := (inferInstance : Nonempty K)
  refine ⟨Matrix.of fun n' n => T (k0, n') (k0, n), ?_⟩
  ext ⟨i, n'⟩ ⟨j, n⟩
  rw [kroneckerMap_apply, Matrix.one_apply, Matrix.of_apply]
  by_cases hij : i = j
  · subst hij
    have h := congrFun (congrFun (hT (Matrix.single i k0 1)) (i, n')) (k0, n)
    rw [single_kron_one_mul_apply, mul_single_kron_one_apply] at h
    simp only [ite_true] at h
    rw [_root_.if_pos rfl, one_mul, h]
  · have h := congrFun (congrFun (hT (Matrix.single i i 1)) (i, n')) (j, n)
    rw [single_kron_one_mul_apply, mul_single_kron_one_apply] at h
    simp only [ite_true, Ne.symm hij, ite_false] at h
    rw [_root_.if_neg hij, zero_mul, h]

/-- **Uniqueness of Wedderburn coordinates up to multiplicity unitaries**
(`cor:typing-coordinate-canonicality`, first clause, on one central block `z_λ ℋ`).  Two unitary
identifications `U : K ⊗ M → z_λℋ`, `U' : K ⊗ M' → z_λℋ` realizing the same represented action
`x ↦ U (x ⊗ I) U^*` of `B(K_λ)` differ by a unique unitary `W : M → M'`:
`U = U' (I_K ⊗ W)`. -/
theorem multiplicity_unitary_of_same_action {Z : Type*} [Fintype Z] [DecidableEq Z]
    [Nonempty K] (U : Matrix Z (K × N) ℂ) (U' : Matrix Z (K × N') ℂ)
    (hU1 : Uᴴ * U = 1) (hU2 : U * Uᴴ = 1) (hU'1 : U'ᴴ * U' = 1) (hU'2 : U' * U'ᴴ = 1)
    (hsame : ∀ x : Matrix K K ℂ,
      U * (x ⊗ₖ (1 : Matrix N N ℂ)) * Uᴴ = U' * (x ⊗ₖ (1 : Matrix N' N' ℂ)) * U'ᴴ) :
    ∃! W : Matrix N' N ℂ, Wᴴ * W = 1 ∧ W * Wᴴ = 1 ∧
      U = U' * ((1 : Matrix K K ℂ) ⊗ₖ W) := by
  have hc : ∀ x : Matrix K K ℂ, (x ⊗ₖ (1 : Matrix N' N' ℂ)) * (U'ᴴ * U) =
      (U'ᴴ * U) * (x ⊗ₖ (1 : Matrix N N ℂ)) := by
    intro x
    calc (x ⊗ₖ (1 : Matrix N' N' ℂ)) * (U'ᴴ * U)
        = (U'ᴴ * U') * (x ⊗ₖ (1 : Matrix N' N' ℂ)) * (U'ᴴ * U) := by
          rw [hU'1, Matrix.one_mul]
      _ = U'ᴴ * (U' * (x ⊗ₖ (1 : Matrix N' N' ℂ)) * U'ᴴ) * U := by
          simp only [Matrix.mul_assoc]
      _ = U'ᴴ * (U * (x ⊗ₖ (1 : Matrix N N ℂ)) * Uᴴ) * U := by rw [hsame x]
      _ = (U'ᴴ * U) * (x ⊗ₖ (1 : Matrix N N ℂ)) * (Uᴴ * U) := by
          simp only [Matrix.mul_assoc]
      _ = (U'ᴴ * U) * (x ⊗ₖ (1 : Matrix N N ℂ)) := by rw [hU1, Matrix.mul_one]
  obtain ⟨W, hW⟩ := rect_left_factor_commutant (U'ᴴ * U) hc
  have hone : (1 : Matrix K K ℂ) ≠ 0 := one_ne_zero
  have hUW : U = U' * ((1 : Matrix K K ℂ) ⊗ₖ W) := by
    rw [← hW, ← Matrix.mul_assoc, hU'2, Matrix.one_mul]
  refine ⟨W, ⟨?_, ?_, hUW⟩, ?_⟩
  · have h : ((1 : Matrix K K ℂ) ⊗ₖ W)ᴴ * ((1 : Matrix K K ℂ) ⊗ₖ W) = 1 := by
      rw [← hW, conjTranspose_mul, conjTranspose_conjTranspose]
      calc Uᴴ * U' * (U'ᴴ * U) = Uᴴ * (U' * U'ᴴ) * U := by simp only [Matrix.mul_assoc]
        _ = 1 := by rw [hU'2, Matrix.mul_one, hU1]
    rw [conjTranspose_kronecker, conjTranspose_one, ← Matrix.mul_kronecker_mul, Matrix.one_mul,
      ← Matrix.one_kronecker_one] at h
    exact GraphLoadedEdgeCommutant.kronecker_left_cancel hone h
  · have h : ((1 : Matrix K K ℂ) ⊗ₖ W) * ((1 : Matrix K K ℂ) ⊗ₖ W)ᴴ = 1 := by
      rw [← hW, conjTranspose_mul, conjTranspose_conjTranspose]
      calc U'ᴴ * U * (Uᴴ * U') = U'ᴴ * (U * Uᴴ) * U' := by simp only [Matrix.mul_assoc]
        _ = 1 := by rw [hU2, Matrix.mul_one, hU'1]
    rw [conjTranspose_kronecker, conjTranspose_one, ← Matrix.mul_kronecker_mul, Matrix.one_mul,
      ← Matrix.one_kronecker_one] at h
    exact GraphLoadedEdgeCommutant.kronecker_left_cancel hone h
  · rintro W' ⟨-, -, hW'⟩
    have h : (1 : Matrix K K ℂ) ⊗ₖ W' = (1 : Matrix K K ℂ) ⊗ₖ W := by
      rw [← hW, hW', ← Matrix.mul_assoc, hU'1, Matrix.one_mul]
    exact GraphLoadedEdgeCommutant.kronecker_left_cancel hone h

/-- In the new coordinates `U' = U (I ⊗ W)^*` a physical incidence `𝐘 : z_λℋ → z_μℋ` has the
coordinate expression `(I ⊗ W_μ) (U_μ^* 𝐘 U_λ) (I ⊗ W_λ)^*`. -/
theorem incidence_coordinates_change {Ks Kt Ns Nt Ns' Nt' Zs Zt : Type*}
    [Fintype Ks] [Fintype Kt] [DecidableEq Ks] [DecidableEq Kt] [Fintype Ns] [Fintype Nt]
    [Fintype Ns'] [Fintype Nt'] [DecidableEq Ns'] [DecidableEq Nt'] [Fintype Zs] [Fintype Zt]
    (Us : Matrix Zs (Ks × Ns) ℂ) (Us' : Matrix Zs (Ks × Ns') ℂ)
    (Ut : Matrix Zt (Kt × Nt) ℂ) (Ut' : Matrix Zt (Kt × Nt') ℂ)
    (Ws : Matrix Ns' Ns ℂ) (Wt : Matrix Nt' Nt ℂ)
    (hWs : Ws * Wsᴴ = 1) (hWt : Wt * Wtᴴ = 1)
    (hs : Us = Us' * ((1 : Matrix Ks Ks ℂ) ⊗ₖ Ws)) (ht : Ut = Ut' * ((1 : Matrix Kt Kt ℂ) ⊗ₖ Wt))
    (Y : Matrix Zt Zs ℂ) :
    Ut'ᴴ * Y * Us' =
      ((1 : Matrix Kt Kt ℂ) ⊗ₖ Wt) * (Utᴴ * Y * Us) * ((1 : Matrix Ks Ks ℂ) ⊗ₖ Ws)ᴴ := by
  have hs' : Us' = Us * ((1 : Matrix Ks Ks ℂ) ⊗ₖ Ws)ᴴ := by
    rw [hs, Matrix.mul_assoc, conjTranspose_kronecker, conjTranspose_one,
      ← Matrix.mul_kronecker_mul, Matrix.one_mul, hWs, Matrix.one_kronecker_one, Matrix.mul_one]
  have ht' : Ut'ᴴ = ((1 : Matrix Kt Kt ℂ) ⊗ₖ Wt) * Utᴴ := by
    have : Ut' = Ut * ((1 : Matrix Kt Kt ℂ) ⊗ₖ Wt)ᴴ := by
      rw [ht, Matrix.mul_assoc, conjTranspose_kronecker, conjTranspose_one,
        ← Matrix.mul_kronecker_mul, Matrix.one_mul, hWt, Matrix.one_kronecker_one, Matrix.mul_one]
    rw [this, conjTranspose_mul, conjTranspose_conjTranspose]
  rw [hs', ht']
  simp only [Matrix.mul_assoc]

end MultiplicityUnitary

section Transport

/-- Coefficient blocks of `(I ⊗ A) T (I ⊗ C)`. -/
theorem blockSlice_sandwich {Kb Ka Nb Na Nb' Na' : Type*} [Fintype Kb] [Fintype Ka]
    [Fintype Nb] [Fintype Na] [Fintype Nb'] [DecidableEq Kb] [DecidableEq Ka]
    (A : Matrix Nb' Nb ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ) (C : Matrix Na Na' ℂ)
    (vb : Kb) (va : Ka) :
    blockSlice (((1 : Matrix Kb Kb ℂ) ⊗ₖ A) * T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ C)) vb va =
      A * blockSlice T vb va * C := by
  rw [blockSlice_mul_one_kron, blockSlice_one_kron_mul]

theorem conjTranspose_sandwich {a b c d : Type*} [Fintype b] [Fintype c]
    (A : Matrix a b ℂ) (B : Matrix b c ℂ) (C : Matrix d c ℂ) :
    (A * B * Cᴴ)ᴴ = C * Bᴴ * Aᴴ := by
  rw [conjTranspose_mul, conjTranspose_mul, conjTranspose_conjTranspose, Matrix.mul_assoc]

/-- The sandwich map `B ↦ A B C` as a linear map. -/
def sandwichLinearMap {Nb Na Nb' Na' : Type*} [Fintype Nb] [Fintype Na]
    (A : Matrix Nb' Nb ℂ) (C : Matrix Na Na' ℂ) : Matrix Nb Na ℂ →ₗ[ℂ] Matrix Nb' Na' ℂ where
  toFun B := A * B * C
  map_add' B B' := by rw [Matrix.mul_add, Matrix.add_mul]
  map_smul' c B := by rw [Matrix.mul_smul, Matrix.smul_mul]; rfl

/-- Conjugating an intertwining relation by unitaries. -/
theorem conj_intertwine_iff {N N' Q Q' : Type*} [Fintype N] [Fintype N'] [Fintype Q]
    [Fintype Q'] [DecidableEq N] [DecidableEq Q]
    (A : Matrix N' N ℂ) (C : Matrix Q' Q ℂ) (hA : Aᴴ * A = 1) (hC : Cᴴ * C = 1)
    (R : Matrix N N ℂ) (S : Matrix Q Q ℂ) (F : Matrix N Q ℂ) :
    (A * R * Aᴴ) * (A * F * Cᴴ) = (A * F * Cᴴ) * (C * S * Cᴴ) ↔ R * F = F * S := by
  have hl : (A * R * Aᴴ) * (A * F * Cᴴ) = A * (R * F) * Cᴴ := by
    calc (A * R * Aᴴ) * (A * F * Cᴴ) = A * R * (Aᴴ * A) * F * Cᴴ := by
          simp only [Matrix.mul_assoc]
      _ = A * (R * F) * Cᴴ := by rw [hA, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  have hr : (A * F * Cᴴ) * (C * S * Cᴴ) = A * (F * S) * Cᴴ := by
    calc (A * F * Cᴴ) * (C * S * Cᴴ) = A * F * (Cᴴ * C) * S * Cᴴ := by
          simp only [Matrix.mul_assoc]
      _ = A * (F * S) * Cᴴ := by rw [hC, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  rw [hl, hr]
  constructor
  · intro h
    calc R * F = (Aᴴ * A) * (R * F) * (Cᴴ * C) := by rw [hA, hC, Matrix.one_mul, Matrix.mul_one]
      _ = Aᴴ * (A * (R * F) * Cᴴ) * C := by simp only [Matrix.mul_assoc]
      _ = Aᴴ * (A * (F * S) * Cᴴ) * C := by rw [h]
      _ = (Aᴴ * A) * (F * S) * (Cᴴ * C) := by simp only [Matrix.mul_assoc]
      _ = F * S := by rw [hA, hC, Matrix.one_mul, Matrix.mul_one]
  · intro h
    rw [h]

/-- A rectangular unitary transports commutants: `(W S W^*)' = W S' W^*`. -/
theorem matCommutant_unitary_image {n n' : Type*} [Fintype n] [DecidableEq n] [Fintype n']
    [DecidableEq n'] (W : Matrix n' n ℂ) (h1 : Wᴴ * W = 1) (h2 : W * Wᴴ = 1)
    (S : Set (Matrix n n ℂ)) :
    matCommutant ((fun x => W * x * Wᴴ) '' S) = (fun x => W * x * Wᴴ) '' matCommutant S := by
  ext T
  constructor
  · intro hT
    refine ⟨Wᴴ * T * W, fun a ha => ?_, ?_⟩
    · have h := hT _ ⟨a, ha, rfl⟩
      calc Wᴴ * T * W * a = Wᴴ * T * W * a * (Wᴴ * W) := by rw [h1, Matrix.mul_one]
        _ = Wᴴ * (T * (W * a * Wᴴ)) * W := by simp only [Matrix.mul_assoc]
        _ = Wᴴ * ((W * a * Wᴴ) * T) * W := by rw [h]
        _ = (Wᴴ * W) * a * (Wᴴ * T * W) := by simp only [Matrix.mul_assoc]
        _ = a * (Wᴴ * T * W) := by rw [h1, Matrix.one_mul]
    · calc W * (Wᴴ * T * W) * Wᴴ = (W * Wᴴ) * T * (W * Wᴴ) := by simp only [Matrix.mul_assoc]
        _ = T := by rw [h2, Matrix.one_mul, Matrix.mul_one]
  · rintro ⟨T', hT', rfl⟩ _ ⟨a, ha, rfl⟩
    have h := hT' a ha
    calc W * T' * Wᴴ * (W * a * Wᴴ) = W * (T' * (Wᴴ * W) * a) * Wᴴ := by
          simp only [Matrix.mul_assoc]
      _ = W * (T' * a) * Wᴴ := by rw [h1, Matrix.mul_one]
      _ = W * (a * T') * Wᴴ := by rw [h]
      _ = W * (a * (Wᴴ * W) * T') * Wᴴ := by rw [h1, Matrix.mul_one]
      _ = W * a * Wᴴ * (W * T' * Wᴴ) := by simp only [Matrix.mul_assoc]

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M M' : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] [∀ l, Fintype (M' l)] [∀ l, DecidableEq (M' l)]
  {E : Type*} [Fintype E]

/-- The same packet in new Wedderburn coordinates `M_λ → M'_λ` given by multiplicity unitaries
`W_λ`: the incidences become `(I ⊗ W_{t(e)}) Y_e (I ⊗ W_{s(e)})^*`
(`incidence_coordinates_change`). -/
def transportPacket (P : RepresentedJointPacket Λ V M E) (W : ∀ l, Matrix (M' l) (M l) ℂ) :
    RepresentedJointPacket Λ V M' E where
  src := P.src
  tgt := P.tgt
  Y e := ((1 : Matrix (Fin 4 × V (P.tgt e)) (Fin 4 × V (P.tgt e)) ℂ) ⊗ₖ W (P.tgt e)) * P.Y e *
    ((1 : Matrix (Fin 4 × V (P.src e)) (Fin 4 × V (P.src e)) ℂ) ⊗ₖ (W (P.src e))ᴴ)

/-- **`𝔅̃_e = W_μ 𝔅_e W_λ^*`** (`cor:typing-coordinate-canonicality`). -/
theorem coefficientSpace_transport (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (e : E) :
    (transportPacket P W).coefficientSpace e =
      (P.coefficientSpace e).map (sandwichLinearMap (W (P.tgt e)) (W (P.src e))ᴴ) := by
  rw [RepresentedJointPacket.coefficientSpace_eq_span_blockSlice,
    RepresentedJointPacket.coefficientSpace_eq_span_blockSlice, Submodule.map_span,
    ← Set.range_comp]
  congr 1
  congr 1
  funext a
  exact blockSlice_sandwich _ _ _ a.1 a.2

/-- Blockwise conjugation `(R_λ) ↦ (W_λ R_λ W_λ^*)`. -/
def conjFamily (W : ∀ l, Matrix (M' l) (M l) ℂ) (R : ∀ l, Matrix (M l) (M l) ℂ) :
    ∀ l, Matrix (M' l) (M' l) ℂ :=
  fun l => W l * R l * (W l)ᴴ

/-- Membership in `𝓜_type` is invariant under a change of Wedderburn coordinates. -/
theorem mem_typedMultiplicity_transport_iff (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (hW1 : ∀ l, (W l)ᴴ * W l = 1)
    (R : ∀ l, Matrix (M l) (M l) ℂ) :
    conjFamily W R ∈ (transportPacket P W).typedMultiplicityAlgebra ↔
      R ∈ P.typedMultiplicityAlgebra := by
  rw [RepresentedJointPacket.mem_typedMultiplicityAlgebra,
    RepresentedJointPacket.mem_typedMultiplicityAlgebra,
    RepresentedJointPacket.isTypedMultiplicity_iff_blockSlice,
    RepresentedJointPacket.isTypedMultiplicity_iff_blockSlice]
  refine forall_congr' fun e => forall_congr' fun vb => forall_congr' fun va => ?_
  have hslice : blockSlice ((transportPacket P W).Y e) vb va =
      W (P.tgt e) * blockSlice (P.Y e) vb va * (W (P.src e))ᴴ := by
    exact blockSlice_sandwich _ _ _ vb va
  have hsliceH : (blockSlice ((transportPacket P W).Y e) vb va)ᴴ =
      W (P.src e) * (blockSlice (P.Y e) vb va)ᴴ * (W (P.tgt e))ᴴ := by
    rw [hslice]
    exact conjTranspose_sandwich _ _ _
  rw [hsliceH, hslice]
  unfold conjFamily
  exact and_congr (conj_intertwine_iff _ _ (hW1 _) (hW1 _) _ _ _)
    (conj_intertwine_iff _ _ (hW1 _) (hW1 _) _ _ _)

/-- **`𝓜̃_type = W 𝓜_type W^*`** (`eq:typing-coordinate-canonicality`, family form). -/
theorem typedMultiplicity_transport (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (hW1 : ∀ l, (W l)ᴴ * W l = 1)
    (hW2 : ∀ l, W l * (W l)ᴴ = 1) :
    ((transportPacket P W).typedMultiplicityAlgebra : Set (∀ l, Matrix (M' l) (M' l) ℂ)) =
      conjFamily W '' (P.typedMultiplicityAlgebra : Set (∀ l, Matrix (M l) (M l) ℂ)) := by
  ext R'
  constructor
  · intro hR'
    refine ⟨fun l => (W l)ᴴ * R' l * W l, ?_, ?_⟩
    · have hback : conjFamily W (fun l => (W l)ᴴ * R' l * W l) = R' := by
        funext l
        unfold conjFamily
        calc W l * ((W l)ᴴ * R' l * W l) * (W l)ᴴ = (W l * (W l)ᴴ) * R' l * (W l * (W l)ᴴ) := by
              simp only [Matrix.mul_assoc]
          _ = R' l := by rw [hW2, Matrix.one_mul, Matrix.mul_one]
      rw [SetLike.mem_coe, ← mem_typedMultiplicity_transport_iff P W hW1, hback]
      exact hR'
    · funext l
      unfold conjFamily
      calc W l * ((W l)ᴴ * R' l * W l) * (W l)ᴴ = (W l * (W l)ᴴ) * R' l * (W l * (W l)ᴴ) := by
            simp only [Matrix.mul_assoc]
        _ = R' l := by rw [hW2, Matrix.one_mul, Matrix.mul_one]
  · rintro ⟨R, hR, rfl⟩
    exact (mem_typedMultiplicity_transport_iff P W hW1 R).mpr hR

/-- The total multiplicity unitary `W = ⊕_λ W_λ : 𝓜 → 𝓜'`. -/
abbrev totalUnitary (W : ∀ l, Matrix (M' l) (M l) ℂ) :
    Matrix (TotalCarrier M') (TotalCarrier M) ℂ :=
  blockDiagonal' W

theorem totalUnitary_conjTranspose_mul (W : ∀ l, Matrix (M' l) (M l) ℂ)
    (hW1 : ∀ l, (W l)ᴴ * W l = 1) : (totalUnitary W)ᴴ * totalUnitary W = 1 := by
  rw [totalUnitary, blockDiagonal'_conjTranspose, ← blockDiagonal'_mul, ← blockDiagonal'_one]
  congr 1
  funext l
  exact hW1 l

theorem totalUnitary_mul_conjTranspose (W : ∀ l, Matrix (M' l) (M l) ℂ)
    (hW2 : ∀ l, W l * (W l)ᴴ = 1) : totalUnitary W * (totalUnitary W)ᴴ = 1 := by
  rw [totalUnitary, blockDiagonal'_conjTranspose, ← blockDiagonal'_mul, ← blockDiagonal'_one]
  congr 1
  funext l
  exact hW2 l

/-- **`𝓜̃_type = W 𝓜_type W^*` on `𝓜`** (`eq:typing-coordinate-canonicality`). -/
theorem coefficientCarrierAlgebra_transport (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (hW1 : ∀ l, (W l)ᴴ * W l = 1)
    (hW2 : ∀ l, W l * (W l)ᴴ = 1) :
    coefficientCarrierAlgebra (transportPacket P W) =
      (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) '' coefficientCarrierAlgebra P := by
  unfold coefficientCarrierAlgebra
  rw [typedMultiplicity_transport P W hW1 hW2, Set.image_image, Set.image_image]
  congr 1
  funext R
  rw [totalUnitary, blockDiagonal'_conjTranspose, ← blockDiagonal'_mul, ← blockDiagonal'_mul]
  rfl

/-- **`𝒪̃_Y = W 𝒪_Y W^*`** (`eq:typing-coordinate-canonicality`). -/
theorem coefficientActionAlgebra_transport (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (hW1 : ∀ l, (W l)ᴴ * W l = 1)
    (hW2 : ∀ l, W l * (W l)ᴴ = 1) :
    (((transportPacket P W).coefficientActionAlgebra : StarSubalgebra ℂ _) :
        Set (Matrix (TotalCarrier M') (TotalCarrier M') ℂ)) =
      (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) ''
        ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
          Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) := by
  rw [← coefficientCarrierAlgebra_commutant (transportPacket P W),
    ← coefficientCarrierAlgebra_commutant P, coefficientCarrierAlgebra_transport P W hW1 hW2,
    matCommutant_unitary_image _ (totalUnitary_conjTranspose_mul W hW1)
      (totalUnitary_mul_conjTranspose W hW2)]

/-- **Canonicality under Wedderburn coordinates (`cor:typing-coordinate-canonicality`).**
For multiplicity unitaries `W_λ : M_λ → M'_λ` (the change of coordinates of
`multiplicity_unitary_of_same_action`), with the incidences re-expressed in the new coordinates
(`incidence_coordinates_change`): `𝔅̃_e = W_{t(e)} 𝔅_e W_{s(e)}^*`, `𝒪̃_Y = W 𝒪_Y W^*` and
`𝓜̃_type = W 𝓜_type W^*`. -/
theorem typing_coordinate_canonicality (P : RepresentedJointPacket Λ V M E)
    (W : ∀ l, Matrix (M' l) (M l) ℂ) (hW1 : ∀ l, (W l)ᴴ * W l = 1)
    (hW2 : ∀ l, W l * (W l)ᴴ = 1) :
    (∀ e, (transportPacket P W).coefficientSpace e =
      (P.coefficientSpace e).map (sandwichLinearMap (W (P.tgt e)) (W (P.src e))ᴴ)) ∧
    (((transportPacket P W).coefficientActionAlgebra : StarSubalgebra ℂ _) :
        Set (Matrix (TotalCarrier M') (TotalCarrier M') ℂ)) =
      (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) ''
        ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
          Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) ∧
    coefficientCarrierAlgebra (transportPacket P W) =
      (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) '' coefficientCarrierAlgebra P ∧
    ((transportPacket P W).typedMultiplicityAlgebra : Set (∀ l, Matrix (M' l) (M' l) ℂ)) =
      conjFamily W '' (P.typedMultiplicityAlgebra : Set (∀ l, Matrix (M l) (M l) ℂ)) :=
  ⟨coefficientSpace_transport P W, coefficientActionAlgebra_transport P W hW1 hW2,
    coefficientCarrierAlgebra_transport P W hW1 hW2, typedMultiplicity_transport P W hW1 hW2⟩

end Transport

/-! ### `cor:reciprocal-wedderburn` -/

section Reciprocal

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]
variable (P : RepresentedJointPacket Λ V M E)

/-- **Minimality of `𝒪_Y`.**  `𝒪_Y` contains the vertex projections and every multiplicity
slice, and is contained in every unital star-closed algebra on `𝓜` that does. -/
theorem coefficientActionAlgebra_minimal :
    ((∀ l, vertexProjection M l ∈ P.coefficientActionAlgebra) ∧
      ∀ e, ∀ B ∈ P.coefficientSpace e, blockEmbed M B ∈ P.coefficientActionAlgebra) ∧
    ∀ C : StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ),
      (∀ l, vertexProjection M l ∈ C) → (∀ e, ∀ B ∈ P.coefficientSpace e, blockEmbed M B ∈ C) →
        P.coefficientActionAlgebra ≤ C :=
  ⟨⟨P.vertexProjection_mem_coefficientActionAlgebra,
      fun e _ hB => P.blockEmbed_mem_coefficientActionAlgebra e hB⟩,
    fun C hZ hB => P.coefficientActionAlgebra_le C hZ hB⟩

/-- **Universal property `eq:coefficient-action-universal`** for unital star-closed (i.e.
finite-dimensional `C^*`-) algebras `𝒞` on `𝓜`: `𝒞' = 𝓜_type ⟺ 𝒞 = 𝒪_Y`. -/
theorem coefficientAction_universal
    (C : StarSubalgebra ℂ (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) :
    matCommutant (C : Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) =
        coefficientCarrierAlgebra P ↔ C = P.coefficientActionAlgebra := by
  constructor
  · intro h
    apply SetLike.coe_injective
    rw [← matCommutant_matCommutant_starSubalgebra C, h, coefficientCarrierAlgebra_commutant]
  · rintro rfl
    exact coefficientActionAlgebra_commutant P

/-- **Common centre (`eq:common-centre`)**: `Z(𝒜_act) = Z(𝓜_type) = 𝒜_act ∩ 𝓜_type` on `ℋ`. -/
theorem packet_common_centre_exact :
    matCentre (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
        (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) ∩
          iotaTypedMultiplicity P ∧
      matCentre (iotaTypedMultiplicity P) =
        (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) ∩
          iotaTypedMultiplicity P :=
  let h := common_centre _ _ (actionAlgebra_commutant P) (typedMultiplicity_commutant P)
  ⟨h.1, h.2.1⟩

end Reciprocal

section ReciprocalBlocks

variable {Λ : Type} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]

/-- **Simultaneous reciprocal blocks (`eq:wedderburn-H`, `eq:wedderburn-action`,
`eq:wedderburn-multiplicity`, `eq:common-centre`)** for every represented joint packet: a unitary
`W : ⊕_α H^act_α ⊗ H^mult_α → ℋ` with `W^* 𝒜_act W = ⊕_α B(H^act_α) ⊗ I` and
`W^* ι(𝓜_type) W = ⊕_α I ⊗ B(H^mult_α)`, common central sector projections, and
`Z(𝒜_act) = Z(𝓜_type) = 𝒜_act ∩ 𝓜_type`. -/
theorem packet_reciprocal_blocks (P : RepresentedJointPacket Λ V M E) :
    (∃ (ι : Type) (_ : Fintype ι) (_ : DecidableEq ι) (I J : ι → Type)
      (_ : ∀ b, Fintype (I b)) (_ : ∀ b, DecidableEq (I b))
      (_ : ∀ b, Fintype (J b)) (_ : ∀ b, DecidableEq (J b))
      (W : Matrix (Carrier V M) (Σ b, I b × J b) ℂ),
      Wᴴ * W = 1 ∧ W * Wᴴ = 1 ∧ (∀ b, Nonempty (I b)) ∧ (∀ b, Nonempty (J b)) ∧
      (fun x => Wᴴ * x * W) '' (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
        actionBlockSet I J ∧
      (fun x => Wᴴ * x * W) '' iotaTypedMultiplicity P = multBlockSet I J ∧
      (∀ b, sectorProjection I J b ∈ actionBlockSet I J ∧
        sectorProjection I J b ∈ multBlockSet I J ∧
        sectorProjection I J b ∈ matCentre (actionBlockSet I J) ∧
        sectorProjection I J b ∈ matCentre (multBlockSet I J))) ∧
    matCentre (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
      (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) ∩ iotaTypedMultiplicity P ∧
    matCentre (iotaTypedMultiplicity P) =
      (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) ∩
        iotaTypedMultiplicity P := by
  obtain ⟨ι, _, _, I, J, _, _, _, _, W, hW1, hW2, hNI, hNJ, hA, hM⟩ :=
    reciprocal_wedderburn P.actionAlgebra P.actionAlgebra_starClosed
  refine ⟨⟨ι, inferInstance, inferInstance, I, J, inferInstance, inferInstance, inferInstance,
    inferInstance, W, hW1, hW2, hNI, hNJ, hA, ?_, ?_⟩, (packet_common_centre_exact P).1,
    (packet_common_centre_exact P).2⟩
  · rw [← actionAlgebra_commutant P]
    exact hM
  · intro b
    obtain ⟨h1, h2⟩ := sectorProjection_mem (I := I) (J := J) b
    refine ⟨h1, h2, ⟨h1, ?_⟩, ⟨h2, ?_⟩⟩
    · rw [matCommutant_actionBlockSet]
      exact h2
    · rw [matCommutant_multBlockSet]
      exact h1

end ReciprocalBlocks

/-! ### The assembled theorem -/

section Assembly

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
variable {V M : Λ → Type*} [∀ l, Fintype (V l)] [∀ l, DecidableEq (V l)]
  [∀ l, Fintype (M l)] [∀ l, DecidableEq (M l)] {E : Type*} [Fintype E]

/-- **Arbitrary-incidence action–multiplicity reconstruction (`thm:main-duality`).**  For every
finite represented joint packet, with no restriction on the operator-Schmidt rank of its
incidences (rectangular, singular, rank-deficient and zero incidences included):

* `𝒜_act'_ℋ = ι(𝓜_type)` and `ι(𝓜_type)'_ℋ = 𝒜_act` (`eq:main-duality`);
* `𝒪_Y'_𝓜 = 𝓜_type` and `𝓜_type'_𝓜 = 𝒪_Y` (`eq:coefficient-quiver-duality`);
* the coefficient spaces, hence both algebras, are independent of the coefficient basis:
  `𝔅_e = Span{F_{e,a}}` for `Y_e = ∑_a D_{e,a} ⊗ F_{e,a}` in any basis `(D_{e,a})`;
* a change of Wedderburn coordinates by multiplicity unitaries `W_λ` transports `𝒪_Y` and
  `𝓜_type` by `W = ⊕_λ W_λ` (`typing_coordinate_canonicality`).

`𝓜_type = End 𝔔_Y` for the adjoint-closed coefficient quiver is
`typedMultiplicity_iff_quiverEnd`. -/
theorem arbitrary_incidence_main_duality (P : RepresentedJointPacket Λ V M E) :
    matCommutant (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) =
        iotaTypedMultiplicity P ∧
    matCommutant (iotaTypedMultiplicity P) =
        (P.actionAlgebra : Set (Matrix (Carrier V M) (Carrier V M) ℂ)) ∧
    matCommutant ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
        Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) = coefficientCarrierAlgebra P ∧
    matCommutant (coefficientCarrierAlgebra P) =
        ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
          Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) ∧
    (∀ (e : E) {ι : Type} [Fintype ι]
      (D : Module.Basis ι ℂ (Matrix (Fin 4 × V (P.tgt e)) (Fin 4 × V (P.src e)) ℂ))
      (F : ι → Matrix (M (P.tgt e)) (M (P.src e)) ℂ), P.Y e = ∑ a, D a ⊗ₖ F a →
        P.coefficientSpace e = Submodule.span ℂ (Set.range F)) ∧
    (∀ {M' : Λ → Type*} [∀ l, Fintype (M' l)] [∀ l, DecidableEq (M' l)]
      (W : ∀ l, Matrix (M' l) (M l) ℂ), (∀ l, (W l)ᴴ * W l = 1) → (∀ l, W l * (W l)ᴴ = 1) →
      (((transportPacket P W).coefficientActionAlgebra : StarSubalgebra ℂ _) :
          Set (Matrix (TotalCarrier M') (TotalCarrier M') ℂ)) =
        (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) ''
          ((P.coefficientActionAlgebra : StarSubalgebra ℂ _) :
            Set (Matrix (TotalCarrier M) (TotalCarrier M) ℂ)) ∧
      coefficientCarrierAlgebra (transportPacket P W) =
        (fun X => totalUnitary W * X * (totalUnitary W)ᴴ) '' coefficientCarrierAlgebra P) :=
  ⟨actionAlgebra_commutant P, typedMultiplicity_commutant P,
    coefficientActionAlgebra_commutant P, coefficientCarrierAlgebra_commutant P,
    fun e _ _ D F hY => coefficientSpace_eq_span_of_basis P e D F hY,
    fun W hW1 hW2 => ⟨coefficientActionAlgebra_transport P W hW1 hW2,
      coefficientCarrierAlgebra_transport P W hW1 hW2⟩⟩

end Assembly

end ArbitraryIncidenceDuality
end RenewalGeometry
