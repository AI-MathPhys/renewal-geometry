import Mathlib

/-!
# The `*`-subalgebra of a matrix algebra generated by a set

Split out of `MathPhys.Commutant.JointTypedActionAlgebra` (`def:action-algebra` of the
spacetime–gauge duality paper); finite-dimensional `C^*`-algebra generation.

* `starAdjoin`: the unital `*`-subalgebra of `Matrix n n ℂ` generated by a set,
  i.e. the finite-dimensional `C^*(S)`, together with its universal property.
* `jointActionAlgebra`: `C^*(A_ext, A_int, Y_e, Y_e^* : e ∈ E)` generated by two sets of
  matrices and a family of generators, star-closed and minimal.
-/

open Matrix

namespace MathPhys

variable {n : Type*} [Fintype n] [DecidableEq n]

/-! ### The finite-dimensional `C^*`-algebra generated by a set -/

/-- The unital `*`-subalgebra of `Matrix n n ℂ` generated by `S`: in finite
dimension this is the `C^*`-algebra `C^*(S)`. -/
def starAdjoin (S : Set (Matrix n n ℂ)) : Subalgebra ℂ (Matrix n n ℂ) :=
  (StarAlgebra.adjoin ℂ S).toSubalgebra

theorem starAdjoin_eq_adjoin (S : Set (Matrix n n ℂ)) :
    starAdjoin S = Algebra.adjoin ℂ (S ∪ star S) := rfl

theorem subset_starAdjoin (S : Set (Matrix n n ℂ)) : S ⊆ starAdjoin S :=
  StarAlgebra.subset_adjoin ℂ S

theorem mem_starAdjoin_of_mem {S : Set (Matrix n n ℂ)} {a : Matrix n n ℂ} (ha : a ∈ S) :
    a ∈ starAdjoin S :=
  subset_starAdjoin S ha

/-- `C^*(S)` is closed under the adjoint. -/
theorem starAdjoin_starClosed (S : Set (Matrix n n ℂ)) :
    ∀ a ∈ starAdjoin S, aᴴ ∈ starAdjoin S := by
  intro a ha
  rw [← Matrix.star_eq_conjTranspose]
  have ha' : a ∈ StarAlgebra.adjoin ℂ S := ha
  exact (StarAlgebra.adjoin ℂ S).star_mem' ha'

theorem conjTranspose_mem_starAdjoin {S : Set (Matrix n n ℂ)} {a : Matrix n n ℂ}
    (ha : a ∈ S) : aᴴ ∈ starAdjoin S :=
  starAdjoin_starClosed S a (mem_starAdjoin_of_mem ha)

/-- Universal property: `C^*(S)` is the least star-closed unital subalgebra containing `S`. -/
theorem starAdjoin_le {S : Set (Matrix n n ℂ)} {B : Subalgebra ℂ (Matrix n n ℂ)}
    (hB : ∀ a ∈ B, aᴴ ∈ B) (hS : S ⊆ B) : starAdjoin S ≤ B := by
  rw [starAdjoin_eq_adjoin]
  refine Algebra.adjoin_le ?_
  rintro a (ha | ha)
  · exact hS ha
  · have ha' : star a ∈ S := Set.mem_star.mp ha
    rw [← star_star a, Matrix.star_eq_conjTranspose]
    exact hB _ (hS ha')

theorem starAdjoin_mono {S T : Set (Matrix n n ℂ)} (h : S ⊆ T) : starAdjoin S ≤ starAdjoin T :=
  starAdjoin_le (starAdjoin_starClosed T) (h.trans (subset_starAdjoin T))

/-! ### `def:action-algebra` -/

/-- **Joint typed action algebra (`def:action-algebra`).**  For a joint packet with the
external Clifford algebra `Aext`, the commuting internal algebra `Aint` and the represented
incidence histories `Y e` (extended by zero to the common finite carrier), the algebra
`𝒜_act = C^*(A_ext, A_int, Y_e, Y_e^* : e ∈ E)`. -/
def jointActionAlgebra (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) : Subalgebra ℂ (Matrix n n ℂ) :=
  starAdjoin (Aext ∪ Aint ∪ Set.range Y)

theorem ext_subset_jointActionAlgebra (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) : Aext ⊆ jointActionAlgebra Aext Aint Y :=
  fun _ ha => mem_starAdjoin_of_mem (Or.inl (Or.inl ha))

theorem int_subset_jointActionAlgebra (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) : Aint ⊆ jointActionAlgebra Aext Aint Y :=
  fun _ ha => mem_starAdjoin_of_mem (Or.inl (Or.inr ha))

theorem incidence_mem_jointActionAlgebra (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) (e : E) : Y e ∈ jointActionAlgebra Aext Aint Y :=
  mem_starAdjoin_of_mem (Or.inr ⟨e, rfl⟩)

/-- The adjoint incidence generators `Y_e^*` lie in the joint action algebra. -/
theorem incidence_conjTranspose_mem_jointActionAlgebra (Aext Aint : Set (Matrix n n ℂ))
    {E : Type*} (Y : E → Matrix n n ℂ) (e : E) :
    (Y e)ᴴ ∈ jointActionAlgebra Aext Aint Y :=
  conjTranspose_mem_starAdjoin (Or.inr ⟨e, rfl⟩)

/-- The joint action algebra is star-closed, so it satisfies the `action_starClosed`
requirement of `SourceCompleteJointDualityPacket`. -/
theorem jointActionAlgebra_starClosed (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) :
    ∀ a ∈ jointActionAlgebra Aext Aint Y, aᴴ ∈ jointActionAlgebra Aext Aint Y :=
  starAdjoin_starClosed _

/-- Minimality: the joint action algebra is contained in every star-closed unital
subalgebra containing `A_ext`, `A_int` and the incidence histories.  Together with the
membership lemmas this characterises it as `C^*(A_ext, A_int, Y_e, Y_e^*)`. -/
theorem jointActionAlgebra_le (Aext Aint : Set (Matrix n n ℂ)) {E : Type*}
    (Y : E → Matrix n n ℂ) {B : Subalgebra ℂ (Matrix n n ℂ)} (hB : ∀ a ∈ B, aᴴ ∈ B)
    (hext : Aext ⊆ B) (hint : Aint ⊆ B) (hY : ∀ e, Y e ∈ B) :
    jointActionAlgebra Aext Aint Y ≤ B := by
  refine starAdjoin_le hB ?_
  rintro a ((ha | ha) | ⟨e, rfl⟩)
  · exact hext ha
  · exact hint ha
  · exact hY e

end MathPhys
