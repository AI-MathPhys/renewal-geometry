import Mathlib
import MathPhys.NCG.OperatorAlgebras.Bicommutant
import MathPhys.NCG.OperatorAlgebras.HilbertSchmidtSlices

/-!
# Commutants of generated star algebras and of `I ⊗ R`

Split out of `MathPhys.Commutant.ArbitraryIncidenceDualityExact` (its generic lemmas):

* `mem_matCommutant_starAdjoin_iff`: the commutant of the star algebra generated by an
  arbitrary set consists of the matrices commuting with every generator and its adjoint;
* `one_kron_commute_iff_blockSlice`: `(I ⊗ R_b) T = T (I ⊗ R_a)` iff every Hilbert–Schmidt
  coefficient block `F` of `T` satisfies `R_b F = F R_a`, with the entry formulas
  `one_kron_mul_apply`, `mul_one_kron_apply` and the block identities
  `blockSlice_one_kron_mul`, `blockSlice_mul_one_kron`, `blockSlice_conjTranspose`.
-/

open Matrix
open scoped Kronecker

namespace MathPhys
namespace ArbitraryIncidenceDuality

open SMSTQuiverCommutantAssembly

set_option linter.unusedSectionVars false

/-! ### Generic lemmas -/

section Generic

/-- The commutant of the star algebra generated by an arbitrary set: commuting with every
generator and every adjoint generator. -/
theorem mem_matCommutant_starAdjoin_iff {n : Type*} [Fintype n] [DecidableEq n]
    (S : Set (Matrix n n ℂ)) (T : Matrix n n ℂ) :
    T ∈ matCommutant ((StarAlgebra.adjoin ℂ S : StarSubalgebra ℂ (Matrix n n ℂ)) :
        Set (Matrix n n ℂ)) ↔
      ∀ a ∈ S, T * a = a * T ∧ T * aᴴ = aᴴ * T := by
  constructor
  · intro hT a ha
    refine ⟨hT a (StarAlgebra.subset_adjoin ℂ S ha), hT _ ?_⟩
    rw [← Matrix.star_eq_conjTranspose]
    exact star_mem (StarAlgebra.subset_adjoin ℂ S ha)
  · intro hT a ha
    suffices h : T * a = a * T ∧ T * aᴴ = aᴴ * T from h.1
    induction ha using StarAlgebra.adjoin_induction with
    | mem x hx => exact hT x hx
    | algebraMap r =>
      refine ⟨(Algebra.commutes r T).symm, ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, conjTranspose_smul, conjTranspose_one, smul_mul_assoc,
        mul_smul_comm, one_mul, mul_one]
    | add x y _ _ hx hy =>
      exact ⟨by rw [mul_add, add_mul, hx.1, hy.1],
        by rw [conjTranspose_add, mul_add, add_mul, hx.2, hy.2]⟩
    | mul x y _ _ hx hy =>
      exact ⟨by rw [← mul_assoc, hx.1, mul_assoc, hy.1, ← mul_assoc],
        by rw [conjTranspose_mul, ← mul_assoc, hy.2, mul_assoc, hx.2, ← mul_assoc]⟩
    | star x _ hx =>
      simp only [Matrix.star_eq_conjTranspose, conjTranspose_conjTranspose]
      exact ⟨hx.2, hx.1⟩

variable {Kb Ka Nb Na : Type*} [Fintype Kb] [Fintype Ka] [Fintype Nb] [Fintype Na]
  [DecidableEq Kb] [DecidableEq Ka]
variable {Nb' Na' : Type*}

/-- Entries of `(I ⊗ R) T` are the entries of `R` times the coefficient blocks of `T`. -/
theorem one_kron_mul_apply (Rb : Matrix Nb' Nb ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (n : Nb') (va : Ka) (m : Na) :
    (((1 : Matrix Kb Kb ℂ) ⊗ₖ Rb) * T) (vb, n) (va, m) = (Rb * blockSlice T vb va) n m := by
  rw [Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type, Finset.sum_eq_single vb]
  · simp only [kroneckerMap_apply, one_apply_eq, one_mul, blockSlice]
  · intro k _ hk
    refine Finset.sum_eq_zero fun n' _ => ?_
    rw [kroneckerMap_apply, one_apply_ne (Ne.symm hk), zero_mul, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- Entries of `T (I ⊗ R)`. -/
theorem mul_one_kron_apply (Ra : Matrix Na Na' ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (n : Nb) (va : Ka) (m : Na') :
    (T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ Ra)) (vb, n) (va, m) = (blockSlice T vb va * Ra) n m := by
  rw [Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type, Finset.sum_eq_single va]
  · simp only [kroneckerMap_apply, one_apply_eq, one_mul, blockSlice]
  · intro k _ hk
    refine Finset.sum_eq_zero fun n' _ => ?_
    rw [kroneckerMap_apply, one_apply_ne hk, zero_mul, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- Coefficient blocks of `(I ⊗ A) T`. -/
theorem blockSlice_one_kron_mul (A : Matrix Nb' Nb ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (va : Ka) :
    blockSlice (((1 : Matrix Kb Kb ℂ) ⊗ₖ A) * T) vb va = A * blockSlice T vb va := by
  ext n m
  exact one_kron_mul_apply A T vb n va m

/-- Coefficient blocks of `T (I ⊗ C)`. -/
theorem blockSlice_mul_one_kron (C : Matrix Na Na' ℂ) (T : Matrix (Kb × Nb) (Ka × Na) ℂ)
    (vb : Kb) (va : Ka) :
    blockSlice (T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ C)) vb va = blockSlice T vb va * C := by
  ext n m
  exact mul_one_kron_apply C T vb n va m

/-- **The coefficient expansion of a commutator.**  `(I ⊗ R_b) T = T (I ⊗ R_a)` iff every
Hilbert–Schmidt coefficient block `F` of `T` satisfies `R_b F = F R_a`.  No rank, support or
invertibility assumption on `T`. -/
theorem one_kron_commute_iff_blockSlice (Rb : Matrix Nb Nb ℂ) (Ra : Matrix Na Na ℂ)
    (T : Matrix (Kb × Nb) (Ka × Na) ℂ) :
    ((1 : Matrix Kb Kb ℂ) ⊗ₖ Rb) * T = T * ((1 : Matrix Ka Ka ℂ) ⊗ₖ Ra) ↔
      ∀ vb va, Rb * blockSlice T vb va = blockSlice T vb va * Ra := by
  constructor
  · intro h vb va
    ext n m
    rw [← one_kron_mul_apply, ← mul_one_kron_apply, h]
  · intro h
    ext ⟨vb, n⟩ ⟨va, m⟩
    rw [one_kron_mul_apply, mul_one_kron_apply, h]

/-- The coefficient blocks of an adjoint are the adjoint coefficient blocks. -/
theorem blockSlice_conjTranspose (T : Matrix (Kb × Nb) (Ka × Na) ℂ) (vb : Kb) (va : Ka) :
    blockSlice Tᴴ va vb = (blockSlice T vb va)ᴴ := by
  ext m n
  rfl

end Generic

end ArbitraryIncidenceDuality
end MathPhys
