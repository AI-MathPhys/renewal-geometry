import Mathlib

/-!
# Finite control-frame equivalence
  (`thm:control-frame-equivalence-master`, flagship manuscript)

In a finite-dimensional Banach algebra `𝔸` (the ambient matrix
algebra) with pulse generators `A i`, let `H` be the submonoid
generated by the one-parameter groups `exp (t • A i)` and let the
conjugate set consist of all `w * A i * w'` with `w, w' ∈ H`
mutually inverse.  Then:

* `(i) ⟺ (ii)`: the real span of the conjugate set equals the
  Lie algebra generated by the `A i`
  (`control_frame_span_eq`).  The forward inclusion
  differentiates the conjugation curve
  `t ↦ exp(tAᵢ) y exp(-tAᵢ)` at zero inside the closed span
  (`bracket_mem_of_conj_mem`) and packages stability as a Lie
  subalgebra (`lieSpan_le_conjSpan`); the reverse inclusion is
  the `Ad(exp) = exp(ad)` invariance, proved here by linear-ODE
  uniqueness: the conjugation curve and the curve
  `exp(t·ad B)x₀` computed inside the subalgebra solve the same
  Lipschitz ODE `u' = [B,u]` (`exp_conj_mem`,
  `pulse_conj_mem`);
* `(ii) ⟺ (iii)`: a family spans iff some `d = dim` picks have
  positive definite Gram matrix
  (`gram_posDef_iff_linearIndependent`, `gram_certificate`),
  because a spanning set contains a basis and a list is a basis
  exactly when its Gram is positive definite.

Rendering disclosed: the ambient Lie algebra `𝔤` of the compact
group is rendered as the ambient finite-dimensional algebra with
the commutator bracket, so (i)–(ii) are proved as the equality of
the two subspaces (their equality with a target `𝔤` on both sides
is then definitional); the Hilbert–Schmidt pairing of (iii) is
rendered as the inner product of an abstract finite-dimensional
real inner-product space (its instantiation on matrices is the
standard HS form).
-/

open NormedSpace Set Module

namespace NCG

attribute [local instance 0] LieRing.ofAssociativeRing

variable {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℝ 𝔸]
  [FiniteDimensional ℝ 𝔸]

/-- The submonoid generated by the admitted one-parameter pulse
groups. -/
def pulseGroup {m : ℕ} (A : Fin m → 𝔸) : Submonoid 𝔸 :=
  Submonoid.closure (⋃ i, Set.range fun t : ℝ => exp (t • A i))

/-- The set of conjugated generators `w * A i * w'` with mutually
inverse `w, w'` in the pulse monoid. -/
def conjSet {m : ℕ} (A : Fin m → 𝔸) : Set 𝔸 :=
  {y | ∃ w w' : 𝔸, w ∈ pulseGroup A ∧ w' ∈ pulseGroup A
    ∧ w * w' = 1 ∧ w' * w = 1 ∧ ∃ i, y = w * A i * w'}

/-- `exp_add_of_commute` along the real exponential radius. -/
theorem exp_add_of_commute_real {x y : 𝔸} (h : Commute x y) :
    exp (x + y) = exp x * exp y :=
  exp_add_of_commute_of_mem_ball h
    ((expSeries_radius_eq_top ℝ 𝔸).symm ▸ edist_lt_top _ _)
    ((expSeries_radius_eq_top ℝ 𝔸).symm ▸ edist_lt_top _ _)

theorem exp_cancel (B : 𝔸) (t : ℝ) :
    exp (t • B) * exp (t • (-B)) = 1 := by
  rw [smul_neg, ← neg_smul,
    ← exp_add_of_commute_real
      (((Commute.refl B).smul_left t).smul_right (-t)),
    ← add_smul, add_neg_cancel, zero_smul, exp_zero]

theorem exp_cancel' (B : 𝔸) (t : ℝ) :
    exp (t • (-B)) * exp (t • B) = 1 := by
  rw [smul_neg, ← neg_smul,
    ← exp_add_of_commute_real
      (((Commute.refl B).smul_left (-t)).smul_right t),
    ← add_smul, neg_add_cancel, zero_smul, exp_zero]

/-- Every pulse word has a two-sided inverse in the pulse
monoid. -/
theorem pulseGroup_inv {m : ℕ} (A : Fin m → 𝔸) :
    ∀ w ∈ pulseGroup A, ∃ w' ∈ pulseGroup A,
      w * w' = 1 ∧ w' * w = 1 := by
  intro w hw
  induction hw using Submonoid.closure_induction with
  | mem z hz =>
      obtain ⟨i, t, rfl⟩ : ∃ i, ∃ t : ℝ, exp (t • A i) = z := by
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
        obtain ⟨t, ht⟩ := hi
        exact ⟨i, t, ht⟩
      refine ⟨exp (t • (-A i)), ?_, exp_cancel _ _, exp_cancel' _ _⟩
      refine Submonoid.subset_closure (Set.mem_iUnion.mpr ⟨i, ?_⟩)
      refine ⟨-t, ?_⟩
      rw [smul_neg, ← neg_smul]
  | one => exact ⟨1, one_mem _, one_mul 1, one_mul 1⟩
  | mul u v hu hv ihu ihv =>
      obtain ⟨u', hu', huu', hu'u⟩ := ihu
      obtain ⟨v', hv', hvv', hv'v⟩ := ihv
      refine ⟨v' * u', mul_mem hv' hu', ?_, ?_⟩
      · rw [mul_assoc u v (v' * u'), ← mul_assoc v v' u', hvv',
          one_mul, huu']
      · rw [mul_assoc v' u' (u * v), ← mul_assoc u' u v, hu'u,
          one_mul, hv'v]

/-- Differentiating a conjugation curve inside a closed submodule
puts the bracket in the submodule. -/
theorem bracket_mem_of_conj_mem {W : Submodule ℝ 𝔸} (B y : 𝔸)
    (hcurve : ∀ t : ℝ, exp (t • B) * y * exp (t • (-B)) ∈ W) :
    B * y - y * B ∈ W := by
  have hu : HasDerivAt
      (fun t : ℝ => exp (t • B) * y * exp (t • (-B)))
      (B * y - y * B) 0 := by
    have h1 := hasDerivAt_exp_smul_const (𝕂 := ℝ) B 0
    have h2 := hasDerivAt_exp_smul_const (𝕂 := ℝ) (-B) 0
    rw [zero_smul, exp_zero, one_mul] at h1 h2
    have h3 := (h1.mul_const y).mul h2
    have h4 : B * y - y * B
        = B * y * exp ((0 : ℝ) • (-B))
          + exp ((0 : ℝ) • B) * y * (-B) := by
      rw [zero_smul, zero_smul, exp_zero]
      noncomm_ring
    rw [h4]
    exact h3
  have hW : IsClosed (W : Set 𝔸) := Submodule.closed_of_finiteDimensional W
  refine hW.mem_of_tendsto (hasDerivAt_iff_tendsto_slope.mp hu) ?_
  filter_upwards [self_mem_nhdsWithin] with t _
  rw [slope_def_module]
  exact W.smul_mem _ (W.sub_mem (hcurve t) (hcurve 0))

/-- Forward inclusion: the generated Lie algebra sits inside the
span of the conjugated generators. -/
theorem lieSpan_le_conjSpan {m : ℕ} (A : Fin m → 𝔸) :
    (LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A)).toSubmodule
      ≤ Submodule.span ℝ (conjSet A) := by
  classical
  set W : Submodule ℝ 𝔸 := Submodule.span ℝ (conjSet A) with hW
  -- the stabilized subalgebra
  let K : LieSubalgebra ℝ 𝔸 :=
    { carrier := {y | y ∈ W ∧ ∀ x ∈ W, ⁅y, x⁆ ∈ W}
      add_mem' := by
        rintro y₁ y₂ ⟨h1, h1'⟩ ⟨h2, h2'⟩
        refine ⟨W.add_mem h1 h2, fun x hx => ?_⟩
        rw [add_lie]
        exact W.add_mem (h1' x hx) (h2' x hx)
      zero_mem' := by
        refine ⟨W.zero_mem, fun x hx => ?_⟩
        rw [zero_lie]
        exact W.zero_mem
      smul_mem' := by
        rintro c y ⟨h1, h1'⟩
        refine ⟨W.smul_mem c h1, fun x hx => ?_⟩
        rw [smul_lie]
        exact W.smul_mem c (h1' x hx)
      lie_mem' := by
        rintro y₁ y₂ ⟨h1, h1'⟩ ⟨h2, h2'⟩
        refine ⟨h1' _ h2, fun x hx => ?_⟩
        rw [lie_lie]
        exact W.sub_mem (h1' _ (h2' x hx)) (h2' _ (h1' x hx)) }
  have hAW : ∀ i, A i ∈ W := by
    intro i
    refine Submodule.subset_span ?_
    exact ⟨1, 1, one_mem _, one_mem _, one_mul 1, one_mul 1, i,
      by rw [one_mul, mul_one]⟩
  have hAK : Set.range A ⊆ K := by
    rintro _ ⟨i, rfl⟩
    refine ⟨hAW i, ?_⟩
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hxS =>
        obtain ⟨w, w', hw, hw', hww', hw'w, j, rfl⟩ := hxS
        have hcurve : ∀ t : ℝ,
            exp (t • A i) * (w * A j * w') * exp (t • (-A i))
              ∈ W := by
          intro t
          refine Submodule.subset_span ?_
          refine ⟨exp (t • A i) * w, w' * exp (t • (-A i)),
            ?_, ?_, ?_, ?_, j, by noncomm_ring⟩
          · refine mul_mem ?_ hw
            exact Submonoid.subset_closure
              (Set.mem_iUnion.mpr ⟨i, t, rfl⟩)
          · refine mul_mem hw' ?_
            refine Submonoid.subset_closure
              (Set.mem_iUnion.mpr ⟨i, -t, ?_⟩)
            rw [smul_neg, ← neg_smul]
          · calc exp (t • A i) * w * (w' * exp (t • (-A i)))
                = exp (t • A i) * (w * w') * exp (t • (-A i)) := by
                  noncomm_ring
              _ = 1 := by rw [hww', mul_one, exp_cancel]
          · calc w' * exp (t • (-A i)) * (exp (t • A i) * w)
                = w' * (exp (t • (-A i)) * exp (t • A i)) * w := by
                  noncomm_ring
              _ = 1 := by rw [exp_cancel', mul_one, hw'w]
        have hb := bracket_mem_of_conj_mem (A i) (w * A j * w')
          hcurve
        rw [Ring.lie_def]
        exact hb
    | zero =>
        rw [lie_zero]
        exact W.zero_mem
    | add x y hxs hys ihx ihy =>
        rw [lie_add]
        exact W.add_mem ihx ihy
    | smul c x hxs ihx =>
        rw [lie_smul]
        exact W.smul_mem c ihx
  have h1 : LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A) ≤ K :=
    (LieSubalgebra.lieSpan_le).mpr hAK
  intro x hx
  exact (h1 hx).1

set_option maxHeartbeats 1000000 in
-- instance search over the quotient normed structures is expensive
/-- `Ad(exp) = exp(ad)` invariance by ODE uniqueness: a
finite-dimensional Lie subalgebra is invariant under conjugation
by exponentials of its own elements.  Proof: the image of the
conjugation curve in the quotient `𝔸 ⧸ 𝔤` solves the linear
Lipschitz ODE `w' = ad̄(B) w` with `w(0) = 0`, hence vanishes. -/
theorem exp_conj_mem (𝔤 : LieSubalgebra ℝ 𝔸) {B x : 𝔸}
    (hB : B ∈ 𝔤) (hx : x ∈ 𝔤) (t : ℝ) :
    exp (t • B) * x * exp (t • (-B)) ∈ 𝔤 := by
  classical
  set G₀ : Submodule ℝ 𝔸 := 𝔤.toSubmodule with hG₀
  haveI hcl : IsClosed (G₀ : Set 𝔸) :=
    Submodule.closed_of_finiteDimensional G₀
  set adB : 𝔸 →ₗ[ℝ] 𝔸 :=
    LinearMap.mulLeft ℝ B - LinearMap.mulRight ℝ B with hadB
  have hadB_apply : ∀ z : 𝔸, adB z = B * z - z * B := by
    intro z
    simp [hadB]
  have hpres : G₀ ≤ G₀.comap adB := by
    intro z hz
    rw [Submodule.mem_comap, hadB_apply, ← Ring.lie_def]
    exact 𝔤.lie_mem hB hz
  set adBc : 𝔸 →L[ℝ] 𝔸 := adB.toContinuousLinearMap with hadBc
  set πl : 𝔸 →ₗ[ℝ] 𝔸 ⧸ G₀ := G₀.mkQ with hπl
  set πc : 𝔸 →L[ℝ] 𝔸 ⧸ G₀ := πl.toContinuousLinearMap with hπc
  set Lbar : 𝔸 ⧸ G₀ →ₗ[ℝ] 𝔸 ⧸ G₀ := G₀.mapQ G₀ adB hpres
    with hLbar
  set Lbarc : 𝔸 ⧸ G₀ →L[ℝ] 𝔸 ⧸ G₀ := Lbar.toContinuousLinearMap
    with hLbarc
  have hcomm : ∀ z : 𝔸, Lbar (πl z) = πl (adB z) := by
    intro z
    rw [hπl, Submodule.mkQ_apply, Submodule.mkQ_apply, hLbar,
      Submodule.mapQ_apply]
  set ufun : ℝ → 𝔸 := fun s =>
    exp (s • B) * x * exp (s • (-B)) with hufun
  have huderiv : ∀ s : ℝ, HasDerivAt ufun (adBc (ufun s)) s := by
    intro s
    have h1 := hasDerivAt_exp_smul_const (𝕂 := ℝ) B s
    have h2 := hasDerivAt_exp_smul_const (𝕂 := ℝ) (-B) s
    have h3 := (h1.mul_const x).mul h2
    have hc1 : exp (s • B) * B = B * exp (s • B) :=
      (((Commute.refl B).smul_left s).exp_left).eq
    have h4 : adBc (ufun s)
        = exp (s • B) * B * x * exp (s • -B)
          + exp (s • B) * x * (exp (s • -B) * -B) := by
      simp only [hadBc, LinearMap.coe_toContinuousLinearMap']
      rw [hadB_apply]
      simp only [hufun]
      rw [hc1]
      noncomm_ring
    rw [h4]
    exact h3
  set w : ℝ → 𝔸 ⧸ G₀ := fun s => πc (ufun s) with hw
  have hwderiv : ∀ s : ℝ, HasDerivAt w (Lbarc (w s)) s := by
    intro s
    have h1 := (πc.hasFDerivAt).comp_hasDerivAt s (huderiv s)
    have h2 : πc (adBc (ufun s)) = Lbarc (w s) := by
      simp only [hw, hπc, hadBc, hLbarc,
        LinearMap.coe_toContinuousLinearMap']
      exact (hcomm (ufun s)).symm
    rw [h2] at h1
    exact h1
  have hzero : ∀ s : ℝ, HasDerivAt
      (fun _ : ℝ => (0 : 𝔸 ⧸ G₀)) (Lbarc 0) s := by
    intro s
    rw [map_zero]
    exact hasDerivAt_const s 0
  have hw0 : w 0 = 0 := by
    have h5 : ufun 0 = x := by
      simp only [hufun, zero_smul, exp_zero, one_mul, mul_one]
    rw [hw]
    simp only [h5]
    simp only [hπc, LinearMap.coe_toContinuousLinearMap', hπl]
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  have hlip : ∀ s : ℝ,
      LipschitzOnWith ‖Lbarc‖₊ (fun y => Lbarc y) Set.univ :=
    fun _ => (Lbarc.lipschitz).lipschitzOnWith
  have hkey : w = fun _ => (0 : 𝔸 ⧸ G₀) := by
    refine ODE_solution_unique_univ (v := fun _ y => Lbarc y)
      (s := fun _ => Set.univ) (t₀ := 0) hlip
      (fun s => ⟨hwderiv s, Set.mem_univ _⟩)
      (fun s => ⟨hzero s, Set.mem_univ _⟩) ?_
    rw [hw0]
  have h6 : πl (ufun t) = 0 := by
    have h7 := congrFun hkey t
    simpa [hw, hπc, LinearMap.coe_toContinuousLinearMap']
      using h7
  rw [show exp (t • B) * x * exp (t • (-B)) = ufun t from rfl]
  rw [hπl, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    at h6
  exact h6

/-- Conjugation by any pulse word preserves the generated Lie
algebra. -/
theorem pulse_conj_mem {m : ℕ} (A : Fin m → 𝔸) :
    ∀ w ∈ pulseGroup A, ∀ w'' : 𝔸, w * w'' = 1 → w'' * w = 1 →
      ∀ x ∈ LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A),
        w * x * w'' ∈ LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A) := by
  intro w hw
  induction hw using Submonoid.closure_induction with
  | mem z hz =>
      intro w'' h1 h2 x hx
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
      obtain ⟨t, ht⟩ := hi
      subst ht
      have huniq : w'' = exp (t • (-A i)) := by
        calc w'' = 1 * w'' := (one_mul _).symm
          _ = exp (t • (-A i)) * exp (t • A i) * w'' := by
              rw [exp_cancel']
          _ = exp (t • (-A i)) * (exp (t • A i) * w'') := by
              rw [mul_assoc]
          _ = exp (t • (-A i)) := by rw [h1, mul_one]
      rw [huniq]
      exact exp_conj_mem _
        (LieSubalgebra.subset_lieSpan (Set.mem_range_self i)) hx t
  | one =>
      intro w'' h1 h2 x hx
      rw [one_mul] at h1
      rw [h1, one_mul, mul_one]
      exact hx
  | mul u v hu hv ihu ihv =>
      intro w'' h1 h2 x hx
      obtain ⟨u', hu', huu', hu'u⟩ := pulseGroup_inv A u hu
      obtain ⟨v', hv', hvv', hv'v⟩ := pulseGroup_inv A v hv
      have hvu : v' * u' * (u * v) = 1 := by
        rw [mul_assoc v' u' (u * v), ← mul_assoc u' u v, hu'u,
          one_mul, hv'v]
      have huniq : w'' = v' * u' := by
        calc w'' = 1 * w'' := (one_mul _).symm
          _ = v' * u' * (u * v) * w'' := by rw [hvu]
          _ = v' * u' * (u * v * w'') := by rw [mul_assoc]
          _ = v' * u' := by rw [h1, mul_one]
      rw [huniq]
      have h3 : u * v * x * (v' * u')
          = u * (v * x * v') * u' := by noncomm_ring
      rw [h3]
      exact ihu u' huu' hu'u _ (ihv v' hvv' hv'v x hx)

/-- Reverse inclusion: the span of the conjugated generators sits
inside the generated Lie algebra. -/
theorem conjSpan_le_lieSpan {m : ℕ} (A : Fin m → 𝔸) :
    Submodule.span ℝ (conjSet A)
      ≤ (LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A)).toSubmodule := by
  rw [Submodule.span_le]
  rintro y ⟨w, w', hw, hw', hww', hw'w, i, rfl⟩
  exact pulse_conj_mem A w hw w' hww' hw'w (A i)
    (LieSubalgebra.subset_lieSpan (Set.mem_range_self i))

/-- `thm:control-frame-equivalence-master`, (i) ⟺ (ii): the real
span of the conjugated generators equals the Lie algebra
generated by the pulses. -/
theorem control_frame_span_eq {m : ℕ} (A : Fin m → 𝔸) :
    Submodule.span ℝ (conjSet A)
      = (LieSubalgebra.lieSpan ℝ 𝔸 (Set.range A)).toSubmodule :=
  le_antisymm (conjSpan_le_lieSpan A) (lieSpan_le_conjSpan A)

section Gram

variable {E : Type*} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

omit [FiniteDimensional ℝ E] in
/-- A finite family has positive definite Gram matrix iff it is
linearly independent. -/
theorem gram_posDef_iff_linearIndependent {n : ℕ} (v : Fin n → E) :
    (Matrix.of fun μ ν : Fin n =>
      (inner ℝ (v μ) (v ν) : ℝ)).PosDef
      ↔ LinearIndependent ℝ v := by
  have hquad : ∀ c : Fin n → ℝ,
      star c ⬝ᵥ (Matrix.of fun μ ν : Fin n =>
        (inner ℝ (v μ) (v ν) : ℝ)).mulVec c
      = ‖∑ ν, c ν • v ν‖ ^ 2 := by
    intro c
    rw [← real_inner_self_eq_norm_sq]
    rw [sum_inner]
    rw [show (star c : Fin n → ℝ) = c from star_trivial c]
    simp only [dotProduct, Matrix.mulVec, Matrix.of_apply]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [inner_sum]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [real_inner_smul_left, real_inner_smul_right]
    ring
  constructor
  · intro hPD
    rw [Fintype.linearIndependent_iff]
    intro c hc i
    by_contra hi
    have hc0 : c ≠ 0 := fun h => hi (by simp [h])
    have h1 := hPD.dotProduct_mulVec_pos hc0
    rw [hquad c, hc] at h1
    simp at h1
  · intro hind
    refine Matrix.PosDef.of_dotProduct_mulVec_pos ?_ ?_
    · refine Matrix.IsHermitian.ext ?_
      intro μ ν
      simp only [Matrix.of_apply, star_trivial]
      exact real_inner_comm (v μ) (v ν)
    · intro c hc0
      rw [hquad c]
      have h1 : ∑ ν, c ν • v ν ≠ 0 := by
        intro h
        exact hc0 (funext fun i =>
          Fintype.linearIndependent_iff.mp hind c h i)
      positivity

/-- `thm:control-frame-equivalence-master`, (ii) ⟺ (iii): a
family spans iff `d = dim` picks have positive definite Gram. -/
theorem gram_certificate {ι : Type*} (v : ι → E) :
    Submodule.span ℝ (Set.range v) = ⊤
      ↔ ∃ sel : Fin (Module.finrank ℝ E) → ι,
          (Matrix.of fun μ ν =>
            (inner ℝ (v (sel μ)) (v (sel ν)) : ℝ)).PosDef := by
  classical
  constructor
  · intro hspan
    obtain ⟨b, hbsub, hbspan, hbind⟩ :=
      exists_linearIndependent ℝ (Set.range v)
    rw [hspan] at hbspan
    let bas : Basis b ℝ E := Basis.mk hbind (by
      rw [Subtype.range_coe, hbspan])
    have : Fintype b := FiniteDimensional.fintypeBasisIndex bas
    have hcard : Fintype.card b = Module.finrank ℝ E :=
      (Module.finrank_eq_card_basis bas).symm
    let e : Fin (Module.finrank ℝ E) ≃ b :=
      (Fintype.equivFinOfCardEq hcard).symm
    have hsel : ∀ μ : Fin (Module.finrank ℝ E),
        ∃ i : ι, v i = ((e μ : b) : E) := by
      intro μ
      have := hbsub (e μ).2
      obtain ⟨i, hi⟩ := this
      exact ⟨i, hi⟩
    choose sel hsel_spec using hsel
    refine ⟨sel, ?_⟩
    have hfam : (fun μ => v (sel μ))
        = fun μ => ((e μ : b) : E) := funext fun μ => hsel_spec μ
    rw [show (Matrix.of fun μ ν =>
        (inner ℝ (v (sel μ)) (v (sel ν)) : ℝ))
        = Matrix.of fun μ ν =>
          (inner ℝ ((fun μ => v (sel μ)) μ)
            ((fun μ => v (sel μ)) ν) : ℝ) from rfl, hfam]
    refine (gram_posDef_iff_linearIndependent _).mpr ?_
    exact hbind.comp (fun μ => e μ) (e.injective)
  · rintro ⟨sel, hPD⟩
    have hind := (gram_posDef_iff_linearIndependent _).mp hPD
    have hspan : Submodule.span ℝ
        (Set.range fun μ => v (sel μ)) = ⊤ :=
      hind.span_eq_top_of_card_eq_finrank'
        (by rw [Fintype.card_fin])
    refine top_unique ?_
    rw [← hspan]
    refine Submodule.span_mono ?_
    rintro _ ⟨μ, rfl⟩
    exact ⟨sel μ, rfl⟩

end Gram

end NCG
