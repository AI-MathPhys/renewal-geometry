  decide
theorem hNM : NmZ * MmZ = 4 • RmZ + NmZ + MmZ + 2 • DisZ := by
  decide
theorem hMN : MmZ * NmZ = 4 • RmZ + NmZ + MmZ + 2 • DisZ := by
  decide
