import Mathlib
import NCG.Grand.Bicommutant
import NCG.Grand.FiniteStarSubalgebraMutualCommutant
import NCG.Grand.StarMatrixUnits

/-!
# Two-control reconstruction of the internal matrix factors
  (`thm:SM-active-residual-algebra`, Gran-Tensor manuscript)

The source-minimal residual carrier of the active Standard-Model
chapter is the 12-dimensional directed-edge carrier of `K₄`
(ordered pairs of distinct vertices): its `S₄ × C₂` decomposition
is `ℂ ⊕ W₊ ⊕ (V₂)₊ ⊕ W₋ ⊕ (W ⊗ sgn)₋` with dimensions
`1, 3, 2, 3, 3` — reversal-even blocks are the unoriented-edge
functions (trivial ⊕ standard ⊕ two-dimensional), reversal-odd
blocks are the cut space (endpoint quotient) and the cycle space
(orthogonal loop kernel).

* `commutant_eq`: the commutant of the algebra `AR` generated by
  the two tetrahedral relabelings `U_s = P (12)`,
  `U_r = P (1234)` and the reversal `R_ι` is exactly the
  five-dimensional span of the pattern matrices
  `1, R, N, M, Dis` (same-endpoint, crossed-endpoint, disjoint).
* `bicommutant_eq`: by the mutual-commutant theorem for
  star-closed subalgebras, `AR` is the commutant of that span —
  the full block algebra of the five isotypic components.
* `Qtype, QC, QW2, QG, QP`: the five explicit orthogonal
  self-adjoint central projections of `AR` summing to `1` with
  traces `1, 3, 2, 3, 3`; `AR` contains every corner
  `Q X Q` (block fullness) and every element of `AR` is the sum
  of its five corners — this is the boxed
  `C*(U_s,U_r,R_ι) ≅ ℂ ⊕ M₃ ⊕ M₂ ⊕ M₃ ⊕ M₃` (SM.0h), with the
  reversal-even internal corner `M₃(C) ⊕ M₂(W₂)` (SM.0i) given
  by `QC + QW2 = (1 + R)/2 − Qtype`.
* `single_control_commutative`, `no_single_control`: a
  `C^*`-algebra generated by one unitary is commutative, and `AR`
  is not — two noncommuting tetrahedral controls are minimal.
* `detC_eq_sign`, `detW2_eq_sign`, `det_product_trivial`:
  the determinant characters of the two reversal-even
  noncommutative blocks both equal the sign character (SM.0j),
  so their product is the trivial `S₄` line.
* `edge_projector_sum`: the six edge projectors of `K₄` sum to
  twice the identity of the cut carrier (SM.0k).
-/

open Matrix

namespace NCG
namespace ActiveResidual

/-- Vertices of `K₄`. -/
abbrev V := Fin 4

/-- The 12 directed edges of `K₄`: ordered pairs of distinct
vertices. -/
abbrev E := {p : V × V // p.1 ≠ p.2}

/-- Relabeling action of a tetrahedral permutation on directed
edges. -/
def act (σ : Equiv.Perm V) (e : E) : E :=
  ⟨(σ e.val.1, σ e.val.2), fun h => e.prop (σ.injective h)⟩

/-- Root reversal on directed edges. -/
def rv (e : E) : E := ⟨(e.val.2, e.val.1), Ne.symm e.prop⟩

@[simp] theorem act_one (e : E) : act 1 e = e := rfl

theorem act_mul (σ τ : Equiv.Perm V) (e : E) :
    act (σ * τ) e = act σ (act τ e) := rfl

@[simp] theorem rv_rv (e : E) : rv (rv e) = e := rfl

theorem act_rv (σ : Equiv.Perm V) (e : E) :
    act σ (rv e) = rv (act σ e) := rfl

/-- The permutation matrix of a relabeling. -/
def Pm (σ : Equiv.Perm V) : Matrix E E ℂ :=
  fun e f => if e = act σ f then 1 else 0

@[simp] theorem Pm_apply (σ : Equiv.Perm V) (e f : E) :
    Pm σ e f = if e = act σ f then 1 else 0 := rfl

/-- The reversal matrix. -/
def Rm : Matrix E E ℂ := fun e f => if e = rv f then 1 else 0

@[simp] theorem Rm_apply (e f : E) :
    Rm e f = if e = rv f then 1 else 0 := rfl

theorem Pm_mul (σ τ : Equiv.Perm V) :
    Pm σ * Pm τ = Pm (σ * τ) := by
  ext e f
  rw [Matrix.mul_apply,
    Finset.sum_eq_single (act τ f)
      (fun h _ hne => by
        rw [Pm_apply τ h f, if_neg hne, mul_zero])
      (fun h => absurd (Finset.mem_univ _) h)]
  rw [Pm_apply τ (act τ f) f, if_pos rfl, mul_one,
    Pm_apply, Pm_apply, act_mul]

theorem Pm_one : Pm 1 = 1 := by
  ext e f
  rw [Pm_apply, act_one, Matrix.one_apply]

theorem Pm_conjTranspose (σ : Equiv.Perm V) :
    (Pm σ)ᴴ = Pm σ⁻¹ := by
  ext e f
  rw [Matrix.conjTranspose_apply, Pm_apply, Pm_apply]
  by_cases h : f = act σ e
  · rw [if_pos h, if_pos (by rw [h, ← act_mul,
      inv_mul_cancel, act_one]), star_one]
  · rw [if_neg h, if_neg (fun hc => h (by
      rw [hc, ← act_mul, mul_inv_cancel, act_one])), star_zero]

theorem Rm_mul_Rm : Rm * Rm = 1 := by
  ext e f
  rw [Matrix.mul_apply,
    Finset.sum_eq_single (rv f)
      (fun h _ hne => by
        rw [Rm_apply h f, if_neg hne, mul_zero])
      (fun h => absurd (Finset.mem_univ _) h)]
  rw [Rm_apply (rv f) f, if_pos rfl, mul_one, Rm_apply,
    rv_rv, Matrix.one_apply]

theorem Rm_conjTranspose : Rmᴴ = Rm := by
  ext e f
  rw [Matrix.conjTranspose_apply, Rm_apply, Rm_apply]
  by_cases h : f = rv e
  · rw [if_pos h, if_pos (by rw [h, rv_rv]), star_one]
  · rw [if_neg h, if_neg (fun hc => h (by rw [hc, rv_rv])),
      star_zero]

theorem Pm_mul_Rm (σ : Equiv.Perm V) :
    Pm σ * Rm = Rm * Pm σ := by
  ext e f
  rw [Matrix.mul_apply,
    Finset.sum_eq_single (rv f)
      (fun h _ hne => by
        rw [Rm_apply h f, if_neg hne, mul_zero])
      (fun h => absurd (Finset.mem_univ _) h),
    Matrix.mul_apply,
    Finset.sum_eq_single (act σ f)
      (fun h _ hne => by
        rw [Pm_apply σ h f, if_neg hne, mul_zero])
      (fun h => absurd (Finset.mem_univ _) h)]
  rw [Rm_apply (rv f) f, if_pos rfl, mul_one,
    Pm_apply σ (act σ f) f, if_pos rfl, mul_one,
    Pm_apply, Rm_apply, act_rv]

/-- The two tetrahedral controls: `s = (12)` and `r = (1234)`
(zero-indexed: the swap `(0 1)` and the 4-cycle). -/
def sPerm : Equiv.Perm V := Equiv.swap 0 1

def rPerm : Equiv.Perm V := finRotate 4

/-- The two-control algebra `C^*(U_s, U_r, R_ι)`. -/
def AR : Subalgebra ℂ (Matrix E E ℂ) :=
  Algebra.adjoin ℂ {Pm sPerm, Pm rPerm, Rm}

theorem closure_sr :
    Subgroup.closure ({rPerm, sPerm} : Set (Equiv.Perm V)) = ⊤ := by
  have h := Equiv.Perm.closure_cycle_adjacent_swap
    (isCycle_finRotate (n := 2)) (by decide) 0
  have h2 : Equiv.swap (0 : V) (finRotate 4 0)
      = Equiv.swap 0 1 := by decide
  rw [h2] at h
  exact h

theorem Pm_mem (σ : Equiv.Perm V) : Pm σ ∈ AR := by
  have hσ : σ ∈ Subgroup.closure ({rPerm, sPerm} :
      Set (Equiv.Perm V)) := by
    rw [closure_sr]; exact Subgroup.mem_top σ
  induction hσ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact Algebra.subset_adjoin (by simp)
    · exact Algebra.subset_adjoin (by simp)
  | one =>
    rw [Pm_one]
    exact AR.one_mem
  | mul x y _ _ ihx ihy =>
    rw [← Pm_mul]
    exact AR.mul_mem ihx ihy
  | inv x _ ih =>
    have hunit : IsUnit (Pm x) :=
      ⟨⟨Pm x, Pm x⁻¹,
        by rw [Pm_mul, mul_inv_cancel, Pm_one],
        by rw [Pm_mul, inv_mul_cancel, Pm_one]⟩, rfl⟩
    obtain ⟨y, hyS, hzy, _⟩ :=
      StarUnits.inv_mem_of_isUnit AR ih hunit
    have hxy : Pm x⁻¹ = y := by
      calc Pm x⁻¹ = Pm x⁻¹ * (Pm x * y) := by
            rw [hzy, Matrix.mul_one]
        _ = (Pm x⁻¹ * Pm x) * y := by rw [Matrix.mul_assoc]
        _ = y := by
            rw [Pm_mul, inv_mul_cancel, Pm_one, Matrix.one_mul]
    rw [hxy]
    exact hyS

theorem Rm_mem : Rm ∈ AR :=
  Algebra.subset_adjoin (by simp)

theorem AR_star : ∀ a ∈ AR, aᴴ ∈ AR := by
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with rfl | rfl | rfl
    · rw [Pm_conjTranspose]; exact Pm_mem _
    · rw [Pm_conjTranspose]; exact Pm_mem _
    · rw [Rm_conjTranspose]; exact Rm_mem
  | algebraMap c =>
    rw [Algebra.algebraMap_eq_smul_one,
      Matrix.conjTranspose_smul, Matrix.conjTranspose_one]
    exact AR.smul_mem AR.one_mem _
  | add x y _ _ ihx ihy =>
    rw [Matrix.conjTranspose_add]
    exact AR.add_mem ihx ihy
  | mul x y _ _ ihx ihy =>
    rw [Matrix.conjTranspose_mul]
    exact AR.mul_mem ihy ihx

/-! ## The pattern matrices and their structure constants

All identities among the five pattern matrices (and their
commutation with the generators) are verified by kernel
computation over `ℤ` and transported to `ℂ` along the cast
ring homomorphism. -/

/-- Reversal pattern matrix over `ℤ`. -/
def RmZ : Matrix E E ℤ := fun e f => if e = rv f then 1 else 0

/-- Same-endpoint (head–head or tail–tail) pattern matrix. -/
def NmZ : Matrix E E ℤ := fun e f =>
  if (e.val.1 = f.val.1 ∧ e.val.2 ≠ f.val.2)
    ∨ (e.val.2 = f.val.2 ∧ e.val.1 ≠ f.val.1) then 1 else 0

/-- Crossed-endpoint (head–tail or tail–head) pattern matrix. -/
def MmZ : Matrix E E ℤ := fun e f =>
  if (e.val.1 = f.val.2 ∧ e.val.2 ≠ f.val.1)
    ∨ (e.val.2 = f.val.1 ∧ e.val.1 ≠ f.val.2) then 1 else 0

/-- Disjoint-edge pattern matrix. -/
def DisZ : Matrix E E ℤ := fun e f =>
  if e.val.1 ≠ f.val.1 ∧ e.val.1 ≠ f.val.2
    ∧ e.val.2 ≠ f.val.1 ∧ e.val.2 ≠ f.val.2 then 1 else 0

/-- Integer permutation matrices of the two controls. -/
def PsZ : Matrix E E ℤ := fun e f =>
  if e = act sPerm f then 1 else 0

def PrZ : Matrix E E ℤ := fun e f =>
  if e = act rPerm f then 1 else 0

/-- Cast an integer pattern matrix to `ℂ`. -/
def cz (A : Matrix E E ℤ) : Matrix E E ℂ :=
  A.map (Int.cast : ℤ → ℂ)

theorem cz_mul (A B : Matrix E E ℤ) :
    cz (A * B) = cz A * cz B :=
  A.map_mul (f := Int.castRingHom ℂ) (M := B)

theorem cz_add (A B : Matrix E E ℤ) :
    cz (A + B) = cz A + cz B :=
  Matrix.map_add _ (by simp) A B

theorem cz_one : cz 1 = 1 :=
  Matrix.map_one _ (by simp) (by simp)

theorem cz_smul (k : ℤ) (A : Matrix E E ℤ) :
    cz (k • A) = (k : ℂ) • cz A := by
  ext e f
  simp only [cz, Matrix.map_apply, Matrix.smul_apply,
    smul_eq_mul, Int.cast_mul]

theorem cz_nsmul (k : ℕ) (A : Matrix E E ℤ) :
    cz (k • A) = (k : ℂ) • cz A := by
  ext e f
  have h : (k • A) e f = (k : ℤ) * A e f := by
    rw [Matrix.smul_apply, nsmul_eq_mul]
  rw [cz, Matrix.map_apply, h, Int.cast_mul,
    Int.cast_natCast, cz, Matrix.smul_apply,
    Matrix.map_apply, smul_eq_mul]

theorem cz_transpose (A : Matrix E E ℤ) :
    (cz A)ᴴ = cz Aᵀ := by
  ext e f
  simp [cz, Matrix.conjTranspose_apply, Matrix.map_apply,
    Matrix.transpose_apply]

theorem cz_inj {A B : Matrix E E ℤ} (h : cz A = cz B) :
    A = B := by
  ext e f
  have h2 := congrArg (fun M => M e f) h
  simpa [cz, Matrix.map_apply] using h2

/-- The complex pattern matrices. -/
def Nm : Matrix E E ℂ := cz NmZ

def Mm : Matrix E E ℂ := cz MmZ

def Dis : Matrix E E ℂ := cz DisZ

theorem Rm_eq_cz : Rm = cz RmZ := by
  ext e f
  simp [Rm, RmZ, cz, Matrix.map_apply, apply_ite
    (Int.cast : ℤ → ℂ)]

theorem Pm_s_eq_cz : Pm sPerm = cz PsZ := by
  ext e f
  simp [Pm, PsZ, cz, Matrix.map_apply, apply_ite
    (Int.cast : ℤ → ℂ)]

theorem Pm_r_eq_cz : Pm rPerm = cz PrZ := by
  ext e f
  simp [Pm, PrZ, cz, Matrix.map_apply, apply_ite
    (Int.cast : ℤ → ℂ)]

