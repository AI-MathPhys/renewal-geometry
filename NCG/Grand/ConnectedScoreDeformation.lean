import NCG.Grand.EfficientConnectedScore

/-!
# Exponential deformations generated by connected scores

This module supplies the finite statistical-calculus clauses of
`thm:efficient-connected-score`: a centered score is realized by a normalized
exponential deformation, and vanishing one-sided conditional means make both
marginals stationary to first order.
-/

namespace NCG

open Matrix

/-- Normalizing partition function for a finite exponential deformation. -/
noncomputable def scorePartition {Ω : Type*} [Fintype Ω]
    (p g : Ω → ℝ) (t : ℝ) : ℝ :=
  ∑ ω, p ω * Real.exp (t * g ω)

/-- Normalized exponential deformation of a finite base law. -/
noncomputable def scoreDeformation {Ω : Type*} [Fintype Ω]
    (p g : Ω → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  p ω * Real.exp (t * g ω) / scorePartition p g t

private theorem scoreExponentialTermDerivative {Ω : Type*}
    (p g : Ω → ℝ) (ω : Ω) :
    HasDerivAt (fun t => p ω * Real.exp (t * g ω)) (p ω * g ω) 0 := by
  have hlin : HasDerivAt (fun t : ℝ => t * g ω) (g ω) 0 :=
    by simpa using (hasDerivAt_id 0).mul_const (g ω)
  have hexp := hlin.exp
  simpa only [zero_mul, Real.exp_zero, one_mul] using hexp.const_mul (p ω)

/-- A normalized centered exponential deformation has prescribed score. -/
theorem scoreDeformationDerivative {Ω : Type*} [Fintype Ω]
    (p g : Ω → ℝ) (hprob : ∑ ω, p ω = 1)
    (hcenter : ∑ ω, p ω * g ω = 0) (ω : Ω) :
    HasDerivAt (fun t => scoreDeformation p g t ω) (p ω * g ω) 0 := by
  have hpart : HasDerivAt (scorePartition p g) 0 0 := by
    have hsum := HasDerivAt.sum (u := Finset.univ)
      (fun x _ => scoreExponentialTermDerivative p g x)
    have hfun : (∑ x ∈ Finset.univ,
        fun t => p x * Real.exp (t * g x)) = scorePartition p g := by
      funext t
      simp [scorePartition, Finset.sum_apply]
    rw [hfun, hcenter] at hsum
    exact hsum
  have hpart0 : scorePartition p g 0 = 1 := by
    simp [scorePartition, hprob]
  have hnum := scoreExponentialTermDerivative p g ω
  have hdiv := hnum.div hpart (by rw [hpart0]; norm_num)
  change HasDerivAt
    ((fun t => p ω * Real.exp (t * g ω)) / scorePartition p g)
    (p ω * g ω) 0
  simpa [hpart0] using hdiv

/-- First marginal of a finite two-cell law. -/
noncomputable def firstMarginal {A B : Type*} [Fintype B]
    (p : A × B → ℝ) (a : A) : ℝ := ∑ b, p (a, b)

/-- Second marginal of a finite two-cell law. -/
noncomputable def secondMarginal {A B : Type*} [Fintype A]
    (p : A × B → ℝ) (b : B) : ℝ := ∑ a, p (a, b)

/-- Vanishing one-sided weighted conditional means make both marginals
stationary to first order under the connected exponential deformation. -/
theorem connectedScoreMarginalsStationary
    {A B : Type*} [Fintype A] [Fintype B]
    (p g : A × B → ℝ) (hprob : ∑ ω, p ω = 1)
    (hcenter : ∑ ω, p ω * g ω = 0)
    (hrow : ∀ a, ∑ b, p (a, b) * g (a, b) = 0)
    (hcol : ∀ b, ∑ a, p (a, b) * g (a, b) = 0) :
    (∀ a, HasDerivAt
      (fun t => firstMarginal (scoreDeformation p g t) a) 0 0)
    ∧ (∀ b, HasDerivAt
      (fun t => secondMarginal (scoreDeformation p g t) b) 0 0) := by
  constructor
  · intro a
    have hsum := HasDerivAt.sum (u := Finset.univ) fun b _ =>
      scoreDeformationDerivative p g hprob hcenter (a, b)
    have hfun : (∑ b ∈ Finset.univ,
        fun t => scoreDeformation p g t (a, b)) =
        fun t => firstMarginal (scoreDeformation p g t) a := by
      funext t
      simp [firstMarginal, Finset.sum_apply]
    rw [hfun, hrow a] at hsum
    exact hsum
  · intro b
    have hsum := HasDerivAt.sum (u := Finset.univ) fun a _ =>
      scoreDeformationDerivative p g hprob hcenter (a, b)
    have hfun : (∑ a ∈ Finset.univ,
        fun t => scoreDeformation p g t (a, b)) =
        fun t => secondMarginal (scoreDeformation p g t) b := by
      funext t
      simp [secondMarginal, Finset.sum_apply]
    rw [hfun, hcol b] at hsum
    exact hsum

/-- A nonzero connected score vector therefore gives an explicit
infinitesimal interaction while preserving both one-cell marginals. -/
theorem connectedScoreExponentialWitness
    {A B K : Type*} [Fintype A] [Fintype B] [Fintype K]
    (R : Matrix (A × B) K ℝ) (v : K → ℝ)
    (p : A × B → ℝ) (hprob : ∑ ω, p ω = 1)
    (hcenter : ∑ ω, p ω * (R *ᵥ v) ω = 0)
    (hrow : ∀ a, ∑ b, p (a, b) * (R *ᵥ v) (a, b) = 0)
    (hcol : ∀ b, ∑ a, p (a, b) * (R *ᵥ v) (a, b) = 0)
    (hnonzero : R *ᵥ v ≠ 0) :
    (R *ᵥ v ≠ 0)
    ∧ (∀ ω, HasDerivAt
        (fun t => scoreDeformation p (R *ᵥ v) t ω)
        (p ω * (R *ᵥ v) ω) 0)
    ∧ (∀ a, HasDerivAt
        (fun t => firstMarginal (scoreDeformation p (R *ᵥ v) t) a) 0 0)
    ∧ (∀ b, HasDerivAt
        (fun t => secondMarginal (scoreDeformation p (R *ᵥ v) t) b) 0 0) := by
  refine ⟨hnonzero, fun ω => scoreDeformationDerivative p (R *ᵥ v)
    hprob hcenter ω, ?_⟩
  exact connectedScoreMarginalsStationary p (R *ᵥ v)
    hprob hcenter hrow hcol

end NCG
