import Mathlib

/-!
# Rank-two Fourier carriers and the first three-dimensional exit

This module formalizes the arithmetic support mechanism behind
`thm:NS-rank-two-carrier` and `cor:NS-first-rank-three-exit`.  The subgroup
generated by two donor wavevectors is closed under every convolution-frequency
addition and negation.  Its scalar triple product with the donors vanishes,
whereas every nonzero integral triple product has absolute value at least one.
-/

namespace NCG
namespace RankTwoFourier

abbrev Wavevector := Fin 3 → ℤ

/-- The integral scalar triple product of three Fourier wavevectors. -/
def det3 (p q r : Wavevector) : ℤ :=
  p 0 * (q 1 * r 2 - q 2 * r 1)
    - p 1 * (q 0 * r 2 - q 2 * r 0)
    + p 2 * (q 0 * r 1 - q 1 * r 0)

theorem det3_add_right (p q r s : Wavevector) :
    det3 p q (r + s) = det3 p q r + det3 p q s := by
  simp [det3]
  ring

theorem det3_zsmul_right (p q r : Wavevector) (a : ℤ) :
    det3 p q (a • r) = a * det3 p q r := by
  simp [det3]
  ring

theorem det3_repeat_first (p q : Wavevector) : det3 p q p = 0 := by
  simp [det3]
  ring

theorem det3_repeat_second (p q : Wavevector) : det3 p q q = 0 := by
  simp [det3]
  ring

/-- The exact additive Fourier carrier generated by two donors. -/
def twoDonorCarrier (p q : Wavevector) : AddSubgroup Wavevector where
  carrier := {r | ∃ a b : ℤ, r = a • p + b • q}
  zero_mem' := ⟨0, 0, by simp⟩
  add_mem' := by
    rintro r s ⟨a, b, rfl⟩ ⟨c, d, rfl⟩
    refine ⟨a + c, b + d, ?_⟩
    ext i
    simp
    ring
  neg_mem' := by
    rintro r ⟨a, b, rfl⟩
    refine ⟨-a, -b, ?_⟩
    ext i
    simp
    ring

/-- Every internally generated frequency has zero three-dimensional exit
determinant. -/
theorem det3_eq_zero_of_mem_twoDonorCarrier
    (p q r : Wavevector) (hr : r ∈ twoDonorCarrier p q) :
    det3 p q r = 0 := by
  obtain ⟨a, b, rfl⟩ := hr
  rw [det3_add_right, det3_zsmul_right, det3_zsmul_right,
    det3_repeat_first, det3_repeat_second]
  ring

/-- Fourier convolution cannot leave the two-donor carrier: output
frequencies are sums of input frequencies. -/
theorem convolution_frequency_mem
    (p q r s : Wavevector)
    (hr : r ∈ twoDonorCarrier p q) (hs : s ∈ twoDonorCarrier p q) :
    r + s ∈ twoDonorCarrier p q :=
  (twoDonorCarrier p q).add_mem hr hs

/-- Complex conjugation/real-field frequency reversal also preserves the
carrier. -/
theorem reversed_frequency_mem
    (p q r : Wavevector) (hr : r ∈ twoDonorCarrier p q) :
    -r ∈ twoDonorCarrier p q :=
  (twoDonorCarrier p q).neg_mem hr

/-- A nonzero determinant certifies that the frequency was not generated
internally by the two donors. -/
theorem not_mem_twoDonorCarrier_of_det3_ne_zero
    (p q r : Wavevector) (hdet : det3 p q r ≠ 0) :
    r ∉ twoDonorCarrier p q := by
  intro hr
  exact hdet (det3_eq_zero_of_mem_twoDonorCarrier p q r hr)

/-- The first genuinely three-dimensional exit has an integral unit quantum:
`|det(p,q,r)| ≥ 1` whenever it is nonzero. -/
theorem first_rank_three_exit_quantized
    (p q r : Wavevector) (hdet : det3 p q r ≠ 0) :
    (1 : ℤ) ≤ |det3 p q r| :=
  Int.one_le_abs hdet

/-- Complete algebraic exit packet: nonzero determinant gives both exclusion
from the internally generated carrier and the sharp integral lower bound. -/
theorem first_rank_three_exit
    (p q r : Wavevector) (hdet : det3 p q r ≠ 0) :
    r ∉ twoDonorCarrier p q ∧ (1 : ℤ) ≤ |det3 p q r| :=
  ⟨not_mem_twoDonorCarrier_of_det3_ne_zero p q r hdet,
    first_rank_three_exit_quantized p q r hdet⟩

end RankTwoFourier
end NCG
