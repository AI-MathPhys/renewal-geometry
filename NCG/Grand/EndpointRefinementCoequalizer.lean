import NCG.Grand.FinalPanels1

/-!
# Endpoint refinement coequalizers

This file gives the finite coequalizer framework required by
`thm:endpoint-refinement-coequalizer`: descent through the equivalence relation
generated by face matches, uniqueness, strict composition, nested fibres,
mass pushforward, and explicit witnesses to failed compatibility.
-/

namespace NCG
namespace EndpointRefinementCoequalizer

/-- The endpoint coequalizer generated by a relation of matched fine
endpoints. -/
abbrev Coequalizer {X : Type*} (matchRel : X → X → Prop) :=
  Quotient (Relation.EqvGen.setoid matchRel)

/-- Canonical quotient map to the generated endpoint coequalizer. -/
abbrev quotientMap {X : Type*} (matchRel : X → X → Prop) :
    X → Coequalizer matchRel :=
  fun x ↦ Quotient.mk (Relation.EqvGen.setoid matchRel) x

theorem quotientMap_surjective {X : Type*} (matchRel : X → X → Prop) :
    Function.Surjective (quotientMap matchRel) := by
  intro q
  refine Quotient.inductionOn q ?_
  intro x
  exact ⟨x, rfl⟩

theorem quotientMap_eq_iff {X : Type*} {matchRel : X → X → Prop}
    {x y : X} :
    quotientMap matchRel x = quotientMap matchRel y ↔
      Relation.EqvGen matchRel x y := by
  constructor
  · exact Quotient.exact
  · intro h
    change Quotient.mk (Relation.EqvGen.setoid matchRel) x =
      Quotient.mk (Relation.EqvGen.setoid matchRel) y
    exact Quotient.sound h

/-- Equality on generating matches propagates to the equivalence closure. -/
theorem eq_of_eqvGen {X Y : Type*} {matchRel : X → X → Prop}
    {f : X → Y}
    (hmatch : ∀ {x y}, matchRel x y → f x = f y)
    {x y : X} (hxy : Relation.EqvGen matchRel x y) : f x = f y := by
  induction hxy with
  | rel x y h => exact hmatch h
  | refl x => rfl
  | symm x y h ih => exact ih.symm
  | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz

/-- The canonical map descended from a generator-compatible endpoint map. -/
def descend {X Y : Type*} {matchRel : X → X → Prop}
    (f : X → Y)
    (hmatch : ∀ {x y}, matchRel x y → f x = f y) :
    Coequalizer matchRel → Y :=
  Quotient.lift f (fun _ _ h ↦ eq_of_eqvGen (f := f) hmatch h)

@[simp]
theorem descend_quotientMap {X Y : Type*} {matchRel : X → X → Prop}
    (f : X → Y)
    (hmatch : ∀ {x y}, matchRel x y → f x = f y) (x : X) :
    descend f hmatch (quotientMap matchRel x) = f x := rfl

theorem descend_unique {X Y : Type*} {matchRel : X → X → Prop}
    (f : X → Y) (pi : Coequalizer matchRel → Y)
    (hpi : ∀ x, pi (quotientMap matchRel x) = f x) :
    pi = descend f (fun hxy ↦ by
      rw [← hpi _, ← hpi _]
      exact congrArg pi (quotientMap_eq_iff.mpr (Relation.EqvGen.rel _ _ hxy))) := by
  apply quotient_unique_through_surjection (quotientMap matchRel)
    (quotientMap_surjective matchRel)
  intro x
  rw [hpi, descend_quotientMap]

/-- Exact descent criterion, including existence and uniqueness of the quotient
map. -/
theorem existsUnique_descend_iff {X Y : Type*}
    (matchRel : X → X → Prop) (f : X → Y) :
    (∃! pi : Coequalizer matchRel → Y,
      ∀ x, pi (quotientMap matchRel x) = f x) ↔
    ∀ {x y}, matchRel x y → f x = f y := by
  constructor
  · rintro ⟨pi, hpi, huniq⟩ x y hxy
    rw [← hpi x, ← hpi y]
    exact congrArg pi
      (quotientMap_eq_iff.mpr (Relation.EqvGen.rel _ _ hxy))
  · intro hmatch
    refine ⟨descend f hmatch, fun x ↦ rfl, ?_⟩
    intro pi hpi
    exact descend_unique f pi hpi

/-- A fine endpoint refinement descends to the coarse coequalizer exactly when
every generating fine match has equal coarse quotient images. -/
theorem refinement_descends_iff
    {Fine Coarse : Type*}
    (fineMatch : Fine → Fine → Prop)
    (coarseMatch : Coarse → Coarse → Prop)
    (refine : Fine → Coarse) :
    (∃! pi : Coequalizer fineMatch → Coequalizer coarseMatch,
      ∀ x, pi (quotientMap fineMatch x) =
        quotientMap coarseMatch (refine x)) ↔
    ∀ {x y}, fineMatch x y →
      quotientMap coarseMatch (refine x) =
        quotientMap coarseMatch (refine y) :=
  existsUnique_descend_iff fineMatch (quotientMap coarseMatch ∘ refine)

/-- Canonical endpoint quotient map induced by a compatible refinement. -/
def refinementMap
    {Fine Coarse : Type*}
    {fineMatch : Fine → Fine → Prop}
    {coarseMatch : Coarse → Coarse → Prop}
    (refine : Fine → Coarse)
    (hcompat : ∀ {x y}, fineMatch x y →
      quotientMap coarseMatch (refine x) =
        quotientMap coarseMatch (refine y)) :
    Coequalizer fineMatch → Coequalizer coarseMatch :=
  descend (quotientMap coarseMatch ∘ refine) hcompat

@[simp]
theorem refinementMap_quotientMap
    {Fine Coarse : Type*}
    {fineMatch : Fine → Fine → Prop}
    {coarseMatch : Coarse → Coarse → Prop}
    (refine : Fine → Coarse)
    (hcompat : ∀ {x y}, fineMatch x y →
      quotientMap coarseMatch (refine x) =
        quotientMap coarseMatch (refine y)) (x : Fine) :
    refinementMap refine hcompat (quotientMap fineMatch x) =
      quotientMap coarseMatch (refine x) := rfl

/-- Endpoint quotient maps compose strictly whenever the protected refinement
records compose. -/
theorem refinementMap_comp
    {X₀ X₁ X₂ : Type*}
    {R₀ : X₀ → X₀ → Prop} {R₁ : X₁ → X₁ → Prop}
    {R₂ : X₂ → X₂ → Prop}
    (f₁₀ : X₁ → X₀) (f₂₁ : X₂ → X₁)
    (h₁₀ : ∀ {x y}, R₁ x y →
      quotientMap R₀ (f₁₀ x) = quotientMap R₀ (f₁₀ y))
    (h₂₁ : ∀ {x y}, R₂ x y →
      quotientMap R₁ (f₂₁ x) = quotientMap R₁ (f₂₁ y))
    (h₂₀ : ∀ {x y}, R₂ x y →
      quotientMap R₀ (f₁₀ (f₂₁ x)) =
        quotientMap R₀ (f₁₀ (f₂₁ y))) :
    refinementMap f₁₀ h₁₀ ∘ refinementMap f₂₁ h₂₁ =
      refinementMap (f₁₀ ∘ f₂₁) h₂₀ := by
  apply quotient_unique_through_surjection (quotientMap R₂)
    (quotientMap_surjective R₂)
  intro x
  simp [Function.comp_apply]

/-- Fibres at a fine level refine fibres at every coarser composite level. -/
theorem refinementFibres_nested {A B C : Type*}
    (piAB : A → B) (piBC : B → C) {x y : A}
    (hxy : piAB x = piAB y) :
    (piBC ∘ piAB) x = (piBC ∘ piAB) y := by
  simp only [Function.comp_apply, hxy]

/-- Pushforward of a finite endpoint mass along a quotient/refinement map. -/
def pushforwardMass {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq B] (pi : A → B) (mass : A → ℝ) (b : B) : ℝ :=
  ∑ a with pi a = b, mass a

/-- Endpoint mass is preserved by finite pushforward. -/
theorem pushforwardMass_total {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq B] (pi : A → B) (mass : A → ℝ) :
    ∑ b, pushforwardMass pi mass b = ∑ a, mass a := by
  have h := Finset.sum_fiberwise_of_maps_to
    (s := Finset.univ) (t := Finset.univ)
    (fun a ha ↦ Finset.mem_univ (pi a)) mass
  simpa [pushforwardMass] using h

/-- Failure of compatibility has an explicit generating matched-pair witness. -/
theorem exists_failed_match_witness
    {Fine Coarse : Type*}
    (fineMatch : Fine → Fine → Prop)
    (coarseMatch : Coarse → Coarse → Prop)
    (refine : Fine → Coarse)
    (hfail : ¬ ∀ {x y}, fineMatch x y →
      quotientMap coarseMatch (refine x) =
        quotientMap coarseMatch (refine y)) :
    ∃ x y, fineMatch x y ∧
      quotientMap coarseMatch (refine x) ≠
        quotientMap coarseMatch (refine y) := by
  push Not at hfail
  exact hfail

end EndpointRefinementCoequalizer
end NCG
