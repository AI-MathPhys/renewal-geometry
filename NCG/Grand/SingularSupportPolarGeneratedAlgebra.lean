import NCG.Grand.SingularSupportPolarCommutantExactness
import NCG.Grand.FiniteStarSubalgebraMutualCommutant

/-!
# Generated-algebra form of singular support--polar exactness

This file supplies the generated-algebra clause of
`thm:SMST-support-polar-commutant`.  A rectangular incidence map is embedded
as a self-adjoint off-diagonal matrix on the source--target direct sum.  The
commutants of the original incidence generators and of the singular
support--metric--polar generators are calculated exactly.  Their equality,
together with the finite-dimensional double-commutant theorem, identifies
the generated star algebras.  In a finite matrix algebra these are precisely
the manuscript's generated C-star algebras.
-/

open Matrix
open scoped ComplexOrder MatrixOrder

namespace NCG
namespace SingularSupportPolarGeneratedAlgebra

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The star algebra generated by a self-adjoint family has the same
commutant as the family itself. -/
theorem matCommutant_starAdjoin_of_selfAdjoint
    (S : Set (Matrix n n ℂ))
    (hS : ∀ a ∈ S, aᴴ = a) :
    matCommutant
        ((StarAlgebra.adjoin ℂ S).toSubalgebra : Set (Matrix n n ℂ)) =
      matCommutant S := by
  ext X
  constructor
  · intro hX a ha
    exact hX a (StarAlgebra.subset_adjoin ℂ S ha)
  · intro hX a ha
    change a ∈ Algebra.adjoin ℂ (S ∪ star S) at ha
    induction ha using Algebra.adjoin_induction with
    | mem a ha =>
        rcases ha with ha | ha
        · exact hX a ha
        · rcases ha with ⟨b, hb, rfl⟩
          simpa [hS b hb] using hX b hb
    | algebraMap z =>
        exact (Algebra.commutes z X).symm.eq
    | add x y _ _ hx hy =>
        simpa [mul_add, add_mul, hx, hy]
    | mul x y _ _ hx hy =>
        calc
          X * (x * y) = (X * x) * y := by rw [mul_assoc]
          _ = (x * X) * y := by rw [hx]
          _ = x * (X * y) := by rw [mul_assoc]
          _ = x * (y * X) := by rw [hy]
          _ = (x * y) * X := by rw [mul_assoc]

/-- Equal commutants of self-adjoint generating families imply equality of
their generated finite star algebras. -/
theorem starAdjoin_eq_of_matCommutant_eq
    (S T : Set (Matrix n n ℂ))
    (hS : ∀ a ∈ S, aᴴ = a)
    (hT : ∀ a ∈ T, aᴴ = a)
    (hcomm : matCommutant S = matCommutant T) :
    StarAlgebra.adjoin ℂ S = StarAlgebra.adjoin ℂ T := by
  apply StarSubalgebra.toSubalgebra_injective
  apply SetLike.coe_injective
  let AS := (StarAlgebra.adjoin ℂ S).toSubalgebra
  let AT := (StarAlgebra.adjoin ℂ T).toSubalgebra
  have hsstar : ∀ a ∈ AS, aᴴ ∈ AS :=
    fun a ha => (StarAlgebra.adjoin ℂ S).star_mem ha
  have htstar : ∀ a ∈ AT, aᴴ ∈ AT :=
    fun a ha => (StarAlgebra.adjoin ℂ T).star_mem ha
  calc
    (AS : Set (Matrix n n ℂ)) =
        matCommutant (matCommutant (AS : Set (Matrix n n ℂ))) :=
      (FiniteStarSubalgebraMutualCommutant.mutualCommutants AS hsstar).symm
    _ = matCommutant (matCommutant S) := by
      rw [matCommutant_starAdjoin_of_selfAdjoint S hS]
    _ = matCommutant (matCommutant T) := by rw [hcomm]
    _ = matCommutant (matCommutant (AT : Set (Matrix n n ℂ))) := by
      rw [matCommutant_starAdjoin_of_selfAdjoint T hT]
    _ = (AT : Set (Matrix n n ℂ)) :=
      FiniteStarSubalgebraMutualCommutant.mutualCommutants AT htstar

section RectangularIncidence

variable {e h : ℕ}

/-- Source vertex projection on the source--target direct sum. -/
def sourceVertexProjection :
    Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ :=
  Matrix.fromBlocks 1 0 0 0

/-- Self-adjoint off-diagonal embedding of a rectangular incidence map and
its adjoint. -/
def incidenceEdge (F : Matrix (Fin h) (Fin e) ℂ) :
    Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ :=
  Matrix.fromBlocks 0 Fᴴ F 0

/-- Source support metric embedded in the direct-sum carrier. -/
def supportMetric (P : Matrix (Fin e) (Fin e) ℂ) :
    Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ :=
  Matrix.fromBlocks (P * P) 0 0 0

/-- Self-adjoint off-diagonal embedding of the polar partial isometry. -/
def polarEdge (U : Matrix (Fin h) (Fin e) ℂ) :
    Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ :=
  Matrix.fromBlocks 0 Uᴴ U 0

/-- Original vertex/incidence generator family. -/
def incidenceGenerators (F : Matrix (Fin h) (Fin e) ℂ) :
    Set (Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :=
  {sourceVertexProjection, incidenceEdge F}

/-- Vertex/support-metric/polar generator family. -/
def supportPolarGenerators
    (U : Matrix (Fin h) (Fin e) ℂ)
    (P : Matrix (Fin e) (Fin e) ℂ) :
    Set (Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :=
  {sourceVertexProjection, supportMetric P, polarEdge U}

/-- Embed a source/target block endomorphism diagonally. -/
def blockDiagonal (R : IncidenceBlockEndomorphism e h) :
    Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ :=
  Matrix.fromBlocks R.source 0 0 R.target

theorem sourceVertexProjection_selfAdjoint :
    (sourceVertexProjection (e := e) (h := h))ᴴ =
      sourceVertexProjection := by
  simp [sourceVertexProjection, Matrix.fromBlocks_conjTranspose]

theorem incidenceEdge_selfAdjoint (F : Matrix (Fin h) (Fin e) ℂ) :
    (incidenceEdge F)ᴴ = incidenceEdge F := by
  simp [incidenceEdge, Matrix.fromBlocks_conjTranspose]

theorem polarEdge_selfAdjoint (U : Matrix (Fin h) (Fin e) ℂ) :
    (polarEdge U)ᴴ = polarEdge U := by
  simp [polarEdge, Matrix.fromBlocks_conjTranspose]

theorem supportMetric_selfAdjoint
    (P : Matrix (Fin e) (Fin e) ℂ) (hP : Pᴴ = P) :
    (supportMetric (h := h) P)ᴴ = supportMetric P := by
  simp [supportMetric, Matrix.fromBlocks_conjTranspose, hP,
    Matrix.conjTranspose_mul]

theorem incidenceGenerators_selfAdjoint
    (F : Matrix (Fin h) (Fin e) ℂ) :
    ∀ a ∈ incidenceGenerators F, aᴴ = a := by
  intro a ha
  simp only [incidenceGenerators, Set.mem_insert_iff,
    Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl
  · exact sourceVertexProjection_selfAdjoint
  · exact incidenceEdge_selfAdjoint F

theorem supportPolarGenerators_selfAdjoint
    (U : Matrix (Fin h) (Fin e) ℂ)
    (P : Matrix (Fin e) (Fin e) ℂ) (hP : Pᴴ = P) :
    ∀ a ∈ supportPolarGenerators U P, aᴴ = a := by
  intro a ha
  simp only [supportPolarGenerators, Set.mem_insert_iff,
    Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl | rfl
  · exact sourceVertexProjection_selfAdjoint
  · exact supportMetric_selfAdjoint P hP
  · exact polarEdge_selfAdjoint U

/-- Commuting with the source projection is exactly block diagonality. -/
theorem commutes_sourceVertexProjection_iff
    (X : Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :
    X * sourceVertexProjection = sourceVertexProjection * X ↔
      ∃ R : IncidenceBlockEndomorphism e h, X = blockDiagonal R := by
  constructor
  · intro hX
    let A := X.toBlocks₁₁
    let B := X.toBlocks₁₂
    let C := X.toBlocks₂₁
    let D := X.toBlocks₂₂
    have hdecomp : X = Matrix.fromBlocks A B C D :=
      (Matrix.fromBlocks_toBlocks X).symm
    rw [hdecomp, sourceVertexProjection,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at hX
    have hB := congrArg Matrix.toBlocks₁₂ hX
    have hC := congrArg Matrix.toBlocks₂₁ hX
    simp only [Matrix.toBlocks_fromBlocks₁₂,
      Matrix.toBlocks_fromBlocks₂₁, Matrix.mul_one, Matrix.one_mul,
      Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at hB hC
    refine ⟨⟨A, D⟩, ?_⟩
    rw [hdecomp, blockDiagonal, hB, hC]
  · rintro ⟨R, rfl⟩
    simp [blockDiagonal, sourceVertexProjection,
      Matrix.fromBlocks_multiply]

/-- The commutant of the original direct-sum generators is precisely the
incidence intertwiner algebra. -/
theorem mem_matCommutant_incidenceGenerators_iff
    (F : Matrix (Fin h) (Fin e) ℂ)
    (X : Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :
    X ∈ matCommutant (incidenceGenerators F) ↔
      ∃ R ∈ incidenceIntertwinerSet F, X = blockDiagonal R := by
  constructor
  · intro hX
    have hz := hX sourceVertexProjection (by simp [incidenceGenerators])
    obtain ⟨R, rfl⟩ := (commutes_sourceVertexProjection_iff _).mp hz
    have he := hX (incidenceEdge F) (by simp [incidenceGenerators])
    rw [blockDiagonal, incidenceEdge,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at he
    have h12 := congrArg Matrix.toBlocks₁₂ he
    have h21 := congrArg Matrix.toBlocks₂₁ he
    simp only [Matrix.toBlocks_fromBlocks₁₂,
      Matrix.toBlocks_fromBlocks₂₁, Matrix.mul_zero, Matrix.zero_mul,
      add_zero, zero_add] at h12 h21
    exact ⟨R, ⟨h21, h12⟩, rfl⟩
  · rintro ⟨R, hR, rfl⟩
    intro a ha
    simp only [incidenceGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · exact (commutes_sourceVertexProjection_iff _).mpr ⟨R, rfl⟩
    · rw [blockDiagonal, incidenceEdge,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [hR.1, hR.2]

/-- The commutant of the support--polar direct-sum generators is precisely
the support--metric--polar intertwiner algebra. -/
theorem mem_matCommutant_supportPolarGenerators_iff
    (U : Matrix (Fin h) (Fin e) ℂ)
    (P : Matrix (Fin e) (Fin e) ℂ)
    (X : Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :
    X ∈ matCommutant (supportPolarGenerators U P) ↔
      ∃ R ∈ supportPolarIntertwinerSet U P,
        X = blockDiagonal R := by
  constructor
  · intro hX
    have hz := hX sourceVertexProjection
      (by simp [supportPolarGenerators])
    obtain ⟨R, rfl⟩ := (commutes_sourceVertexProjection_iff _).mp hz
    have hm := hX (supportMetric P)
      (by simp [supportPolarGenerators])
    have hu := hX (polarEdge U)
      (by simp [supportPolarGenerators])
    rw [blockDiagonal, supportMetric,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at hm
    rw [blockDiagonal, polarEdge,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at hu
    have h11 := congrArg Matrix.toBlocks₁₁ hm
    have h12 := congrArg Matrix.toBlocks₁₂ hu
    have h21 := congrArg Matrix.toBlocks₂₁ hu
    simp only [Matrix.toBlocks_fromBlocks₁₁,
      Matrix.toBlocks_fromBlocks₁₂, Matrix.toBlocks_fromBlocks₂₁,
      Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h11 h12 h21
    exact ⟨R, ⟨h11, h21, h12⟩, rfl⟩
  · rintro ⟨R, hR, rfl⟩
    intro a ha
    simp only [supportPolarGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl
    · exact (commutes_sourceVertexProjection_iff _).mpr ⟨R, rfl⟩
    · rw [blockDiagonal, supportMetric,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [hR.1]
    · rw [blockDiagonal, polarEdge,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [hR.2.1, hR.2.2]

/-- Original generators for a family of incidence arrows with common source
and target carriers.  The vertex projection is included even for an empty
family. -/
def incidenceFamilyGenerators {J : Type*}
    (F : J → Matrix (Fin h) (Fin e) ℂ) :
    Set (Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :=
  {sourceVertexProjection} ∪ Set.range fun j => incidenceEdge (F j)

/-- Support--metric--polar generators for a family of incidence arrows. -/
def supportPolarFamilyGenerators {J : Type*}
    (U : J → Matrix (Fin h) (Fin e) ℂ)
    (P : J → Matrix (Fin e) (Fin e) ℂ) :
    Set (Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :=
  {sourceVertexProjection} ∪
    Set.range (fun j => supportMetric (P j)) ∪
    Set.range (fun j => polarEdge (U j))

theorem incidenceFamilyGenerators_selfAdjoint {J : Type*}
    (F : J → Matrix (Fin h) (Fin e) ℂ) :
    ∀ a ∈ incidenceFamilyGenerators F, aᴴ = a := by
  intro a ha
  rcases ha with ha | ⟨j, rfl⟩
  · simpa [incidenceFamilyGenerators] using
      sourceVertexProjection_selfAdjoint (e := e) (h := h)
  · exact incidenceEdge_selfAdjoint (F j)

theorem supportPolarFamilyGenerators_selfAdjoint {J : Type*}
    (U : J → Matrix (Fin h) (Fin e) ℂ)
    (P : J → Matrix (Fin e) (Fin e) ℂ)
    (hP : ∀ j, (P j)ᴴ = P j) :
    ∀ a ∈ supportPolarFamilyGenerators U P, aᴴ = a := by
  intro a ha
  rcases ha with (ha | ⟨j, rfl⟩) | ⟨j, rfl⟩
  · simpa [supportPolarFamilyGenerators] using
      sourceVertexProjection_selfAdjoint (e := e) (h := h)
  · exact supportMetric_selfAdjoint (P j) (hP j)
  · exact polarEdge_selfAdjoint (U j)

/-- The commutant of a full incidence family is exactly its common
source/target intertwiner set. -/
theorem mem_matCommutant_incidenceFamilyGenerators_iff {J : Type*}
    (F : J → Matrix (Fin h) (Fin e) ℂ)
    (X : Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :
    X ∈ matCommutant (incidenceFamilyGenerators F) ↔
      ∃ R ∈ incidenceFamilyIntertwinerSet F,
        X = blockDiagonal R := by
  constructor
  · intro hX
    have hz := hX sourceVertexProjection
      (by simp [incidenceFamilyGenerators])
    obtain ⟨R, rfl⟩ := (commutes_sourceVertexProjection_iff _).mp hz
    refine ⟨R, ?_, rfl⟩
    intro j
    have he := hX (incidenceEdge (F j))
      (by exact Set.mem_union_right _ ⟨j, rfl⟩)
    rw [blockDiagonal, incidenceEdge,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at he
    have h12 := congrArg Matrix.toBlocks₁₂ he
    have h21 := congrArg Matrix.toBlocks₂₁ he
    simp only [Matrix.toBlocks_fromBlocks₁₂,
      Matrix.toBlocks_fromBlocks₂₁, Matrix.mul_zero, Matrix.zero_mul,
      add_zero, zero_add] at h12 h21
    exact ⟨h21, h12⟩
  · rintro ⟨R, hR, rfl⟩
    intro a ha
    rcases ha with ha | ⟨j, rfl⟩
    · have ha' : a = sourceVertexProjection := by simpa using ha
      subst a
      exact (commutes_sourceVertexProjection_iff _).mpr ⟨R, rfl⟩
    · rw [blockDiagonal, incidenceEdge,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [(hR j).1, (hR j).2]

/-- The commutant of a full support--polar family is exactly its common
support--metric--polar intertwiner set. -/
theorem mem_matCommutant_supportPolarFamilyGenerators_iff {J : Type*}
    (U : J → Matrix (Fin h) (Fin e) ℂ)
    (P : J → Matrix (Fin e) (Fin e) ℂ)
    (X : Matrix (Fin e ⊕ Fin h) (Fin e ⊕ Fin h) ℂ) :
    X ∈ matCommutant (supportPolarFamilyGenerators U P) ↔
      ∃ R ∈ supportPolarFamilyIntertwinerSet U P,
        X = blockDiagonal R := by
  constructor
  · intro hX
    have hz := hX sourceVertexProjection
      (by simp [supportPolarFamilyGenerators])
    obtain ⟨R, rfl⟩ := (commutes_sourceVertexProjection_iff _).mp hz
    refine ⟨R, ?_, rfl⟩
    intro j
    have hm := hX (supportMetric (P j))
      (by exact Set.mem_union_left _ (Set.mem_union_right _ ⟨j, rfl⟩))
    have hu := hX (polarEdge (U j))
      (by exact Set.mem_union_right _ ⟨j, rfl⟩)
    rw [blockDiagonal, supportMetric,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at hm
    rw [blockDiagonal, polarEdge,
      Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at hu
    have h11 := congrArg Matrix.toBlocks₁₁ hm
    have h12 := congrArg Matrix.toBlocks₁₂ hu
    have h21 := congrArg Matrix.toBlocks₂₁ hu
    simp only [Matrix.toBlocks_fromBlocks₁₁,
      Matrix.toBlocks_fromBlocks₁₂, Matrix.toBlocks_fromBlocks₂₁,
      Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h11 h12 h21
    exact ⟨h11, h21, h12⟩
  · rintro ⟨R, hR, rfl⟩
    intro a ha
    rcases ha with (ha | ⟨j, rfl⟩) | ⟨j, rfl⟩
    · have ha' : a = sourceVertexProjection := by simpa using ha
      subst a
      exact (commutes_sourceVertexProjection_iff _).mpr ⟨R, rfl⟩
    · rw [blockDiagonal, supportMetric,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [(hR j).1]
    · rw [blockDiagonal, polarEdge,
        Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
      simp [(hR j).2.1, (hR j).2.2]

/-- Exact equality of the two full-family generator commutants. -/
theorem incidenceFamily_supportPolar_generator_commutants
    {J : Type*} (F : J → Matrix (Fin h) (Fin e) ℂ) :
    ∃ (U : J → Matrix (Fin h) (Fin e) ℂ)
      (P Pd : J → Matrix (Fin e) (Fin e) ℂ),
      (∀ j, (P j).PosSemidef ∧ F j = U j * P j ∧
        P j * P j = (F j)ᴴ * F j ∧
        U j * ((U j)ᴴ * U j) = U j ∧
        P j * Pd j = (U j)ᴴ * U j ∧
        Pd j * P j = (U j)ᴴ * U j) ∧
      matCommutant (incidenceFamilyGenerators F) =
        matCommutant (supportPolarFamilyGenerators U P) := by
  rcases finiteFamily_singular_support_polar_commutant_exactness F with
    ⟨U, P, Pd, hdata, hsets, _⟩
  refine ⟨U, P, Pd, hdata, ?_⟩
  ext X
  rw [mem_matCommutant_incidenceFamilyGenerators_iff,
    mem_matCommutant_supportPolarFamilyGenerators_iff, hsets]

/-- Full finite-family generated-algebra statement corresponding to
`C*(Z_lambda,F_e,F_e*) = O_F^sup`. -/
theorem finiteFamily_singular_support_polar_generated_algebra
    {J : Type*} (F : J → Matrix (Fin h) (Fin e) ℂ) :
    ∃ (U : J → Matrix (Fin h) (Fin e) ℂ)
      (P Pd : J → Matrix (Fin e) (Fin e) ℂ),
      (∀ j, (P j).PosSemidef ∧ F j = U j * P j ∧
        P j * P j = (F j)ᴴ * F j ∧
        U j * ((U j)ᴴ * U j) = U j ∧
        P j * Pd j = (U j)ᴴ * U j ∧
        Pd j * P j = (U j)ᴴ * U j) ∧
      StarAlgebra.adjoin ℂ (incidenceFamilyGenerators F) =
        StarAlgebra.adjoin ℂ (supportPolarFamilyGenerators U P) := by
  rcases incidenceFamily_supportPolar_generator_commutants F with
    ⟨U, P, Pd, hdata, hcomm⟩
  refine ⟨U, P, Pd, hdata, ?_⟩
  apply starAdjoin_eq_of_matCommutant_eq
  · exact incidenceFamilyGenerators_selfAdjoint F
  · exact supportPolarFamilyGenerators_selfAdjoint U P
      (fun j => (hdata j).1.1)
  · exact hcomm

/-- Exact equality of the two generator commutants for an arbitrary
rectangular, singular, rank-deficient, or zero incidence map. -/
theorem incidence_supportPolar_generator_commutants
    (F : Matrix (Fin h) (Fin e) ℂ) :
    ∃ (U : Matrix (Fin h) (Fin e) ℂ)
      (P Pd : Matrix (Fin e) (Fin e) ℂ),
      P.PosSemidef ∧ F = U * P ∧ P * P = Fᴴ * F ∧
      U * (Uᴴ * U) = U ∧
      P * Pd = Uᴴ * U ∧ Pd * P = Uᴴ * U ∧
      matCommutant (incidenceGenerators F) =
        matCommutant (supportPolarGenerators U P) := by
  rcases singularSupportPolar_intertwinerSet_eq F with
    ⟨U, P, Pd, hP, hF, hP2, hU, hPPd, hPdP, hsets⟩
  refine ⟨U, P, Pd, hP, hF, hP2, hU, hPPd, hPdP, ?_⟩
  ext X
  rw [mem_matCommutant_incidenceGenerators_iff,
    mem_matCommutant_supportPolarGenerators_iff, hsets]

/-- **Exact generated support--polar algebra theorem.**  The star algebra
generated by the vertex projection and the original incidence map/adjoint is
the star algebra generated by the vertex projection, positive support metric,
and polar partial isometry/adjoint. -/
theorem singular_support_polar_generated_algebra
    (F : Matrix (Fin h) (Fin e) ℂ) :
    ∃ (U : Matrix (Fin h) (Fin e) ℂ)
      (P Pd : Matrix (Fin e) (Fin e) ℂ),
      P.PosSemidef ∧ F = U * P ∧ P * P = Fᴴ * F ∧
      U * (Uᴴ * U) = U ∧
      P * Pd = Uᴴ * U ∧ Pd * P = Uᴴ * U ∧
      StarAlgebra.adjoin ℂ (incidenceGenerators F) =
        StarAlgebra.adjoin ℂ (supportPolarGenerators U P) := by
  rcases incidence_supportPolar_generator_commutants F with
    ⟨U, P, Pd, hP, hF, hP2, hU, hPPd, hPdP, hcomm⟩
  refine ⟨U, P, Pd, hP, hF, hP2, hU, hPPd, hPdP, ?_⟩
  apply starAdjoin_eq_of_matCommutant_eq
  · exact incidenceGenerators_selfAdjoint F
  · exact supportPolarGenerators_selfAdjoint U P hP.1
  · exact hcomm

end RectangularIncidence
end SingularSupportPolarGeneratedAlgebra
end NCG
