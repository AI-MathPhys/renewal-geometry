import Mathlib

/-!
# The radical–centre dictionary

**Theorem `thm:radical-centre`** (group core): in the derived revision
algebra, a homogeneous generator `R_r` is central exactly when its
commutator with every other generator is trivial, equivalently when `r`
lies in the radical of the modular commutator form `ω`.

We prove the dictionary at the level of the implementer family
`R : L → G` of `NCG/Algebra/ProjectiveDefect.lean`:

* `NCG.radical_iff_central` — `R_r` commutes with every generator iff it
  commutes with the whole subgroup they generate;
* `NCG.radical_iff_pairing_trivial` — when the commutators are governed
  by a `{±1}`-valued pairing `⁅R_a, R_b⁆ = ε^{ω(a,b)}` with `ε ≠ 1`
  (Lemma `lem:commutator-pm1`), centrality of `R_r` is exactly
  `r ∈ rad ω`.

The `ℂ`-span/`C*`-algebra packaging (`Z(𝒜) ≅ ℂ^{2^{dim rad ω}}`) is not
formalised; the span statement reduces to this group dictionary plus
linear independence of the homogeneous basis. -/

namespace NCG

open scoped commutatorElement

variable {G : Type*} [Group G] {L : Type*} [AddCommGroup L]

omit [AddCommGroup L] in
/-- **Theorem `thm:radical-centre`, group core**: an implementer `R_r`
commutes with every generator iff it is central in the subgroup
generated by all implementers. -/
theorem radical_iff_central (R : L → G) (r : L) :
    (∀ b : L, ⁅R r, R b⁆ = 1)
      ↔ ∀ g ∈ Subgroup.closure (Set.range R), Commute (R r) g := by
  constructor
  · intro hrad g hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
        obtain ⟨b, rfl⟩ := hx
        exact commutatorElement_eq_one_iff_commute.mp (hrad b)
    | one => exact Commute.one_right _
    | mul x y hx hy ihx ihy => exact ihx.mul_right ihy
    | inv x hx ihx => exact ihx.inv_right
  · intro hcen b
    exact commutatorElement_eq_one_iff_commute.mpr
      (hcen (R b) (Subgroup.subset_closure (Set.mem_range_self b)))

omit [AddCommGroup L] in
/-- **Theorem `thm:radical-centre`**, with the commutator pairing: when
`⁅R_a, R_b⁆ = ε^{ω(a,b)}` for a sign `ε ≠ 1` and an `𝔽₂`-valued pairing
`ω` (Lemma `lem:commutator-pm1`), the generator `R_r` is central in the
revision group iff `r` lies in the radical of `ω`. -/
theorem radical_iff_pairing_trivial (R : L → G) (ε : G) (hε : ε ≠ 1)
    (ω : L → L → ZMod 2)
    (hpair : ∀ a b : L, ⁅R a, R b⁆ = ε ^ (ω a b).val) (r : L) :
    (∀ g ∈ Subgroup.closure (Set.range R), Commute (R r) g)
      ↔ ∀ b : L, ω r b = 0 := by
  rw [← radical_iff_central]
  constructor
  · intro hrad b
    have h := hrad b
    rw [hpair r b] at h
    have hcases : ∀ α : ZMod 2, α = 0 ∨ α = 1 := by decide
    rcases hcases (ω r b) with h0 | h1
    · exact h0
    · rw [h1] at h
      simp only [ZMod.val_one, pow_one] at h
      exact absurd h hε
  · intro hzero b
    rw [hpair r b, hzero b]
    simp [ZMod.val_zero]

end NCG
